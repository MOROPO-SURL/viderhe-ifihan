<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Common.Templating.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    x:Class="MOROPO.VIDERHE.UICCamaguey.Templating.Presentation.Views.CoLabHackathonTeamPlacardView">
    <ContentView.Content>
        <Grid 
            x:Name="Wrapper"
            BackgroundColor="Transparent">
            <Grid 
                x:Name="PlacardLayout"
                ColumnSpacing="0" RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="2*" />
                    <RowDefinition />
                    <RowDefinition Height="3*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <mg:GradientView Grid.ColumnSpan="4" Grid.RowSpan="5">
                    <mg:GradientView.GradientSource>
                        <mg:CssGradientSource>
                            <x:String>
                                <![CDATA[
                                    linear-gradient(145deg, rgba(22, 22, 22, 0.02) 0%, rgba(22, 22, 22, 0.02) 58%, rgba(249, 249, 249, 0.02) 58%, rgba(249, 249, 249, 0.02) 90%, rgba(197, 197, 197, 0.02) 90%, rgba(197, 197, 197, 0.02) 93%, rgba(243, 243, 243, 0.02) 93%, rgba(243, 243, 243, 0.02) 99%, rgba(107, 107, 107, 0.02) 99%, rgba(107, 107, 107, 0.02) 100%), linear-gradient(311deg, rgba(157, 157, 157, 0.02) 0%, rgba(157, 157, 157, 0.02) 2%, rgba(234, 234, 234, 0.02) 2%, rgba(234, 234, 234, 0.02) 47%, rgba(57, 57, 57, 0.02) 47%, rgba(57, 57, 57, 0.02) 84%, rgba(181, 181, 181, 0.02) 84%, rgba(181, 181, 181, 0.02) 98%, rgba(128, 128, 128, 0.02) 98%, rgba(128, 128, 128, 0.02) 100%), linear-gradient(97deg, rgba(231, 231, 231, 0.02) 0%, rgba(231, 231, 231, 0.02) 35%, rgba(53, 53, 53, 0.02) 35%, rgba(53, 53, 53, 0.02) 46%, rgba(114, 114, 114, 0.02) 46%, rgba(114, 114, 114, 0.02) 71%, rgba(55, 55, 55, 0.02) 71%, rgba(55, 55, 55, 0.02) 99%, rgba(202, 202, 202, 0.02) 99%, rgba(202, 202, 202, 0.02) 100%), linear-gradient(90deg, rgb(250, 250, 250), rgb(243, 243, 243))
                                ]]>
                            </x:String>
                        </mg:CssGradientSource>
                    </mg:GradientView.GradientSource>
                </mg:GradientView>
                <Label
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Text="Hackathon"
                    TextColor="#72309e"
                    FontAttributes="Bold"
                    FontSize="Title" />
                <Label
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Path=Chalange}"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium" />
                <Label
                    Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Path=TeamName, StringFormat='Equipo: {0}'}"
                    HorizontalTextAlignment="Center" />
                <StackLayout>                    
                </StackLayout>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>