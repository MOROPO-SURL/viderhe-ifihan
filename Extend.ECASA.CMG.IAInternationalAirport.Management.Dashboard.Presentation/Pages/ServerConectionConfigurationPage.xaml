<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Management.Dashboard.Presentation.Pages.ServerConectionConfigurationPage"
    BackgroundColor="#99000000">
    <ContentPage.Content>
        <Frame
            HorizontalOptions="Center" VerticalOptions="Center"
            Padding="0" Margin="20"
            BackgroundColor="White"
            WidthRequest="560">
            <StackLayout Spacing="0">
                <Label
                    BackgroundColor="{StaticResource PrimaryColor}"
                    Padding="12,10,12,12"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Conexión al servidor"
                    TextColor="White" />
                <StackLayout Padding="10" Spacing="0">
                    <Label Text="Servidor" Style="{StaticResource FormLabel}" />
                    <Entry x:Name="APIServerEntry" />
                    <Grid ColumnSpacing="10" RowSpacing="0" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Text="Usar SSL?" Grid.Column="0" Grid.Row="0" Style="{StaticResource FormLabel}"  />
                        <Switch x:Name="IsSSLRequiredSwitch" Grid.Column="0" Grid.Row="1" />
                        <Label Text="Permitir cualquier certificado?" IsVisible="{Binding Source={Reference IsSSLRequiredSwitch}, Path=IsToggled}" Grid.Column="1" Grid.Row="0" Style="{StaticResource FormLabel}" />
                        <Switch x:Name="IsAnyCertificateAllowedSwitch" IsVisible="{Binding Source={Reference IsSSLRequiredSwitch}, Path=IsToggled}" Grid.Column="1" Grid.Row="1" />
                    </Grid>                    
                    <Label Text="Token" Style="{StaticResource FormLabel}" Margin="0,10,0,0" />
                    <Entry x:Name="TokenEntry" />                    
                </StackLayout>
                <Grid Padding="10" ColumnSpacing="10" BackgroundColor="LightGray">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Text="Aplicar"
                        Clicked="ApplyButton_Clicked" />
                    <Button 
                        Grid.Column="1"
                        Text="Cancelar"
                        Clicked="CancelButton_Clicked" />
                </Grid>
            </StackLayout>
        </Frame>
    </ContentPage.Content>
</ContentPage>