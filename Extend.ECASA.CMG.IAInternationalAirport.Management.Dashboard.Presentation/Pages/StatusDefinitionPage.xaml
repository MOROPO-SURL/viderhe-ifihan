<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.ECASA.CMG.IAInternationalAirport.Management.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.ECASA.CMG.IAInternationalAirport.Management.Dashboard.Presentation.Pages.StatusDefinitionPage"
    x:TypeArguments="pagemodels:StatusDefinitionPageModel"
    x:Name="FormPage"
    Title="Agregar Estado">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid
                    Padding="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="2" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame Grid.Column="0" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="NameLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference NameLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                            <supportpresentationdashboardvalidators:MinLengthFormFieldValidator MinLength="3" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="DiscriminatorLabel"
                                Text="Discriminador" 
                                Style="{StaticResource FormLabel}" />
                            <Picker 
                                SelectedItem="{Binding Path=Discriminator}"
                                ItemsSource="{Binding Path=AvailableDiscriminators}">
                                <Picker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultPickerValidationPresenter.Instance}"
                                        TargetProperty="{Static Picker.SelectedItemProperty}"
                                        Label="{Reference DiscriminatorLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:NotNullFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Picker.Behaviors>
                            </Picker>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        HorizontalOptions="Start">
                        <StackLayout>
                            <Label Text="Énfasis" Style="{StaticResource FormLabel}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Frame 
                                    Grid.Column="0" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Habilitado?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=IsEmphasisEnabled}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    IsVisible="{Binding Path=IsEmphasisEnabled}"
                                    Grid.Column="1" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                        <simplecolorpicker:ColorPickerEntry 
                                            EditAlfa="False"
                                            ColorPreviewButtonBorder="DimGray"
                                            Color="{Binding Path=EmphasisBackgroundColor}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    IsVisible="{Binding Path=IsEmphasisEnabled}"
                                    Grid.Column="2" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                        <simplecolorpicker:ColorPickerEntry 
                                            EditAlfa="False"
                                            ColorPreviewButtonBorder="DimGray"
                                            Color="{Binding Path=EmphasisTextColor}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        IsVisible="{Binding Path=IsEmphasisEnabled}"
                        Grid.ColumnSpan="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        HorizontalOptions="Start">
                        <StackLayout>
                            <Label Text="Animación" Style="{StaticResource FormLabel}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Frame 
                                    Grid.Column="0" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Habilitada?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=IsBlinkAnimationEnabled}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    IsVisible="{Binding Path=IsBlinkAnimationEnabled}"
                                    Grid.Column="1" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                        <simplecolorpicker:ColorPickerEntry 
                                            EditAlfa="False"
                                            ColorPreviewButtonBorder="DimGray"
                                            Color="{Binding Path=AlternateBackgroundColor}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    IsVisible="{Binding Path=IsBlinkAnimationEnabled}"
                                    Grid.Column="2" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                        <simplecolorpicker:ColorPickerEntry 
                                            EditAlfa="False"
                                            ColorPreviewButtonBorder="DimGray"
                                            Color="{Binding Path=AlternateTextColor}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>