<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Dashboard.Presentation.Models.Page"
    xmlns:presentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation"
    xmlns:commonconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Dashboard.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Dashboard.Presentation"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Validators;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Behaviors;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Presenters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Dashboard.Presentation.Pages.ClassicArraivalsPlacardConfigurationPage"
    x:TypeArguments="pagemodels:ClassicOperationsPlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <commonconverters:StringToLocalizeStringConverter x:Key="CommonStringToLocalizeStringConverter" />
            
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

            <presentationconverters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,4,6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="6" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="&#xF415;"
                                Style="{StaticResource TextIconButton}"
                                FontSize="Medium"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="BeginAtDatePickerLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                x:Name="BeginAtDatePicker"
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="EndAtLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                x:Name="DefineEndAtSwitch"
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}">
                                <DatePicker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultDatePickerValidationPresenter.Instance}"
                                        TargetProperty="{Static DatePicker.DateProperty}"
                                        Label="{Reference EndAtLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:DateComparisonFormFieldValidator 
                                                ReferenceField="{Reference BeginAtDatePicker}" 
                                                ReferenceFieldLabel="{Reference BeginAtDatePickerLabel}"
                                                FieldValidationSwich="{Reference DefineEndAtSwitch}" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </DatePicker.Behaviors>
                            </DatePicker>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Orientación de Pantalla" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableConfigurationPlayerOrientationSupportKinds}" 
                                SelectedItem="{Binding Path=PlayerOrientationSupportKind}"
                                ItemDisplayBinding="{Binding Converter={StaticResource CommonStringToLocalizeStringConverter}}"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Origen de Datos" Style="{StaticResource FormLabel}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Frame 
                                    Grid.Column="0" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label 
                                            x:Name="APIServerLabel"
                                            Text="Servidor" 
                                            Style="{StaticResource FormLabel}" />
                                        <Entry Text="{Binding Path=APIServer}">
                                            <Entry.Behaviors>
                                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                                    ValidableFormPage="{Reference FormPage}"
                                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                                    TargetProperty="{Static Entry.TextProperty}"
                                                    Label="{Reference APIServerLabel}">
                                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                        <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                            </Entry.Behaviors>
                                        </Entry>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="1" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Usar SSL?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=UseSSL}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="2" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Permitir cualquier certificado?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=AllowAnyCertificate}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label 
                                            x:Name="APIKeyLabel"
                                            Text="Llave API" 
                                            Style="{StaticResource FormLabel}" />
                                        <Entry Text="{Binding Path=APIKey}">
                                            <Entry.Behaviors>
                                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                                    ValidableFormPage="{Reference FormPage}"
                                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                                    TargetProperty="{Static Entry.TextProperty}"
                                                    Label="{Reference APIKeyLabel}">
                                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                        <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                            </Entry.Behaviors>
                                        </Entry>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="2" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Frecuencia de actualización" Style="{StaticResource FormLabel}" />
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="{Binding Path=UpdateInterval}" VerticalTextAlignment="Center" />
                                            <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                            <Stepper Value="{Binding Path=UpdateInterval}" Minimum="1" />
                                        </StackLayout>
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" Grid.RowSpan="2"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout Spacing="1">
                            <Label Text="Tabla de Operaciones" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Frame 
                                    Grid.Column="0" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}"
                                    Margin="0,0,0,6">
                                    <StackLayout>
                                        <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                        <simplecolorpicker:ColorPickerEntry 
                                            EditAlfa="False"
                                            ColorPreviewButtonBorder="DimGray"
                                            Color="{Binding Path=TableBackgroundColor}" />
                                    </StackLayout>
                                </Frame>
                                <!--
                                <Frame 
                                    Grid.Column="1" Grid.Row="0"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Número de elementos por página" Style="{StaticResource FormLabel}" />
                                        <StackLayout Orientation="Horizontal">
                                            <Label Text="{Binding Path=MaxItemsCount}" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                            <Stepper Value="{Binding Path=MaxItemsCount}" Minimum="0" />
                                        </StackLayout>
                                    </StackLayout>
                                </Frame>
                                -->
                                <Frame 
                                    Grid.Column="2" Grid.Row="0" Grid.RowSpan="6"
                                    Style="{StaticResource FormFieldFrame}"
                                    Padding="0"
                                    BackgroundColor="#66FFFFFF"
                                    VerticalOptions="Start">
                                    <StackLayout Spacing="0">
                                        <Label
                                            Style="{StaticResource FormLabel}"
                                            BackgroundColor="White"
                                            Padding="10,10,10,6"
                                            Text="Columnas" />
                                        <Frame 
                                            Style="{StaticResource FormFieldFrame}"
                                            Margin="10" Padding="0"
                                            BackgroundColor="#66FFFFFF">
                                            <StackLayout>
                                                <Label
                                                    Style="{StaticResource FormLabel}"
                                                    BackgroundColor="White"
                                                    Padding="10,10,10,6"
                                                    Text="Visibles" />                                                
                                                <StackLayout
                                                    Margin="0"
                                                    Padding="10"
                                                    Grid.ColumnSpan="2" Grid.Row="1"
                                                    BindableLayout.ItemsSource="{Binding Path=VisibleColumns}"
                                                    Spacing="10">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout>
                                                                <StackLayout.GestureRecognizers>
                                                                    <DropGestureRecognizer
                                                                        AllowDrop="True"
                                                                        Drop="VisibleColumnsStackLayout_DropGestureRecognizer_Drop"
                                                                        DragLeave="VisibleColumnsStackLayout_DropGestureRecognizer_DragLeave"
                                                                        DragOver="VisibleColumnsStackLayout_DropGestureRecognizer_DragOver" />
                                                                </StackLayout.GestureRecognizers>
                                                                <BoxView
                                                                    Color="DimGray"
                                                                    HeightRequest="30"
                                                                    IsVisible="{Binding Path=IsBeingDraggedOverAtStart}" />
                                                                <StackLayout 
                                                                    BackgroundColor="White"
                                                                    Orientation="Horizontal"
                                                                    Padding="4">
                                                                    <StackLayout.GestureRecognizers>
                                                                        <DragGestureRecognizer 
                                                                            CanDrag="True"
                                                                            DragStarting="VisibleColumnsStackLayout_ItemView_DragGestureRecognizer_DragStarting"
                                                                            DropCompleted="VisibleColumnsStackLayout_ItemView_DragGestureRecognizer_DropCompleted" />
                                                                    </StackLayout.GestureRecognizers>
                                                                    <Label 
                                                                        Margin="10"
                                                                        HorizontalOptions="FillAndExpand"
                                                                        VerticalTextAlignment="Center"
                                                                        Text="{Binding Path=Target}"
                                                                        TextColor="Black" />
                                                                    <Button
                                                                        VerticalOptions="Start"
                                                                        Style="{StaticResource TextIconButton}"
                                                                        Text="&#xF0049;"
                                                                        FontSize="Medium"
                                                                        Clicked="HideColumnButton_Clicked" />
                                                                </StackLayout>
                                                                <BoxView
                                                                    Color="DimGray"
                                                                    HeightRequest="30"
                                                                    IsVisible="{Binding Path=IsBeingDraggedOverAtEnd}" />
                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </StackLayout>
                                            </StackLayout>
                                        </Frame>
                                        <BoxView Color="DimGray" HeightRequest="2" Margin="10,5" />
                                        <Frame 
                                            Style="{StaticResource FormFieldFrame}"
                                            Margin="10" Padding="0"
                                            BackgroundColor="#66FFFFFF">
                                            <StackLayout>
                                                <Label
                                                    Style="{StaticResource FormLabel}"
                                                    BackgroundColor="White"
                                                    Padding="10,10,10,6"
                                                    Text="Ocultas" />
                                                <StackLayout
                                                    Margin="0"
                                                    Padding="10"
                                                    Grid.ColumnSpan="2" Grid.Row="1"
                                                    BindableLayout.ItemsSource="{Binding Path=AvailableColumns}"
                                                    Spacing="10">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackLayout 
                                                                BackgroundColor="LightGray"
                                                                Orientation="Horizontal"
                                                                Padding="4">
                                                                <Label 
                                                                    Margin="10"
                                                                    HorizontalOptions="FillAndExpand"
                                                                    VerticalTextAlignment="Center"
                                                                    Text="{Binding Path=.}"
                                                                    TextColor="Black" />
                                                                <Button
                                                                    VerticalOptions="Start"
                                                                    Style="{StaticResource TextIconButton}"
                                                                    Text="&#xF86B;"
                                                                    FontSize="Medium"
                                                                    Clicked="ShowColumnButton_Clicked" />
                                                            </StackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </StackLayout>
                                            </StackLayout>
                                        </Frame>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.ColumnSpan="2" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}"
                                    BackgroundColor="#66FFFFFF"
                                    VerticalOptions="Start">
                                    <StackLayout>
                                        <Label Text="Cabecera" Style="{StaticResource FormLabel}" />
                                        <Grid ColumnSpacing="10" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Frame 
                                                Grid.Column="0" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=TableHeaderBackgroundColor}" />
                                                </StackLayout>
                                            </Frame>
                                            <Frame 
                                                Grid.Column="1" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=TableHeaderTextColor}" />
                                                </StackLayout>
                                            </Frame>
                                            <Frame 
                                                Grid.Column="0" Grid.Row="1"
                                                Style="{StaticResource FormFieldFrame}"
                                                VerticalOptions="Start">
                                                <StackLayout>
                                                    <Label Text="Tamaño de Letra" Style="{StaticResource FormLabel}" />
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Text="{Binding Path=TableHeaderFontSize}" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                                        <Stepper Value="{Binding Path=TableHeaderFontSize}" Minimum="8" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.ColumnSpan="2" Grid.Row="2"
                                    Style="{StaticResource FormFieldFrame}"
                                    BackgroundColor="#66FFFFFF"
                                    VerticalOptions="Start">
                                    <StackLayout>
                                        <Label Text="Filas" Style="{StaticResource FormLabel}" />
                                        <Grid ColumnSpacing="10" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Frame 
                                                Grid.Column="0" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=PrimaryRowBackgroundColor}" />
                                                </StackLayout>
                                            </Frame>
                                            <Frame 
                                                Grid.Column="1" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=PrimaryRowTextColor}" />
                                                </StackLayout>
                                            </Frame>
                                            <Frame 
                                                Grid.Column="0" Grid.Row="1"
                                                Style="{StaticResource FormFieldFrame}"
                                                VerticalOptions="Start">
                                                <StackLayout>
                                                    <Label Text="Tamaño de Letra" Style="{StaticResource FormLabel}" />
                                                    <StackLayout Orientation="Horizontal">
                                                        <Label Text="{Binding Path=RowFontSize}" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                                        <Stepper Value="{Binding Path=RowFontSize}" Minimum="8" />
                                                    </StackLayout>
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="0" Grid.Row="3"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Usar color alterno en filas ?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=UseStrippedRows}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.ColumnSpan="2" Grid.Row="4"
                                    IsVisible="{Binding Path=UseStrippedRows}"
                                    Style="{StaticResource FormFieldFrame}"
                                    BackgroundColor="#66FFFFFF"
                                    VerticalOptions="Start">
                                    <StackLayout>
                                        <Label Text="Filas Alternas" Style="{StaticResource FormLabel}" />
                                        <Grid ColumnSpacing="10" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Frame 
                                                Grid.Column="0" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=SecoundaryRowBackgroundColor}" />
                                                </StackLayout>
                                            </Frame>
                                            <Frame 
                                                Grid.Column="1" Grid.Row="0"
                                                Style="{StaticResource FormFieldFrame}"
                                                Margin="0,0,0,6">
                                                <StackLayout>
                                                    <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                                    <simplecolorpicker:ColorPickerEntry 
                                                        EditAlfa="False"
                                                        ColorPreviewButtonBorder="DimGray"
                                                        Color="{Binding Path=SecoundaryRowTextColor}" />
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                            </Grid>                            
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="6"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <BoxView 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Color="White" />
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Padding="10,10,10,6"
                                Text="Fondo (opcional)" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                IsEnabled="{Binding Path=Background, Converter={StaticResource NotNullToBooleanConverter}}"
                                VerticalOptions="Start"
                                Style="{StaticResource TextIconButton}"
                                Text="&#xF022E;"
                                FontSize="Medium"
                                Clicked="BackgroundClearButton_Clicked"/>
                            <Grid 
                                Grid.ColumnSpan="2" Grid.Row="1"
                                HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ContentView
                                    BackgroundColor="Black"
                                    Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para seleccionar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="7"
                        IsVisible="{Binding Path=Background, Converter={StaticResource NotNullToBooleanConverter}}"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Nivel de transparencia sobre el fondo" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ForegroundTransparency}" VerticalTextAlignment="Center" />
                                <Label Text="%" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ForegroundTransparency}" Minimum="5" Maximum="95" Increment="5" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>