<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Presentation.Views.InmersiveCityWeatherOverviewPlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />

            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" SizeScalableView="{Reference RootView}" />
            <extendcommontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" SizeScalableView="{Reference RootView}" />

            <converters:WeatherOverviewModelToConditionFontGlyphConverter x:Key="WeatherOverviewModelToConditionFontGlyphConverter" />
            <converters:FloatToRoundedFloatConverter x:Key="FloatToRoundedFloatConverter" />
            <converters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />

            <Thickness x:Key="TemperatureLabelMargin">0,20,0,5</Thickness>
            <Thickness x:Key="ConditionBlockLayoutMargin">0,0,0,25</Thickness>
            <Thickness x:Key="VariablesBlockLayoutMargin">0,16,0,0</Thickness>
            <Thickness x:Key="VariableBlockLayoutMargin">0,0,20,0</Thickness>
            <Thickness x:Key="WindAngleIconLabelMargin">0,6,0,0</Thickness>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{Binding Path=TextColor, Mode=OneTime}" />
                <Setter Property="FontSize" Value="{Binding Source=28, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <ContentView x:Name="BackgroundContentView" Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}" />
                <StackLayout 
                    x:Name="WeatherInfoLayout"
                    Padding="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=20}"
                    Opacity="0">
                    <StackLayout
                        x:Name="WeatherContextLayout"
                        Opacity="0">
                        <Label 
                            Text="{Binding Path=Now, StringFormat='{0:dddd, MMMM dd, yyyy}'}" />
                        <Label 
                            Text="{Binding Path=Now, StringFormat='{0:h:mm tt}'}"
                            FontSize="{Binding Source=32, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                        <Label
                            Text="{Binding Path=City.Name, Mode=OneTime}"
                            FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    </StackLayout>
                    <Grid 
                        VerticalOptions="FillAndExpand"
                        RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            x:Name="TemperatureLabel"
                            Grid.Column="0" Grid.Row="0"
                            Margin="{Binding Source={StaticResource TemperatureLabelMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                            Opacity="0"
                            Text="{Binding Path=WeatherOverview.Temperature, Converter={StaticResource FloatToRoundedFloatConverter}, StringFormat='{0}°C'}"
                            FontSize="{Binding Source=72, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                            FontAttributes="Bold" />
                        <StackLayout 
                            Grid.Column="0" Grid.Row="1"
                            Margin="{Binding Source={StaticResource ConditionBlockLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                            Spacing="0">
                            <Label
                                x:Name="ConditionLabel"
                                Opacity="0"
                                Text="{Binding Path=WeatherOverview, Converter={StaticResource WeatherOverviewModelToConditionFontGlyphConverter}}"
                                FontFamily="Weather Icons"
                                FontSize="{Binding Source=144, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                            <Label
                                x:Name="ConditionDetailLabel"
                                Opacity="0"
                                Text="{Binding Path=WeatherOverview.ConditionDetail}"
                                HorizontalTextAlignment="Center"
                                FontAttributes="Italic" />
                        </StackLayout>
                        <StackLayout
                            x:Name="TemperatureFeelLikeLayout"
                            Grid.Column="0" Grid.Row="2"
                            Opacity="0"
                            Spacing="0">
                            <Label
                                Text="sensación:"
                                FontAttributes="Bold" />
                            <Label
                                Text="{Binding Path=WeatherOverview.TemperatureFeelLike, Converter={StaticResource FloatToRoundedFloatConverter}, StringFormat='{0}°C'}"
                                FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                        </StackLayout>
                        <Grid
                            x:Name="TemperatureLimitsLayout"
                            Grid.Column="0" Grid.Row="3"
                            Opacity="0"
                            RowSpacing="0" ColumnSpacing="{Binding Source=10, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Text="mínima"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Column="0" Grid.Row="1"
                                Text="{Binding Path=WeatherOverview.MinTemperature, Converter={StaticResource FloatToRoundedFloatConverter}, StringFormat='{0}°C'}"
                                FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                            <BoxView
                                Grid.Column="1" Grid.RowSpan="2"
                                WidthRequest="2"
                                Color="{Binding Path=TextColor, Mode=OneTime}" />
                            <Label
                                Grid.Column="2" Grid.Row="0"
                                Text="máxima"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Column="2" Grid.Row="1"
                                Text="{Binding Path=WeatherOverview.MaxTemperature, Converter={StaticResource FloatToRoundedFloatConverter}, StringFormat='{0}°C'}"
                                FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                        </Grid>
                        <Label
                            x:Name="SourceInfoLayout"
                            Grid.ColumnSpan="2" Grid.Row="5"
                            VerticalOptions="End"
                            Opacity="0"
                            FontSize="{Binding Source=21, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Path=Service}" />
                                    <Span Text=" (" />
                                    <Span Text="{Binding Path=WeatherOverview.MeasuredAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                                    <Span Text=")" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <StackLayout
                            Grid.Column="2" Grid.RowSpan="6" VerticalOptions="End">
                            <Grid
                                x:Name="SunBehaviorInfoLayout"
                                HorizontalOptions="End"
                                Opacity="0"
                                RowSpacing="0" ColumnSpacing="{Binding Source=10, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackLayout
                                    Grid.Column="0"
                                    Spacing="0">
                                    <Label
                                        Text="&#xf051;"
                                        HorizontalTextAlignment="Center"
                                        FontFamily="Weather Icons"
                                        FontSize="{Binding Source=56, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                                    <Label
                                        Text="{Binding Path=WeatherOverview.SunRiseAt, StringFormat='{0:h:mm tt}'}"
                                        HorizontalTextAlignment="Center" />
                                </StackLayout>
                                <BoxView
                                    Grid.Column="1"
                                    WidthRequest="2"
                                    Color="{Binding Path=TextColor, Mode=OneTime}" />
                                <StackLayout
                                    Grid.Column="2"
                                    Spacing="0">
                                    <Label
                                        Text="&#xf052;"
                                        HorizontalTextAlignment="Center"
                                        FontFamily="Weather Icons"
                                        FontSize="{Binding Source=56, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                                    <Label
                                        Text="{Binding Path=WeatherOverview.SunSetAt, StringFormat='{0:h:mm tt}'}"
                                        HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </Grid>
                            <Grid 
                                Margin="{Binding Source={StaticResource VariablesBlockLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                                ColumnSpacing="{Binding Source=10, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <BoxView
                                    x:Name="HumidityInfoLayoutEmphasisBoxView"
                                    Grid.Column="0"
                                    WidthRequest="2"
                                    Opacity="0"
                                    Color="{Binding Path=TextColor, Mode=OneTime}" />
                                <StackLayout
                                    x:Name="HumidityInfoLayout"
                                    Grid.Column="1"
                                    Margin="{Binding Source={StaticResource VariableBlockLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                                    Opacity="0"
                                    Spacing="0">
                                    <Label
                                        Text="Humedad"
                                        FontAttributes="Italic,Bold" />
                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Path=WeatherOverview.Humidity}" FontSize="Title" />
                                                <Span Text=" %" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                                <BoxView
                                    x:Name="PressureInfoLayoutEmphasisBoxView"
                                    Grid.Column="2"
                                    WidthRequest="2"
                                    Opacity="0"
                                    Color="{Binding Path=TextColor, Mode=OneTime}" />
                                <StackLayout
                                    x:Name="PressureInfoLayout"
                                    Grid.Column="3"
                                    Margin="{Binding Source={StaticResource VariableBlockLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                                    Opacity="0"
                                    Spacing="0">
                                    <Label
                                        Text="Presión"
                                        FontAttributes="Italic,Bold" />
                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Path=WeatherOverview.Pressure}" FontSize="Title" />
                                                <Span Text=" hPa" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                                <BoxView
                                    x:Name="WindInfoLayoutEmphasisBoxView"
                                    Grid.Column="4"
                                    Opacity="0"
                                    WidthRequest="2"
                                    Color="{Binding Path=TextColor, Mode=OneTime}" />
                                <Grid
                                    x:Name="WindInfoLayout"
                                    Grid.Column="5"
                                    Opacity="0"
                                    ColumnSpacing="{Binding Source=4, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.ColumnSpan="2" Grid.Row="0"
                                        Text="Viento"
                                        FontAttributes="Italic,Bold" />
                                    <Label
                                        Grid.Column="0" Grid.Row="1"
                                        Padding="{Binding Source={StaticResource WindAngleIconLabelMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                                        VerticalOptions="Center"
                                        Text="&#xf0b1;"
                                        Rotation="{Binding Path=WeatherOverview.WindDegrees}"
                                        FontFamily="Weather Icons"
                                        FontSize="{Binding Source=24, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Path=WeatherOverview.WindSpeed}" FontSize="Title" />
                                                <Span Text=" m/s" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Grid>
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>