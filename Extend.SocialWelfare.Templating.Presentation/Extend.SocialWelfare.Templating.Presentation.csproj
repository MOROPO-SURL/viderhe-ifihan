<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation</AssemblyName>
    <RootNamespace>SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation</RootNamespace>
    <Version>0.9.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Font\weathericons-regular-webfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Font\weathericons-regular-webfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.4" />
    <PackageReference Include="NodaTime" Version="3.1.9" />
    <PackageReference Include="TweetinviAPI" Version="5.0.4" />
    <PackageReference Include="Xamarin.FFImageLoading.Forms" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.FFImageLoading.Transformations" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2578" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Extend.Common.Templating.Presentation\Extend.Common.Templating.Presentation.csproj" />
    <ProjectReference Include="..\Extend.SocialWelfare.Templating\Extend.SocialWelfare.Templating.csproj" />
    <ProjectReference Include="..\Weather.Api.Connect\Weather.Api.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\InmersiveCityWeatherOverviewPlacardView.xaml.cs">
      <DependentUpon>InmersiveCityWeatherOverviewPlacardView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\HeroLocalNowDateTimePlacardView.xaml.cs">
      <DependentUpon>HeroLocalNowDateTimePlacardView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\LandscapeOverlayHeroCityTimeWeatherPlacardView.xaml.cs">
      <DependentUpon>LandscapeOverlayHeroCityTimeWeatherPlacardView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RssFeedCollageHeroPlacardView.xaml.cs">
      <DependentUpon>RssFeedCollageHeroPlacardView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Views\InmersiveCityWeatherOverviewPlacardView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\HeroLocalNowDateTimePlacardView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\LandscapeOverlayHeroCityTimeWeatherPlacardView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\PortraitOverlayHeroCityTimeWeatherPlacardView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\RssFeedCollageHeroPlacardView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
