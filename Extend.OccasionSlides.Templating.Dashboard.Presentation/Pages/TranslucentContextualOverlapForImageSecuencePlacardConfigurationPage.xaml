<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Converters"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:essentialextendtemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Presentation"
    xmlns:essentialextendtemplatingdashboardpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.TranslucentContextualOverlapForImageSecuencePlacardConfigurationPage"
    x:TypeArguments="pagemodels:TranslucentContextualOverlapForImageSecuencePlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToLocalizeStringConverter x:Key="StringToLocalizeStringConverter" />
            <converters:InfoBlockPriorityToColorConverter x:Key="InfoBlockPriorityToColorConverter" DefaultColor="GhostWhite" AlternativeColor="WhiteSmoke" />
            <essentialextendtemplatingpresentationconverters:PictureLayoutModeToXamarinFormAspectConverter x:Key="PictureLayoutModeToXamarinFormAspectConverter" />
            <essentialextendtemplatingdashboardpresentationconverters:IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter x:Key="IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter" />
            <essentialextendtemplatingdashboardpresentationconverters:StringToLocalizeStringConverter x:Key="EssentialStringToLocalizeStringConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="BoolToStringConverter" FalseString="No" TrueString="Si" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="20" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <BoxView 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Color="White" />
                            <Label
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Padding="10,10,10,6"
                                Text="Secuencia de Imágenes" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="IncludeImagesButton_Clicked" />
                            <ScrollView
                                Margin="0"
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Orientation="Vertical">
                                <ContentView 
                                    Padding="0,10,0,20"                                    
                                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}">
                                    <FlexLayout
                                        Margin="10,0,10,0"
                                        Wrap="Wrap"
                                        AlignItems="Start" AlignContent="Start"
                                        BindableLayout.ItemsSource="{Binding Path=PresentedSlides}">
                                        <BindableLayout.EmptyView>
                                            <Label
                                                Margin="10"
                                                Text="No se han agregado elementos"
                                                TextColor="DimGray" />
                                        </BindableLayout.EmptyView>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="10"
                                                    BackgroundColor="Black"
                                                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                                                    RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <BoxView
                                                        Grid.Row="0"
                                                        Color="SlateGray"
                                                        IsVisible="{Binding Path=LayoutMode, Converter={StaticResource IsAspectFitWithOpaqueAspectFilledBySelfPictureLayoutModeToBooleanConverter}}" />
                                                    <ffimageloadingforms:CachedImage 
                                                        Grid.Row="0"
                                                        HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                                        Source="{Binding Path=Image, Converter={StaticResource ImageViewModelToThumbnailImageSourceConverter}}"
                                                        Aspect="{Binding Path=LayoutMode, Converter={StaticResource PictureLayoutModeToXamarinFormAspectConverter}}"
                                                        CacheType="Disk"
                                                        CacheDuration="8760:00:00" />
                                                    <ImageButton
                                                        Grid.Row="0"
                                                        VerticalOptions="Start" HorizontalOptions="End"
                                                        Margin="4"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        BackgroundColor="#99000000"
                                                        BorderWidth="0"
                                                        CornerRadius="12"
                                                        Clicked="ImageDeleteButton_Clicked">
                                                        <ImageButton.Padding>
                                                            <OnPlatform x:TypeArguments="Thickness">
                                                                <On Platform="UWP" Value="1,0,0,0" />
                                                            </OnPlatform>
                                                        </ImageButton.Padding>
                                                        <ImageButton.Source>
                                                            <FontImageSource 
                                                                Color="White"
                                                                FontFamily="{StaticResource IconFontFamily}"
                                                                Glyph="&#xF156;" />
                                                        </ImageButton.Source>
                                                    </ImageButton>
                                                    <StackLayout
                                                        Grid.Row="1"
                                                        Padding="8"
                                                        BackgroundColor="White"
                                                        Orientation="Vertical">
                                                        <Label
                                                            VerticalOptions="Center"
                                                            Text="Presentación"
                                                            FontAttributes="Bold"
                                                            FontSize="Caption" />
                                                        <Picker
                                                            HorizontalOptions="FillAndExpand"
                                                            ItemsSource="{Binding Path=AvailableLayoutModes}"
                                                            SelectedItem="{Binding Path=LayoutMode}"
                                                            ItemDisplayBinding="{Binding Converter={StaticResource EssentialStringToLocalizeStringConverter}}" />
                                                    </StackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </ContentView>
                            </ScrollView>
                        </Grid>
                    </Frame>
                    <Frame
                        Grid.Column="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla (c/u)" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label 
                                    Text="{Binding Path=PictureSlidePresentationSecounds}"
                                    VerticalTextAlignment="Center" />
                                <Label 
                                    Text="Segundos" 
                                    HorizontalOptions="StartAndExpand" 
                                    VerticalTextAlignment="Center" />
                                <Stepper
                                    Minimum="5"
                                    Value="{Binding Path=PictureSlidePresentationSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Contenedor" Style="{StaticResource FormLabel}" />
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapSizes}" 
                                        SelectedItem="{Binding Path=OverlapSize}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Terminación" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapShapeKinds}" 
                                        SelectedItem="{Binding Path=OverlapShapeKind}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Alineación" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapAlignments}" 
                                        SelectedItem="{Binding Path=OverlapAlignment}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Color de Fondo" Style="{StaticResource FormLabel}" />
                                    <simplecolorpicker:ColorPickerEntry 
                                        EditAlfa="False"
                                        Color="{Binding Path=OverlapBackgroundColor}" />
                                </StackLayout>
                            </Frame>
                            <Frame Style="{StaticResource FormFieldFrame}">
                                <StackLayout>
                                    <Label Text="Color de Textos" Style="{StaticResource FormLabel}" />
                                    <simplecolorpicker:ColorPickerEntry 
                                        EditAlfa="False"
                                        Color="{Binding Path=TextColor}" />
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Título" Style="{StaticResource FormLabel}" />
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Texto" Style="{StaticResource FormLabel}" />
                                    <Entry Text="{Binding Path=Title}" />
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.ColumnSpan="3" Grid.Row="0"
                                        Text="Fuente" 
                                        Style="{StaticResource FormLabel}" />
                                    <Entry
                                        Grid.Column="0" Grid.Row="1"
                                        Text="{Binding Path=TitleFontFamily}"
                                        Placeholder="Sistema"
                                        PlaceholderColor="Black"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1" Grid.Row="1"
                                        Text="Seleccionar"
                                        Clicked="TitleFontFamilyPickButton_Clicked" />
                                    <Button 
                                        Grid.Column="2" Grid.Row="1"
                                        IsEnabled="{Binding Path=TitleFontFamily, Converter={StaticResource NotNullToBooleanConverter}}"
                                        Style="{StaticResource TextIconButton}"
                                        Text="&#xF413;"
                                        Clicked="TitleFontFamilyClearButton_Clicked" />
                                </Grid>
                            </Frame>
                            <Frame Style="{StaticResource FormFieldFrame}">
                                <StackLayout>
                                    <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding Path=TitleFontSize}" VerticalTextAlignment="Center" />
                                        <Label Text="Puntos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                        <Stepper Value="{Binding Path=TitleFontSize}" />
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Start"
                        Padding="0">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <BoxView 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Color="White" />
                            <Label
                                x:Name="InfoBlocksLabel"
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Bloques de Información" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="AddContentBlockButton_Clicked" />
                            <StackLayout
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding Path=ContentBlocks}">
                                <BindableLayout.EmptyView>
                                    <Label 
                                        BackgroundColor="#66FFFFFF"
                                        Padding="10" 
                                        Text="Sin elementos que mostrar" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid 
                                            Padding="8"
                                            BackgroundColor="{Binding Path=Priority, Converter={StaticResource InfoBlockPriorityToColorConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label 
                                                Grid.Column="0" Grid.Row="0"
                                                Text="{Binding Path=Content}" />
                                            <Label
                                                Grid.Column="0" Grid.Row="1"
                                                Text="{Binding Path=ContentFontSize, StringFormat='(Tamaño: {0} puntos)'}" 
                                                TextColor="DimGray"
                                                FontSize="Caption" />
                                            <StackLayout Grid.Column="0" Grid.Row="2">
                                                <Label>
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Cabecera?: " FontAttributes="Bold" />
                                                            <Span Text="{Binding Path=IsHeaderVisible, Converter={StaticResource BoolToStringConverter}}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </StackLayout>
                                            <Button 
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center"
                                                Style="{StaticResource OptionsTextIconButton}"
                                                Padding="0,6"
                                                Text="&#xF1D9;"
                                                FontSize="Medium"
                                                Clicked="ContentBlockOptionsButton_Clicked" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>