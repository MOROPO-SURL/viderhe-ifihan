<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blockpagemodels="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page.Configuration.Block"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    x:Class="MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.Configuration.Block.TransparentSeparatorContentBlockConfigurationPage"
    x:TypeArguments="blockpagemodels:TransparentSeparatorContentBlockConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Frame
                        Grid.Column="0" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableSizingModes}" 
                                SelectedItem="{Binding Path=SizingMode}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>