<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:blockpagemodels="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page.Configuration.Block"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.Configuration.Block.HeaderTextContentBlockConfigurationPage"
    x:TypeArguments="blockpagemodels:HeaderTextContentBlockConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="BoolToFieldsetBackgroudnColorStringConverter" FalseString="White" TrueString="#66FFFFFF" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Grid.Column="0" Grid.RowSpan="4"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Texto" Style="{StaticResource FormLabel}" />
                            <Editor 
                                HeightRequest="360"
                                Text="{Binding Path=Text}" />
                            <StackLayout Orientation="Horizontal">
                                <Button
                                    Text="&#xF528;"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    BorderWidth="0"
                                    Clicked="PickTextButton_Clicked" />
                                <Button
                                    IsEnabled="{Binding Path=Text, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                    Text="&#xF193;"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    BorderWidth="0"
                                    Clicked="TextSaveButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="3" Grid.Row="0"
                                Text="Fuente" 
                                Style="{StaticResource FormLabel}" />
                            <Entry
                                Grid.Column="0" Grid.Row="1"
                                Text="{Binding Path=TextFontFamily}"
                                Placeholder="Sistema"
                                PlaceholderColor="Black"
                                IsReadOnly="True" />
                            <Button
                                Grid.Column="1" Grid.Row="1"
                                Text="Seleccionar"
                                Clicked="TextFontFamilyPickButton_Clicked" />
                            <Button 
                                Grid.Column="2" Grid.Row="1"
                                IsEnabled="{Binding Path=TextFontFamily, Converter={StaticResource NotNullToBooleanConverter}}"
                                Style="{StaticResource TextIconButton}"
                                Text="&#xF413;"
                                Clicked="TextFontFamilyClearButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=TextFontSize}" VerticalTextAlignment="Center" />
                                <Label Text="Puntos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=TextFontSize}" Maximum="200" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame
                        Grid.Column="1" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Color" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Grid
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="DimGray"
                                    Padding="1"
                                    HeightRequest="32">
                                    <BoxView Color="{Binding Path=TextColor}" />
                                </Grid>
                                <Button 
                                    HorizontalOptions="End"
                                    Style="{StaticResource TextIconButton}"
                                    Text="&#xF266;"
                                    Clicked="TextColorButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Número Máximo de Líneas" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=TextMaxLineCount}" VerticalTextAlignment="Center" />
                                <Label Text="Líneas" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper
                                    Minimum="1"
                                    Value="{Binding Path=TextMaxLineCount}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="2" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF">
                        <Grid
                            ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Encabezado" 
                                Style="{StaticResource FormLabel}" />
                            <Frame 
                                Grid.Column="0" Grid.Row="1" Grid.RowSpan="3"
                                Style="{StaticResource FormFieldFrame}"
                                VerticalOptions="Start">
                                <Grid HeightRequest="320">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label 
                                        Grid.ColumnSpan="3" Grid.Row="0"
                                        Text="Texto" Style="{StaticResource FormLabel}" />
                                    <Editor 
                                        Grid.ColumnSpan="3" Grid.Row="1"
                                        Text="{Binding Path=Header}" />
                                    <Button
                                        Grid.Column="0" Grid.Row="2"
                                        Text="&#xF528;"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        BorderWidth="0"
                                        Clicked="PickHeaderButton_Clicked" />
                                    <Button
                                        Grid.Column="1" Grid.Row="2"
                                        IsEnabled="{Binding Path=Header, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                        Text="&#xF193;"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        BorderWidth="0"
                                        Clicked="HeaderSaveButton_Clicked" />
                                </Grid>
                            </Frame>
                            <Frame 
                                Grid.Column="1" Grid.Row="1"
                                Style="{StaticResource FormFieldFrame}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.ColumnSpan="3" Grid.Row="0"
                                        Text="Fuente" 
                                        Style="{StaticResource FormLabel}" />
                                    <Entry
                                        Grid.Column="0" Grid.Row="1"
                                        Text="{Binding Path=HeaderFontFamily}"
                                        Placeholder="Sistema"
                                        PlaceholderColor="Black"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1" Grid.Row="1"
                                        Text="Seleccionar"
                                        Clicked="HeaderFontFamilyPickButton_Clicked" />
                                    <Button 
                                        Grid.Column="2" Grid.Row="1"
                                        IsEnabled="{Binding Path=HeaderFontFamily, Converter={StaticResource NotNullToBooleanConverter}}"
                                        Style="{StaticResource TextIconButton}"
                                        Text="&#xF413;"
                                        Clicked="HeaderFontFamilyClearButton_Clicked" />
                                </Grid>
                            </Frame>
                            <Frame 
                                Grid.Column="1" Grid.Row="2"
                                Style="{StaticResource FormFieldFrame}">
                                <StackLayout>
                                    <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding Path=HeaderFontSize}" VerticalTextAlignment="Center" />
                                        <Label Text="Puntos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                        <Stepper Value="{Binding Path=HeaderFontSize}" Maximum="200" />
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                            <Frame
                                Grid.Column="1" Grid.Row="3"
                                Style="{StaticResource FormFieldFrame}"
                                VerticalOptions="Start">
                                <StackLayout>
                                    <Label Text="Color" Style="{StaticResource FormLabel}" />
                                    <StackLayout Orientation="Horizontal">
                                        <Grid
                                            HorizontalOptions="FillAndExpand"
                                            BackgroundColor="DimGray"
                                            Padding="1"
                                            HeightRequest="32">
                                            <BoxView Color="{Binding Path=HeaderColor}" />
                                        </Grid>
                                        <Button 
                                            HorizontalOptions="End"
                                            Style="{StaticResource TextIconButton}"
                                            Text="&#xF266;"
                                            Clicked="HeaderColorButton_Clicked" />
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>