<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blockpagemodels="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page.Configuration.Block"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.Configuration.Block.ImageContentBlockConfigurationPage"
    x:TypeArguments="blockpagemodels:ImageContentBlockConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="0" Grid.RowSpan="4"
                        BackgroundColor="Transparent"
                        Padding="0">
                        <StackLayout                            
                            Spacing="0">
                            <Label 
                                x:Name="ImageLabel"
                                BackgroundColor="White"
                                Padding="10,10,10,6"
                                Text="Imagen" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView Color="#666666" HeightRequest="1" />
                            <Grid
                                VerticalOptions="FillAndExpand"
                                BackgroundColor="#66FFFFFF">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage
                                    HorizontalOptions="{Binding Path=HorizontalAlignament, Mode=OneWay}"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00"
                                    Aspect="AspectFit"
                                    Source="{Binding Path=Image, Converter={StaticResource ImageViewModelToThumbnailImageSourceConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Alineación" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableContentHorizontalAlignaments}" 
                                SelectedItem="{Binding Path=HorizontalAlignament}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Altura" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=HeightByScreenVerticalSizePercent}" VerticalTextAlignment="Center" />
                                <Label Text="%" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper
                                    Minimum="5" Maximum="80"
                                    Increment="5"
                                    Value="{Binding Path=HeightByScreenVerticalSizePercent}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Filtro" Style="{StaticResource FormLabel}" />
                            <Picker IsEnabled="False" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Máscara" Style="{StaticResource FormLabel}" />
                            <Picker IsEnabled="False" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>