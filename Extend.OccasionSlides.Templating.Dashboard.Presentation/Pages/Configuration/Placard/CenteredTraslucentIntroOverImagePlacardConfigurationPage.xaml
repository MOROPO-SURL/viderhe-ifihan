<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page.Configuration.Placard"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Converters"
    xmlns:commonconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Dashboard.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Dashboard.Presentation"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Validators;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Behaviors;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Presenters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:extendessentialpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Essential.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Essential.Templating.Presentation"
    xmlns:extendessentialdashboardpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Essential.Templating.Dashboard.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Essential.Templating.Dashboard.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.Configuration.Placard.CenteredTraslucentIntroOverImagePlacardConfigurationPage"
    x:TypeArguments="pagemodels:CenteredTraslucentIntroOverImagePlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <commonconverters:StringToLocalizeStringConverter x:Key="CommonStringToLocalizeStringConverter" />
            <converters:StringToLocalizeStringConverter x:Key="StringToLocalizeStringConverter" />
            <converters:ContentBlockToViewConverter x:Key="ContentBlockToViewConverter" OptionButtonClicked="ContentBlockOptionsButton_Clicked" />
            <extendessentialpresentationconverters:PictureLayoutModeToXamarinFormAspectConverter x:Key="PictureLayoutModeToXamarinFormAspectConverter" />
            <extendessentialdashboardpresentationconverters:StringToLocalizeStringConverter x:Key="ExtendEssentialStringToLocalizeStringConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="BoolToStringConverter" FalseString="No" TrueString="Si" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="IsBeingDraggedToColorStringConverter" FalseString="White" TrueString="Beige" />
            <sscxftoolkitpresentationconverters:NullToStringConverter x:Key="HasBackgroundImageToColorStringConverter" TrueValue="Black" FalseValue="DimGray" />
            <sscxftoolkitpresentationconverters:EnumerableEmptyToBooleanConverter x:Key="EnumerableEmptyToBooleanConverter" Inverse="True" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,4,6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="6" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="&#xF415;"
                                Style="{StaticResource TextIconButton}"
                                FontSize="Medium"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="BeginAtDatePickerLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                x:Name="BeginAtDatePicker"
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="EndAtLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                x:Name="DefineEndAtSwitch"
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}">
                                <DatePicker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultDatePickerValidationPresenter.Instance}"
                                        TargetProperty="{Static DatePicker.DateProperty}"
                                        Label="{Reference EndAtLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:DateComparisonFormFieldValidator 
                                                ReferenceField="{Reference BeginAtDatePicker}" 
                                                ReferenceFieldLabel="{Reference BeginAtDatePickerLabel}"
                                                FieldValidationSwich="{Reference DefineEndAtSwitch}" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </DatePicker.Behaviors>
                            </DatePicker>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Orientación de Pantalla" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableConfigurationPlayerOrientationSupportKinds}" 
                                SelectedItem="{Binding Path=PlayerOrientationSupportKind}"
                                ItemDisplayBinding="{Binding Converter={StaticResource CommonStringToLocalizeStringConverter}}"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Frame 
                                    Style="{StaticResource FormFieldFrame}"
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Padding="0">
                                    <Grid 
                                        VerticalOptions="FillAndExpand"
                                        ColumnSpacing="0" RowSpacing="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label 
                                            x:Name="BackgroundImageLabel"
                                            Grid.Column="0" Grid.Row="0"
                                            Margin="10,10,10,6"
                                            Text="Imagen de Fondo" 
                                            Style="{StaticResource FormLabel}" />
                                        <Button
                                            Grid.Column="1" Grid.Row="0"
                                            VerticalOptions="Start"
                                            Style="{StaticResource TextIconButton}"
                                            Text="&#xF90E;"
                                            FontSize="Medium"
                                            Clicked="PickBackgroundImageButton_Clicked" />
                                        <BoxView
                                            Grid.ColumnSpan="2" Grid.Row="1"
                                            BackgroundColor="#666666" 
                                            HeightRequest="1" />
                                        <ffimageloadingforms:CachedImage
                                            Grid.ColumnSpan="2" Grid.Row="2"
                                            BackgroundColor="{Binding Path=BackgroundImage, Converter={StaticResource HasBackgroundImageToColorStringConverter}}"
                                            HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                            CacheType="Disk"
                                            CacheDuration="8760:00:00"
                                            Source="{Binding Path=BackgroundImage, Converter={StaticResource ImageViewModelToImageSourceConverter}}"
                                            Aspect="{Binding Path=BackgroundImageLayoutMode, Converter={StaticResource PictureLayoutModeToXamarinFormAspectConverter}}">
                                            <ffimageloadingforms:CachedImage.Behaviors>
                                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                                    ValidableFormPage="{Reference FormPage}"
                                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCachedImageValidationPresenter.Instance}"
                                                    TargetProperty="{Static ffimageloadingforms:CachedImage.SourceProperty}"
                                                    Label="{Reference BackgroundImageLabel}">
                                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                        <supportpresentationdashboardvalidators:NotNullFormFieldValidator />
                                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                            </ffimageloadingforms:CachedImage.Behaviors>
                                        </ffimageloadingforms:CachedImage>
                                    </Grid>
                                </Frame>
                                <Frame 
                                    Grid.Column="0" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Presentación" Style="{StaticResource FormLabel}" />
                                        <Picker 
                                            ItemsSource="{Binding Path=AvailablePictureLayoutModes}" 
                                            SelectedItem="{Binding Path=BackgroundImageLayoutMode}"
                                            ItemDisplayBinding="{Binding Converter={StaticResource ExtendEssentialStringToLocalizeStringConverter}}" />
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="1" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Usar ecfecto Zooming?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=BackgroundImageZoomingEnabled}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Contenedor" Style="{StaticResource FormLabel}" />
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Estilo" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableContentBoxPresentationKinds}" 
                                        SelectedItem="{Binding Path=ContentBoxPresentationKind}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Color de Fondo" Style="{StaticResource FormLabel}" />
                                    <simplecolorpicker:ColorPickerEntry 
                                        EditAlfa="False"
                                        ColorPreviewButtonBorder="DimGray"
                                        Color="{Binding Path=OverlapBackgroundColor}" />
                                </StackLayout>
                            </Frame>
                            <Frame Style="{StaticResource FormFieldFrame}">
                                <StackLayout>
                                    <Label Text="Transparencia del Fondo" Style="{StaticResource FormLabel}" />
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="{Binding Path=OverlapOpacity, StringFormat='{0}%'}" VerticalTextAlignment="Center" />
                                        <Label Text="Puntos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                        <Stepper Value="{Binding Path=OverlapOpacity}" Minimum="15" Maximum="85" Increment="5" />
                                    </StackLayout>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="6"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        Padding="0">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <BoxView 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Color="White" />
                            <Label
                                x:Name="InfoBlocksLabel"
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Bloques de Información" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Style="{StaticResource TextIconButton}"
                                Text="&#xF415;"
                                FontSize="Medium"
                                Clicked="AddContentBlockButton_Clicked" />
                            <CollectionView
                                x:Name="ContentBlockCollectionView"
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Margin="10,0"
                                ItemsSource="{Binding Path=ContentBlocks}">
                                <CollectionView.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                        TargetProperty="{Static CollectionView.ItemsSourceProperty}"
                                        Label="{Reference InfoBlocksLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </CollectionView.Behaviors>
                                <CollectionView.Header>
                                    <BoxView IsVisible="{Binding Path=ContentBlocks, Converter={StaticResource EnumerableEmptyToBooleanConverter}}" Color="Transparent" HeightRequest="5" />
                                </CollectionView.Header>
                                <CollectionView.Footer>
                                    <BoxView IsVisible="{Binding Path=ContentBlocks, Converter={StaticResource EnumerableEmptyToBooleanConverter}}" Color="Transparent" HeightRequest="5" />
                                </CollectionView.Footer>
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="5" Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label 
                                        Padding="5,10" 
                                        Text="Sin elementos que mostrar" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <StackLayout Spacing="10">
                                            <StackLayout.GestureRecognizers>
                                                <DropGestureRecognizer
                                                    AllowDrop="True"
                                                    Drop="ContentBlockCollectionViewDropGestureRecognizer_Drop"
                                                    DragLeave="ContentBlockCollectionViewDropGestureRecognizer_DragLeave"
                                                    DragOver="ContentBlockCollectionViewDropGestureRecognizer_DragOver" />
                                            </StackLayout.GestureRecognizers>
                                            <BoxView
                                                Color="DimGray"
                                                HeightRequest="30"
                                                IsVisible="{Binding Path=IsBeingDraggedOverAtStart}" />
                                            <ContentView 
                                                Content="{Binding Converter={StaticResource ContentBlockToViewConverter}}" 
                                                BackgroundColor="{Binding Path=IsBeingDragged, Converter={StaticResource IsBeingDraggedToColorStringConverter}}" 
                                                Padding="10">
                                                <ContentView.GestureRecognizers>
                                                    <DragGestureRecognizer
                                                        CanDrag="True"
                                                        DragStarting="ContentBlockCollectionItemViewDragGestureRecognizer_DragStarting"
                                                        DropCompleted="ContentBlockCollectionItemViewDragGestureRecognizer_DropCompleted"/>
                                                </ContentView.GestureRecognizers>
                                            </ContentView>
                                            <BoxView
                                                Color="DimGray"
                                                HeightRequest="30"
                                                IsVisible="{Binding Path=IsBeingDraggedOverAtEnd}" />
                                        </StackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>