<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Models.Page.Configuration.Placard"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Converters"
    xmlns:viewtemplateselectors="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Views.Template"
    xmlns:commonconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Dashboard.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Dashboard.Presentation"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Pages.Configuration.Placard.TranslucentContextualOverlapForImagePlacardConfigurationPage"
    x:TypeArguments="pagemodels:TranslucentContextualOverlapForImagePlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <viewtemplateselectors:ContentBlockTemplateSelector x:Key="ContentBlockTemplateSelector" OptionButtonClicked="ContentBlockOptionsButton_Clicked" />

            <commonconverters:StringToLocalizeStringConverter x:Key="CommonStringToLocalizeStringConverter" />
            <converters:StringToLocalizeStringConverter x:Key="StringToLocalizeStringConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="BoolToStringConverter" FalseString="No" TrueString="Si" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Orientación de Pantalla" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Binding Path=AvailableConfigurationPlayerOrientationSupportKinds}" 
                                SelectedItem="{Binding Path=PlayerOrientationSupportKind}"
                                ItemDisplayBinding="{Binding Converter={StaticResource CommonStringToLocalizeStringConverter}}"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Fondo" Style="{StaticResource FormLabel}" />
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>                                
                                <Frame 
                                    Style="{StaticResource FormFieldFrame}"
                                    Grid.ColumnSpan="2" Grid.Row="0"
                                    Padding="0">
                                    <StackLayout 
                                        VerticalOptions="FillAndExpand"
                                        Spacing="0">
                                        <Label 
                                            Margin="10,10,10,6"
                                            Text="Imagen" 
                                            Style="{StaticResource FormLabel}" />
                                        <BoxView BackgroundColor="#666666" HeightRequest="1" />
                                        <Grid>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="PickContextedImageButton_Clicked" />
                                            </Grid.GestureRecognizers>
                                            <ffimageloadingforms:CachedImage 
                                                BackgroundColor="Black"
                                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                                CacheType="Disk"
                                                CacheDuration="8760:00:00"
                                                Source="{Binding Path=ContextedImage, Converter={StaticResource ImageViewModelToImageSourceConverter}}"
                                                Aspect="AspectFill" />
                                            <StackLayout 
                                                HorizontalOptions="Center" VerticalOptions="End"
                                                Padding="4"
                                                BackgroundColor="#99000000"
                                                Orientation="Horizontal">
                                                <Label
                                                    Text="&#xf740;"
                                                    TextColor="White"
                                                    FontFamily="{StaticResource IconFontFamily}"
                                                    FontSize="Medium" />
                                                <Label
                                                    VerticalOptions="Center"
                                                    Margin="0,0,4,0"
                                                    Text="para modificar"
                                                    TextColor="White"
                                                    LineBreakMode="TailTruncation" />
                                            </StackLayout>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                                <Frame 
                                    Grid.Column="0" Grid.Row="1"
                                    Style="{StaticResource FormFieldFrame}">
                                    <StackLayout>
                                        <Label Text="Usar ecfecto Zooming?" Style="{StaticResource FormLabel}" />
                                        <Switch IsToggled="{Binding Path=ContextedImageZoomingEnabled}" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </StackLayout>                        
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Contenedor" Style="{StaticResource FormLabel}" />
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Tamaño" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapSizes}" 
                                        SelectedItem="{Binding Path=OverlapSize}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Terminación" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapShapeKinds}" 
                                        SelectedItem="{Binding Path=OverlapShapeKind}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Alineación" Style="{StaticResource FormLabel}" />
                                    <Picker 
                                        ItemsSource="{Binding Path=AvailableOverlapAlignments}" 
                                        SelectedItem="{Binding Path=OverlapAlignment}"
                                        ItemDisplayBinding="{Binding Converter={StaticResource StringToLocalizeStringConverter}}"/>
                                </StackLayout>
                            </Frame>
                            <Frame 
                                Style="{StaticResource FormFieldFrame}"
                                Margin="0,0,0,6">
                                <StackLayout>
                                    <Label Text="Color de Fondo" Style="{StaticResource FormLabel}" />
                                    <simplecolorpicker:ColorPickerEntry 
                                        EditAlfa="False"
                                        Color="{Binding Path=OverlapBackgroundColor}" />
                                </StackLayout>
                            </Frame>
                            <Frame Style="{StaticResource FormFieldFrame}">
                                <StackLayout>
                                    <Label Text="Color de Textos" Style="{StaticResource FormLabel}" />
                                    <simplecolorpicker:ColorPickerEntry 
                                        EditAlfa="False"
                                        Color="{Binding Path=TextColor}" />
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="Transparent"
                        VerticalOptions="Start"
                        Padding="0">
                        <Grid RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <BoxView 
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Color="White" />
                            <Label
                                x:Name="InfoBlocksLabel"
                                Grid.Column="0" Grid.Row="0"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Bloques de Información" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="AddContentBlockButton_Clicked" />
                            <StackLayout
                                Grid.ColumnSpan="2" Grid.Row="1"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding Path=ContentBlocks}"
                                BindableLayout.ItemTemplateSelector="{StaticResource ContentBlockTemplateSelector}">
                                <BindableLayout.EmptyView>
                                    <Label 
                                        BackgroundColor="#66FFFFFF"
                                        Padding="10" 
                                        Text="Sin elementos que mostrar" />
                                </BindableLayout.EmptyView>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>