<?xml version="1.0" encoding="UTF-8"?>
<DataTemplate 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Converters"
    xmlns:blockviewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Models.View.Block;assembly=SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Dashboard.Presentation.Views.Template.Block.HeaderTextContentBlockViewTemplate" 
    x:DataType="blockviewmodels:HeaderTextContentBlockViewModel">
    <Grid 
        Padding="8"
        BackgroundColor="{Binding Path=Priority, Converter={StaticResource InfoBlockPriorityToColorConverter}}">
        <Grid.Resources>
            <ResourceDictionary>
                <converters:InfoBlockPriorityToColorConverter x:Key="InfoBlockPriorityToColorConverter" DefaultColor="GhostWhite" AlternativeColor="WhiteSmoke" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label 
            Grid.Column="0" Grid.Row="0"
            Text="{Binding Path=Header}"
            TextDecorations="Underline" />
        <Label 
            Grid.Column="0" Grid.Row="1"
            Text="{Binding Path=Text}" />
        <Label 
            Grid.Column="0" Grid.Row="2"
            Text="Texto con Encabezado"
            FontAttributes="Italic"
            TextColor="DimGray" />
        <Button 
            x:Name="OptionsButton"
            Grid.Column="1" Grid.RowSpan="3"
            VerticalOptions="Center"
            Style="{StaticResource OptionsTextIconButton}"
            Padding="0,6"
            Text="&#xF1D9;"
            FontSize="Medium"
            Clicked="OptionsButton_Clicked" />
    </Grid>
</DataTemplate>