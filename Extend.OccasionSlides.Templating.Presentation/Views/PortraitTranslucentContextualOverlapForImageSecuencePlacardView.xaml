<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Converters"
    xmlns:viewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Models.View"
    xmlns:templatingcontextmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Models.Context;assembly=SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:skiaformviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.PortraitTranslucentContextualOverlapForImageSecuencePlacardView"
    x:DataType="viewmodels:TranslucentContextualOverlapForImageSecuencePlacardViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:OverlapWidthToInfoBlockPaddingConverter x:Key="OverlapWidthToInfoBlockPaddingConverter" />
            <converters:OverlapWidthToInfoBlockLabelPaddingConverter x:Key="OverlapWidthToInfoBlockLabelPaddingConverter" />
            <converters:HeaderFontFamilyNameToFontAttributesConverter x:Key="HeaderFontFamilyNameToFontAttributesConverter" />
            <converters:OverlapVerticalAlignmentToLayoutOptionsConverter x:Key="OverlapVerticalAlignmentToLayoutOptionsConverter" />
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <BoxView Color="{Binding Path=TextColor, Mode=OneTime}" />
                <Grid x:Name="FramesContainer" />
                <Grid x:Name="OverlapLayout">
                    <skiaformviews:SKCanvasView PaintSurface="OverlapContentWrapLayout_PaintSurface" />
                    <StackLayout
                        x:Name="OverlapContentLayout"
                        VerticalOptions="{Binding Path=OverlapAlignment, Converter={StaticResource OverlapVerticalAlignmentToLayoutOptionsConverter}, Mode=OneTime}"
                        Padding="{Binding Source={Reference Wrapper}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=20}"
                        Spacing="0">
                        <Label
                            x:Name="TitleLabel"
                            Opacity="0"
                            Text="{Binding Path=Title, Mode=OneTime}"
                            TextColor="{Binding Path=TextColor, Mode=OneTime}"
                            FontFamily="{Binding Path=TitleFontFamily, Mode=OneTime}"
                            FontSize="{Binding Path=TitleFontSize, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                        <StackLayout
                            x:Name="InfoBlocksLayout"
                            Spacing="0"
                            BindableLayout.ItemsSource="{Binding Path=ContentBlocks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="templatingcontextmodels:TextContentBlockContextModel">
                                    <StackLayout
                                        Opacity="0"
                                        Padding="{Binding Source={Reference Wrapper}, Path=Height, Converter={StaticResource OverlapWidthToInfoBlockPaddingConverter}}"
                                        Spacing="0">
                                        <Label
                                            IsVisible="{Binding Path=IsHeaderVisible}"
                                            Padding="{Binding Source={Reference Wrapper}, Path=Height, Converter={StaticResource OverlapWidthToInfoBlockLabelPaddingConverter}}"
                                            Text="{Binding Path=Header, Mode=OneTime}"
                                            TextColor="{Binding Source={Reference Wrapper}, Path=BindingContext.TextColor, Mode=OneTime}"
                                            FontAttributes="{Binding Path=HeaderFontFamily, Mode=OneTime, Converter={StaticResource HeaderFontFamilyNameToFontAttributesConverter}}"
                                            FontFamily="{Binding Path=HeaderFontFamily, Mode=OneTime}"
                                            FontSize="{Binding Path=HeaderFontSize, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"/>
                                        <Label
                                            Text="{Binding Path=Content, Mode=OneTime}"
                                            TextColor="{Binding Source={Reference Wrapper}, Path=BindingContext.TextColor, Mode=OneTime}"
                                            FontFamily="{Binding Path=ContentFontFamily, Mode=OneTime}"
                                            FontSize="{Binding Path=ContentFontSize, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                                    </StackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>