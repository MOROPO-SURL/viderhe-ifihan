<?xml version="1.0" encoding="UTF-8"?>
<DataTemplate 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blockviewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Models.View.Block"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Converters"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Template.Block.ImageContentBlockViewTemplate"
    x:DataType="blockviewmodels:ImageContentBlockViewModel">
    <ffimageloading:CachedImage
        HeightRequest="{Binding Converter={StaticResource ScreenVerticalSizePercentCalculableContentBlockViewModelToHeightConverter}}"
        FadeAnimationEnabled="False"
        HorizontalOptions="{Binding Path=HorizontalAlignament, Mode=OneTime}"
        Source="{Binding Path=Image, Mode=OneTime, Converter={StaticResource ImageViewModelToImageSourceConverter}}" 
        Aspect="{Binding Path=LayoutMode, Mode=OneTime}"
        CacheType="Disk"
        CacheDuration="8760:00:00">
        <ffimageloading:CachedImage.Resources>
            <ResourceDictionary>
                <converters:ScreenVerticalSizePercentCalculableContentBlockViewModelToHeightConverter x:Key="ScreenVerticalSizePercentCalculableContentBlockViewModelToHeightConverter" />
            </ResourceDictionary>
        </ffimageloading:CachedImage.Resources>
    </ffimageloading:CachedImage>
</DataTemplate>