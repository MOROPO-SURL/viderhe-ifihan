<?xml version="1.0" encoding="UTF-8"?>
<DataTemplate 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blockviewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Models.View.Block"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Converters"    
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Template.Block.TransparentSeparatorContentBlockViewTemplate"
    x:DataType="blockviewmodels:TransparentSeparatorContentBlockViewModel">
    <ContentView
        BackgroundColor="Transparent"
        HeightRequest="{Binding Path=SizingMode, Converter={StaticResource SizingModeToHeightConverter}}">
        <ContentView.Resources>
            <ResourceDictionary>
                <converters:SizingModeToHeightConverter x:Key="SizingModeToHeightConverter" />
            </ResourceDictionary>
        </ContentView.Resources>
    </ContentView>
</DataTemplate>