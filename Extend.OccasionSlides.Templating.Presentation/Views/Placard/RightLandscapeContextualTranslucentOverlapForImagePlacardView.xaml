<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Converters"
    xmlns:viewtemplates="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Template"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:skiaformviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Placard.RightLandscapeContextualTranslucentOverlapForImagePlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <viewtemplates:ContentBlockTemplateSelector x:Key="ContentBlockTemplateSelector" />

            <converters:OverlapSizeToRightColumnIndexConverter x:Key="OverlapSizeToRightColumnIndexConverter" />
            <converters:OverlapSizeToRightColumnIndexConverter x:Key="OverlapSizeToRightContentColumnIndexConverter" IsForContent="True" />
            <converters:OverlapSizeToColumnSpanConverter x:Key="OverlapSizeToColumnSpanConverter" />
            <converters:OverlapSizeToColumnSpanConverter x:Key="OverlapSizeToContentColumnSpanConverter" IsForContent="True" />
            <converters:OverlapWidthToRightContentPaddingConverter x:Key="OverlapWidthToRightContentPaddingConverter" />
            <converters:OverlapWidthToInfoBlockPaddingConverter x:Key="OverlapWidthToInfoBlockPaddingConverter" />
            <converters:OverlapWidthToInfoBlockLabelPaddingConverter x:Key="OverlapWidthToInfoBlockLabelPaddingConverter" />
            <converters:HeaderFontFamilyNameToFontAttributesConverter x:Key="HeaderFontFamilyNameToFontAttributesConverter" />
            <converters:IsNullToImageAspectConverter x:Key="IsNullToImageAspectConverter" />

            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" RelativeDimensionScalable="{Reference RootView}" />
            
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <Grid 
                    x:Name="ContextedImageWrapper"
                    BackgroundColor="Black">
                    <ffimageloadingforms:CachedImage
                        x:Name="ContextedImageThumbnailImage"
                        IsVisible="{Binding Path=ContextedImageThumbnailSource, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                        Source="{Binding Path=ContextedImageThumbnailSource, Mode=OneTime}"
                        Aspect="AspectFill"
                        CacheType="Disk"
                        CacheDuration="8760:00:00"
                        FadeAnimationEnabled="False"
                        IsOpaque="False">
                        <ffimageloadingforms:CachedImage.Transformations>
                            <fftransformations:BlurredTransformation />
                        </ffimageloadingforms:CachedImage.Transformations>
                    </ffimageloadingforms:CachedImage>
                    <ffimageloadingforms:CachedImage
                        x:Name="ContextedImagen"
                        FadeAnimationEnabled="False"
                        Source="{Binding Path=ContextedImageSource, Mode=OneTime}" 
                        Aspect="{Binding Path=ContextedImageThumbnailSource, Converter={StaticResource IsNullToImageAspectConverter}}"
                        CacheType="Disk"
                        CacheDuration="8760:00:00" />
                </Grid>
                <Grid
                    x:Name="OverlapLayout"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <skiaformviews:SKCanvasView
                        Grid.Column="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToRightColumnIndexConverter}, Mode=OneTime}" 
                        Grid.ColumnSpan="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToColumnSpanConverter}, Mode=OneTime}"
                        PaintSurface="OverlapContentWrapLayout_PaintSurface" />
                    <Grid
                        Grid.Column="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToRightContentColumnIndexConverter}, Mode=OneTime}" 
                        Grid.ColumnSpan="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToContentColumnSpanConverter}, Mode=OneTime}"
                        Padding="{Binding Source={Reference Wrapper}, Path=Width, Converter={StaticResource OverlapWidthToRightContentPaddingConverter}}">
                        <StackLayout 
                            VerticalOptions="Center"
                            Spacing="0">
                            <StackLayout
                                x:Name="InfoBlocksLayout"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding Path=ContentBlocks}"
                                BindableLayout.ItemTemplateSelector="{StaticResource ContentBlockTemplateSelector}" />
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>