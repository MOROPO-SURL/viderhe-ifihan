<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Converters"
    xmlns:viewtemplates="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Template"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OccasionSlides.Templating.Presentation.Views.Placard.CenteredTraslucentIntroOverImagePlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <viewtemplates:ContentBlockTemplateSelector x:Key="ContentBlockTemplateSelector" />

            <converters:CenteredContentBoxPresentationKindToHorizontalOptionsConverter x:Key="CenteredContentBoxPresentationKindToHorizontalOptionsConverter" />
            <converters:CenteredContentBoxPresentationKindToVerticalOptionsConverter x:Key="CenteredContentBoxPresentationKindToVerticalOptionsConverter" />
            <converters:CenteredContentBoxPresentationKindToColumIndexConverter x:Key="CenteredContentBoxPresentationKindToColumIndexConverter" />
            <converters:CenteredContentBoxPresentationKindToColumSpanConverter x:Key="CenteredContentBoxPresentationKindToColumSpanConverter" />
            <converters:HeaderFontFamilyNameToFontAttributesConverter x:Key="HeaderFontFamilyNameToFontAttributesConverter" />
            <converters:CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxPaddingConverter x:Key="CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxPaddingConverter" PlacardView="{Reference RootView}" />
            <converters:CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxSpacingConverter x:Key="CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxSpacingConverter" PlacardView="{Reference RootView}" />
            <converters:IsNullToImageAspectConverter x:Key="IsNullToImageAspectConverter" />

            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" Scale="3.2" />
            
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

            <Style TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid 
                    x:Name="BackgroundImageWrapper"
                    Grid.ColumnSpan="3"
                    BackgroundColor="Black">
                    <ffimageloadingforms:CachedImage
                        x:Name="BackgroundImageThumbnailImage"
                        IsVisible="{Binding Path=BackgroundImageThumbnailSource, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneTime}"
                        Source="{Binding Path=BackgroundImageThumbnailSource, Mode=OneTime}"
                        Aspect="AspectFill"
                        CacheType="Disk"
                        CacheDuration="8760:00:00"
                        FadeAnimationEnabled="False"
                        IsOpaque="False">
                        <ffimageloadingforms:CachedImage.Transformations>
                            <fftransformations:BlurredTransformation />
                        </ffimageloadingforms:CachedImage.Transformations>
                    </ffimageloadingforms:CachedImage>
                    <ffimageloadingforms:CachedImage
                        x:Name="BackgroundImagen"
                        FadeAnimationEnabled="False"
                        Source="{Binding Path=BackgroundImageSource, Mode=OneTime}" 
                        Aspect="{Binding Path=BackgroundImageThumbnailSource, Converter={StaticResource IsNullToImageAspectConverter}}"
                        CacheType="Disk"
                        CacheDuration="8760:00:00" />
                </Grid>
                <Grid
                    x:Name="OverlapLayout"
                    Grid.Column="{Binding Path=ContentBoxPresentationKind, Converter={StaticResource CenteredContentBoxPresentationKindToColumIndexConverter}, Mode=OneTime}"
                    Grid.ColumnSpan="{Binding Path=ContentBoxPresentationKind, Converter={StaticResource CenteredContentBoxPresentationKindToColumSpanConverter}, Mode=OneTime}"
                    HorizontalOptions="{Binding Path=ContentBoxPresentationKind, Converter={StaticResource CenteredContentBoxPresentationKindToHorizontalOptionsConverter}, Mode=OneTime}"
                    VerticalOptions="{Binding Path=ContentBoxPresentationKind, Converter={StaticResource CenteredContentBoxPresentationKindToVerticalOptionsConverter}, Mode=OneTime}">
                    <StackLayout 
                        HorizontalOptions="Center" VerticalOptions="Center"
                        Padding="{Binding Source={Reference RootView}, Path=Width, Converter={StaticResource CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxPaddingConverter}}"
                        Spacing="{Binding Source={Reference RootView}, Path=Width, Converter={StaticResource CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxSpacingConverter}}">
                        <StackLayout
                            x:Name="InfoBlocksLayout"
                            Spacing="{Binding Source={Reference RootView}, Path=Width, Converter={StaticResource CenteredTraslucentIntroOverImagePlacardViewWidthToContentBoxSpacingConverter}}"
                            BindableLayout.ItemsSource="{Binding Path=ContentBlocks}"
                            BindableLayout.ItemTemplateSelector="{StaticResource ContentBlockTemplateSelector}" />
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>