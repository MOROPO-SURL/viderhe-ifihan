<?xml version="1.0" encoding="utf-8" ?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:communitytoolkit_ui="http://xamarin.com/schemas/2020/toolkit"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Presentation.Converters"
    xmlns:viewtemplates="clr-namespace:MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Presentation.Views.Template"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationrenderedviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views.Rendered;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:skiaformviews="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
    x:Class="MOROPO.VIDERHE.Extend.OccasionSlides.Templating.Presentation.Views.Placard.LeftLandscapeContextualTrailOverlapForVideoPlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <viewtemplates:ContentBlockTemplateSelector x:Key="ContentBlockTemplateSelector" RelativeSizeScalableView="{Reference RootView}" />

            <converters:OverlapSizeToColumnSpanConverter x:Key="OverlapSizeToColumnSpanConverter" />
            <converters:OverlapSizeToColumnSpanConverter x:Key="OverlapSizeToContentColumnSpanConverter" IsForContent="True" />
            <converters:OverlapWidthToLeftContentPaddingConverter x:Key="OverlapWidthToLeftContentPaddingConverter" />
            <converters:OverlapWidthToInfoBlockPaddingConverter x:Key="OverlapWidthToInfoBlockPaddingConverter" />
            <converters:OverlapWidthToInfoBlockLabelPaddingConverter x:Key="OverlapWidthToInfoBlockLabelPaddingConverter" />
            <converters:HeaderFontFamilyNameToFontAttributesConverter x:Key="HeaderFontFamilyNameToFontAttributesConverter" />

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout" BackgroundColor="DimGray">
                <!--<extendcommontemplatingpresentationrenderedviews:CloudVideoPlayerView
                    x:Name="ContextedVideo"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    BackgroundColor="Black"
                    Source="{Binding Path=ContextedVideoSource}"
                    StrechAspect="AspectFill"
                    ShowControls="False"
                    AutoPlay="True"
                    IsMuted="{Binding Path=ContextedVideoMuted}"
                    StatusUpdated="VideoPlayer_StatusUpdated" />-->
                <communitytoolkit_ui:MediaElement
                    x:Name="ContextedVideo"
                    VerticalOptions="Center" HorizontalOptions="Center"
                    BackgroundColor="Black"
                    Source="{Binding Path=ContextedVideoSource}"
                    ShowsPlaybackControls="False"
                    AutoPlay="True"
                    Aspect="AspectFill"
                    MediaOpened="VideoPlayerView_MediaOpened"
                    MediaEnded="VideoPlayerView_MediaEnded"
                    MediaFailed="VideoPlayerView_MediaEnded" />
                <Grid
                    x:Name="OverlapLayout"
                    ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <skiaformviews:SKCanvasView
                        Grid.ColumnSpan="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToColumnSpanConverter}, Mode=OneTime}"
                        PaintSurface="OverlapContentWrapLayoutCanvasView_PaintSurface" />
                    <Grid
                        Grid.ColumnSpan="{Binding Path=OverlapSize, Converter={StaticResource OverlapSizeToContentColumnSpanConverter}, Mode=OneTime}"
                        Padding="{Binding Source={Reference Wrapper}, Path=Width, Converter={StaticResource OverlapWidthToLeftContentPaddingConverter}}">
                        <StackLayout 
                            VerticalOptions="Center"
                            Spacing="0">
                            <StackLayout
                                x:Name="InfoBlocksLayout"
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding Path=ContentBlocks}"
                                BindableLayout.ItemTemplateSelector="{StaticResource ContentBlockTemplateSelector}" />
                        </StackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>