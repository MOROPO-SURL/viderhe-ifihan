<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Views.LandscapeAnonimusHeroPlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <ResourceDictionary>
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" SizeScalableView="{Reference RootView}" />
            
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8.5*" />
                    <ColumnDefinition Width="0.5*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>
                <ffimageloadingforms:CachedImage
                    x:Name="HeroImage"
                    Grid.Column="2"
                    BackgroundColor="Black"
                    FadeAnimationEnabled="False"
                    Source="{Binding Path=HeroImageSource, Mode=OneTime}" 
                    Aspect="AspectFill"
                    CacheType="Disk"
                    CacheDuration="8760:00:00" />
                <ffimageloadingforms:CachedImage
                    x:Name="MaskBackgroundImagen"
                    Grid.ColumnSpan="3"
                    Scale="15"
                    FadeAnimationEnabled="False" 
                    Aspect="Fill" />
                <Grid
                    Grid.Column="0"
                    Margin="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=10}"
                    RowSpacing="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=25}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ffimageloadingsvg:SvgCachedImage 
                        x:Name="LogoImage"
                        HorizontalOptions="Start"
                        Grid.Row="0"
                        Scale="0"
                        Margin="0,0,0,10"
                        HeightRequest="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=5}" />
                    <Label 
                        x:Name="HeaderLabel"
                        Grid.Row="1"
                        Opacity="0"
                        Text="{Binding Path=Header, Mode=OneTime}"
                        FontFamily="Montserrat ExtraBold"
                        FontSize="{Binding Path=HeaderFontSize, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    <StackLayout
                        Grid.Row="2"
                        VerticalOptions="FillAndExpand"
                        IsClippedToBounds="True">
                        <Label
                            x:Name="ContentLabel"
                            Opacity="0"
                            VerticalOptions="Fill"
                            Text="{Binding Path=Content, Mode=OneTime}"
                            FontFamily="Montserrat SemiBold"
                            FontSize="{Binding Path=ContentFontSize, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>