<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Views.LandscapePennantPlacardView"
    x:Name="Self">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:LandscapePennantPlacardViewHeightToContentPaddingConverter x:Key="LandscapePennantPlacardViewHeightToContentPaddingConverter" PlacardView="{Reference Self}" />
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ffimageloadingforms:CachedImage
                    x:Name="ContextedImagen"
                    Grid.ColumnSpan="3" Grid.RowSpan="3"
                    BackgroundColor="Black"
                    FadeAnimationEnabled="False"
                    Source="{Binding Path=ContextedImageSource}" 
                    Aspect="AspectFill"
                    CacheType="Disk"
                    CacheDuration="8760:00:00" />
                <ffimageloadingsvg:SvgCachedImage
                    x:Name="PennantImage"
                    Grid.ColumnSpan="3" Grid.RowSpan="3"
                    Aspect="Fill" />
                <Grid
                    x:Name="DataLayoutWrapGrid"
                    Grid.Column="1" Grid.RowSpan="2">
                    <StackLayout 
                        VerticalOptions="Center"
                        Margin="{Binding Source={x:Reference PlacardLayout}, Path=Height, Converter={StaticResource LandscapePennantPlacardViewHeightToContentPaddingConverter}}"
                        IsClippedToBounds="True"
                        Spacing="{Binding Source={x:Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=20}">
                        <ffimageloadingsvg:SvgCachedImage 
                            x:Name="LogoImage"
                            HorizontalOptions="Center"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type StackLayout}}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=2}" />
                        <Label 
                            x:Name="HeaderLabel"
                            Text="{Binding Path=Header}"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            FontFamily="Montserrat ExtraBold"
                            FontSize="{Binding Path=HeaderFontSize, Converter={StaticResource SizeToRelativeValueConverter}}" />
                        <Label
                            x:Name="ContentLabel"
                            Text="{Binding Path=Content}"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            FontFamily="Montserrat SemiBold"
                            FontSize="{Binding Path=ContentFontSize, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>