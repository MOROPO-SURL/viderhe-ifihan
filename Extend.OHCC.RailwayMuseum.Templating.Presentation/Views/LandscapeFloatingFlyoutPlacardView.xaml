<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Extend.OHCC.RailwayMuseum.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="MOROPO.VIDERHE.Extend.OHCC.RailwayMuseum.Templating.Presentation.Views.LandscapeFloatingFlyoutPlacardView"
    x:Name="Self">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:FlyoutHorizontalOrientationToXFHorizontalOrientationConverter x:Key="FlyoutHorizontalOrientationToXFHorizontalOrientationConverter" />
            <converters:LandscapeFloatingFlyoutPlacardViewWidthToContentPaddingConverter x:Key="LandscapeFloatingFlyoutPlacardViewWidthToContentPaddingConverter" PlacardView="{Reference Self}" />

            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" SizeScalableView="{Reference Self}" />
            
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="4*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ffimageloadingforms:CachedImage
                    x:Name="ContextedImagen"
                    Grid.ColumnSpan="3" Grid.RowSpan="3"
                    BackgroundColor="Black"
                    FadeAnimationEnabled="False"
                    Source="{Binding Path=ContextedImageSource}" 
                    Aspect="AspectFill"
                    CacheType="Disk"
                    CacheDuration="8760:00:00" />
                <ffimageloadingsvg:SvgCachedImage
                    x:Name="FloatingFlyoutImage"
                    Grid.ColumnSpan="3" Grid.RowSpan="3"
                    Aspect="Fill" />
                <Grid
                    x:Name="DataLayoutWrapGrid"
                    Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
                    <StackLayout 
                        VerticalOptions="Center"
                        Margin="{Binding Source={x:Reference PlacardLayout}, Path=Width, Converter={StaticResource LandscapeFloatingFlyoutPlacardViewWidthToContentPaddingConverter}}"
                        IsClippedToBounds="True"
                        Spacing="{Binding Source={x:Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=20}">
                        <ffimageloadingsvg:SvgCachedImage 
                            x:Name="LogoImage"
                            HorizontalOptions="{Binding Path=FlyoutHorizontalOrientation, Converter={StaticResource FlyoutHorizontalOrientationToXFHorizontalOrientationConverter}, Mode=OneTime}"
                            HeightRequest="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=5}" />
                        <Label 
                            x:Name="HeaderLabel"
                            Text="{Binding Path=Header}"
                            TextColor="White"
                            FontFamily="Montserrat ExtraBold"
                            FontSize="{Binding Path=HeaderFontSize, Converter={StaticResource SizeToRelativeValueConverter}}" />
                        <Label
                            x:Name="ContentLabel"
                            Text="{Binding Path=Content}"
                            TextColor="White"
                            FontFamily="Montserrat SemiBold"
                            FontSize="{Binding Path=ContentFontSize, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>