<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationrenderedviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views.Rendered;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Views.InfinityVideoPlacardView"
    x:Name="Self">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InfinityVideoPlacardViewHeightToPaddingConverter x:Key="InfinityVideoPlacardViewHeightToPaddingConverter" PlacardView="{Reference Self}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid 
                x:Name="PlacardLayout"
                BackgroundColor="Black"
                Padding="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource InfinityVideoPlacardViewHeightToPaddingConverter}}">
                <ffimageloadingforms:CachedImage
                    FadeAnimationEnabled="False"
                    Source="{Binding Path=VideoThumbnailImageSource}" 
                    Aspect="AspectFill"
                    CacheType="Disk"
                    CacheDuration="8760:00:00" />
                <extendcommontemplatingpresentationrenderedviews:CloudVideoPlayerView
                    x:Name="VideoPlayerView"
                    BackgroundColor="Black"
                    Source="{Binding Path=VideoSource}"
                    ShowControls="False"
                    StrechAspect="AspectFill"
                    AutoPlay="True"
                    Repeat="True"
                    StatusUpdated="VideoPlayer_StatusUpdated" />
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>