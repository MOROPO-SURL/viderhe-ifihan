<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Templating.Presentation.Views.InfinityVideoPlacardView"
    x:Name="Self">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InfinityVideoPlacardViewHeightToPaddingConverter x:Key="InfinityVideoPlacardViewHeightToPaddingConverter" PlacardView="{Reference Self}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid 
                x:Name="PlacardLayout"
                BackgroundColor="Black"
                Padding="{Binding Source={Reference PlacardLayout}, Path=Height, Converter={StaticResource InfinityVideoPlacardViewHeightToPaddingConverter}}">
                <Grid 
                    x:Name="FramesContainer"
                    IsClippedToBounds="True" />
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>