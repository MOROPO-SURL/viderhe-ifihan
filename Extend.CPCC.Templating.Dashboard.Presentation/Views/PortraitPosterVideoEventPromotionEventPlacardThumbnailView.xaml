<?xml version="1.0" encoding="UTF-8"?>
<sscxftoolkitmvvmviews:ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sscxftoolkitmvvmviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Views;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.CPCC.Templating.Dashboard.Presentation.Views.PortraitPosterVideoEventPromotionEventPlacardThumbnailView">
    <ContentView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ffimageloadingforms:CachedImage
                x:Name="EventPosterImage"
                Grid.Row="0"
                HorizontalOptions="Center"
                CacheType="Disk"
                CacheDuration="8760:00:00" />
            <ffimageloadingforms:CachedImage
                x:Name="EventVideoThumnailImage"
                Grid.Row="1"
                CacheType="Disk"
                CacheDuration="8760:00:00" />
        </Grid>
    </ContentView.Content>
</sscxftoolkitmvvmviews:ContentView>