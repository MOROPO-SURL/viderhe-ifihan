<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Extend.Essential.Templating.Presentation.Converters"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationrenderedviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views.Rendered;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="MOROPO.VIDERHE.Extend.Essential.Templating.Presentation.Views.LandscapePicturePresentingVideoPlacardView">
    <ContentView.Resources>
        <ResourceDictionary>
            <converters:PlacardLayoutHeightToRespectivePresenterImageWidthConverter x:Key="PlacardLayoutHeightToRespectivePresenterImageWidthConverter" PlacardLayout="{x:Reference PlacardLayout}" />
            <converters:LandscapePresentationSideToLayoutOptionConverter x:Key="LandscapePresentationSideToLayoutOptionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="PlacardLayout">                
                <extendcommontemplatingpresentationrenderedviews:CloudVideoPlayerView
                    x:Name="PresentedVideo"
                    BackgroundColor="Black"
                    Source="{Binding Path=PresentedSource}"
                    ShowControls="False"
                    AutoPlay="True"
                    StatusUpdated="VideoPlayer_StatusUpdated" />
                <ffimageloadingforms:CachedImage
                    x:Name="PresenterImage"
                    IsVisible="False"
                    HorizontalOptions="{Binding Path=PresenterSide, Converter={StaticResource LandscapePresentationSideToLayoutOptionConverter}}"
                    WidthRequest="{Binding Source={x:Reference PlacardLayout}, Path=Height, Converter={StaticResource PlacardLayoutHeightToRespectivePresenterImageWidthConverter}}"
                    FadeAnimationEnabled="False"
                    Source="{Binding Path=PresenterSource}" 
                    Aspect="AspectFit"
                    CacheType="Disk"
                    CacheDuration="8760:00:00" />
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>