<?xml version="1.0" encoding="UTF-8"?>
<extendcommonpresentationviews:BasePlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extendcommonpresentationviews="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Presentation.Views;assembly=SmartSolucionesCuba.Videre.Extend.Common.Presentation"
    xmlns:extendcommontemplatingpresentationrenderedviews="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Templating.Presentation.Views.Rendered;assembly=SmartSolucionesCuba.Videre.Extend.Common.Templating.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Presentation.Views.SimpleVideoPlacardView">
    <ContentView.Content>
        <Grid 
            x:Name="Wrapper"
            BackgroundColor="Transparent">
            <extendcommontemplatingpresentationrenderedviews:UnattendedVideoPlayerView
                x:Name="VideoPlayerView"
                BackgroundColor="Black"
                Source="{Binding Path=VideoSource}"
                ShowControls="False"
                AutoPlay="True"
                StatusUpdated="VideoPlayer_StatusUpdated" />
        </Grid>
    </ContentView.Content>
</extendcommonpresentationviews:BasePlacardPresentationView>