<?xml version="1.0" encoding="UTF-8"?>
<extendcommonpresentationviews:BasePlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading.Transformations"
    xmlns:extendcommonpresentationviews="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Presentation.Views;assembly=SmartSolucionesCuba.Videre.Extend.Common.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Presentation.Views.ResponsivePicturePlacardView">
    <ContentView.Content>
        <Grid
            x:Name="Wrapper"
            BackgroundColor="Transparent">
            <Grid x:Name="PlacardLayout">
                <ffimageloadingforms:CachedImage
                    Source="{Binding Path=Source}"
                    Aspect="AspectFill"
                    FadeAnimationEnabled="False"
                    IsOpaque="False">
                    <ffimageloadingforms:CachedImage.Transformations>
                        <fftransformations:BlurredTransformation />
                    </ffimageloadingforms:CachedImage.Transformations>
                </ffimageloadingforms:CachedImage>
                <ffimageloadingforms:CachedImage
                    Source="{Binding Path=Source}"
                    Aspect="AspectFit"                    
                    FadeAnimationEnabled="False"/>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommonpresentationviews:BasePlacardPresentationView>