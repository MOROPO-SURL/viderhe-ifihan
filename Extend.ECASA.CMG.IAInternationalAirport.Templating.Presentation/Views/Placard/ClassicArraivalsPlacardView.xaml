    x:Class="SmartSolucionesCuba.Viderhe.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation.Views.Placard.ClassicArraivalsPlacardView">
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <StackLayout 
                x:Name="ArraivalsLayout" 
                BackgroundColor="{Binding Path=TableBackgroundColor, Mode=OneTime}"
