<?xml version="1.0" encoding="UTF-8"?>
<extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommontemplatingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation.Views.Placard.ClassicArraivalsCondensedPlacardView"
    x:Name="RootView">
    <ContentView.Resources>
        <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" SizeScalableView="{Reference RootView}" />
        <extendcommontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" SizeScalableView="{Reference RootView}" />

        <Thickness x:Key="LogoImageViewMargin">4</Thickness>
        <Thickness x:Key="TableHeaderSeparatorMargin">0,0,0,6</Thickness>
        <Thickness x:Key="TableBodySeparatorMargin">0,4,0,0</Thickness>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="DIN Pro (Regular)" />
        </Style>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <Grid x:Name="ArraivalsLayout">
                <Grid x:Name="TableLayout" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="HeaderGrid"
                        Grid.Row="0">
                        <BoxView x:Name="HeaderBaseBackgroundBoxView" />
                        <Grid 
                            Margin="{Binding Source=12, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" 
                            ColumnSpacing="{Binding Source=12, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid 
                                Grid.Column="0"
                                VerticalOptions="Center">
                                <!--<BoxView 
                                    x:Name="LogoBacklightBoxView"
                                    CornerRadius="3" />-->
                                <ffimageloadingforms:CachedImage
                                    x:Name="LogoImageView"
                                    BackgroundColor="Transparent"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                            </Grid>
                            <Label
                                x:Name="OperationSymbolLabel"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Text="&#xF5D5;"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="{Binding Source=60, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                            <Label 
                                x:Name="HeaderTitleLabel"
                                Grid.Column="2" 
                                VerticalOptions="Center"
                                Text="LLEGADAS / ARRIVALS"
                                FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                                FontFamily="DIN Pro (Black)" />
                            <Label
                                x:Name="DateTimeLabel"
                                Grid.Column="3"
                                VerticalOptions="Center"
                                FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                                FontFamily="DIN Pro (Medium)"
                                HorizontalTextAlignment="Center" />
                        </Grid>
                    </Grid>
                    <BoxView 
                        x:Name="HeaderTableSeparatorBoxView"
                        Grid.Row="1" 
                        HeightRequest="{Binding Source=3, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" 
                        Margin="{Binding Source={StaticResource TableHeaderSeparatorMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}}" />
                    <Grid x:Name="TableHeaderGrid" Grid.Row="2" ColumnSpacing="0" />
                    <ScrollView Grid.Row="3"  Margin="{Binding Source={StaticResource TableBodySeparatorMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}}">
                        <StackLayout 
                            x:Name="TableBodyStackLayout"
                            Spacing="{Binding Source=4, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                            ChildRemoved="TableBodyStackLayout_ChildRemoved" />
                    </ScrollView>
                </Grid>
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommontemplatingpresentationviews:BaseTemplatedPlacardPresentationView>