<?xml version="1.0" encoding="UTF-8"?>
<ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Templating.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation.Views.Fragment.ArraivalsHeaderFragmentView">
    <ContentView.Resources>
        <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
    </ContentView.Resources>
    <ContentView.Content>
        <Grid 
            BackgroundColor="DarkBlue"
            Padding="16"
            ColumnSpacing="16" RowSpacing="0">
            <Grid.Resources>
                <ResourceDictionary>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="White" />
                    </Style>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label
                Grid.Column="0" Grid.RowSpan="2"
                VerticalOptions="Center"
                Text="&#xF5D4;"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="{Binding Source=140, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
            <Label
                Grid.Column="1" Grid.Row="0"
                Text="ARRIBOS / ARRAIVALS"
                FontSize="{Binding Source=60, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                FontAttributes="Bold" />
            <Label
                Grid.Column="1" Grid.Row="1"
                Text="Aeropuerto Internacional Ignacio Agramonte"
                TextColor="LightCyan"
                FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
        </Grid>
    </ContentView.Content>
</ContentView>