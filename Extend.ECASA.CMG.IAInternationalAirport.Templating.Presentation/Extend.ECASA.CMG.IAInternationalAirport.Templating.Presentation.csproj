		<RootNamespace>MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation</RootNamespace>
		<Product>VIDERHE Extension for ECASA International Airport Ignacio Agramonte</Product>
		<Authors>MOROPO VIDERHE DevTeam</Authors>
		<Company>MOROPO S.U.R.L.</Company>
		<Copyright>© MOROPO S.U.R.L. 2024, Todos los derechos reservados.</Copyright>
		<Version>0.2.2</Version>
		<PackageProjectUrl>https://www.moropo.cu/</PackageProjectUrl>
