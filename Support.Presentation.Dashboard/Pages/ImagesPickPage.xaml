<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Videre.Support.Presentation.Dashboard.Models.Page"
    xmlns:views="clr-namespace:SmartSolucionesCuba.Videre.Support.Presentation.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Support.Presentation.Dashboard.Pages.ImagesPickPage"
    x:TypeArguments="pagemodels:ImagesPickPageModel"
    Title="Seleccionar Imágenes">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="BooleanToSelectionStateGlyphIconStringConverter" FalseString="&#xf131;" TrueString="&#xf132;" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="20" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Aplicar"
            Activated="ApplyToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Activated="CancelToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <FlexLayout
                Margin="10"
                BindableLayout.ItemsSource="{Binding Path=SelectableImages}">
                <BindableLayout.EmptyView>
                    <Label
                        IsVisible="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                        Margin="10"
                        Text="Sin elementos que mostrar"
                        TextColor="DimGray" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="10" Padding="0"
                            BackgroundColor="LightGray"
                            WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentView 
                                    Grid.Row="0"
                                    BackgroundColor="Black"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                    <Image Source="{Binding Path=Model, Converter={StaticResource ImageViewModelToThumbnailImageSourceConverter}}" />
                                </ContentView>
                                <BoxView 
                                    Grid.Row="0"
                                    Color="#99000000" 
                                    IsVisible="{Binding Path=Selected}" />
                                <Label
                                    Grid.Row="0"
                                    HorizontalOptions="Start" VerticalOptions="Start"
                                    Margin="20"
                                    BackgroundColor="#99000000"
                                    Text="{Binding Path=Selected, Converter={StaticResource BooleanToSelectionStateGlyphIconStringConverter}}"
                                    TextColor="White"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    FontSize="Medium">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="SelectionToggleLabelTapGestureRecognizer_Tapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <StackLayout 
                                    Grid.Row="0"
                                    IsVisible="{Binding Path=Model.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                    VerticalOptions="End" 
                                    Padding="8"
                                    BackgroundColor="#99000000">
                                    <Label 
                                        Text="{Binding Path=Model.About}"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                                <StackLayout
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Padding="6">
                                    <ContentView 
                                        VerticalOptions="Center"
                                        BackgroundColor="Black"
                                        Padding="4,2"
                                        Margin="4,0">
                                        <Label 
                                            Text="{Binding Path=Model.Format}" 
                                            TextColor="LightGray"
                                            FontAttributes="Bold" />
                                    </ContentView>
                                    <Label 
                                        HorizontalOptions="StartAndExpand" VerticalOptions="Center"
                                        Text="{Binding Path=Model.Resolution}" />
                                    <Button 
                                        Text="Detalles"
                                        Clicked="ImageOverviewDetailButton_Clicked" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>        
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>