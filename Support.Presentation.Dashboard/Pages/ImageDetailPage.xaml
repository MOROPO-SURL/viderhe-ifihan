<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm" 
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.VIDERHE.Support.Presentation.Dashboard.Pages.ImageDetailPage"
    Title="Detalles de la Imagen">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Modificar"
            Activated="EditToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf90b;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid BackgroundColor="Black">
            <ffimageloadingforms:CachedImage 
                Grid.Row="0" Grid.Column="0"
                BackgroundColor="Black"
                Source="{Binding Converter={StaticResource ImageViewModelToImageSourceConverter}}"
                CacheType="Disk"
                CacheDuration="8760:00:00" />
            <views:ImageDetailView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>