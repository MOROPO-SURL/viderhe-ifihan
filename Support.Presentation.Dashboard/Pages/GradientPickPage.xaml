<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters"
    xmlns:views="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    x:Class="SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Pages.GradientPickPage"
    x:TypeArguments="pagemodels:GradientPickPageModel"
    Title="Seleccionar Gradiente">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />

            <converters:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />
            <converters:CollectionViewWidthToSelfVerticalGridItemsLayoutConverter x:Key="CollectionViewWidthToSelfVerticalGridItemsLayoutConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <views:BackgroundView />
            <StackLayout Spacing="0" SizeChanged="GradientCollectionWrapperStackLayout_SizeChanged">
                <CollectionView
                    x:Name="GradientCollectionView"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    ItemsLayout="{Binding Source={x:Reference GradientCollectionView}, Path=Width, Converter={StaticResource CollectionViewWidthToSelfVerticalGridItemsLayoutConverter}}"
                    ItemsSource="{Binding Path=Items}"
                    Scrolled="GradientCollectionView_Scrolled">
                    <CollectionView.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Default="5,5,5,0">
                            <On Platform="Android" Value="10,10,10,0" />
                        </OnPlatform>
                    </CollectionView.Margin>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                Margin="5" Padding="0"
                                BackgroundColor="White"
                                HasShadow="False"
                                CornerRadius="0">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <mg:GradientView
                                        Grid.Row="0" Grid.Column="0"
                                        BackgroundColor="Black"
                                        HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                        GradientSource="{Binding Path=Presented.Source}" />
                                    <StackLayout 
                                        Grid.Row="0" Grid.Column="0"
                                        IsVisible="{Binding Path=Presented.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                        VerticalOptions="End" 
                                        Padding="8"
                                        BackgroundColor="#99000000">
                                        <Label 
                                            Text="{Binding Path=Presented.About}"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation" />
                                    </StackLayout>
                                    <Button 
                                        Grid.Row="1"
                                        Margin="6"
                                        HorizontalOptions="EndAndExpand"
                                        BackgroundColor="Accent"
                                        Text="Seleccionar"
                                        TextColor="White"
                                        Clicked="ItemPickButton_Clicked" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Margin="10"
                    HorizontalOptions="Center"
                    Text="Mostrar más"
                    Clicked="LoadNextPageButtton_Clicked">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                            <Binding Path="HasMoreItems" />
                            <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackLayout>
            <views:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>