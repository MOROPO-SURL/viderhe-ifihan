<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitcresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationviewrendereds="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views.Rendered;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Support.Presentation.Dashboard.Pages.VideoDetailPage"
    Title="Detalles del Video">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitcresentationconverters:IfNullOrEmptyToStringConverter x:Key="IfNullOrEmptyToStringConverter" StringReplacement="Esta video no tiene descripción asociada." />
            <sscxftoolkitcresentationconverters:FileSizeLongToStringConverter x:Key="FileSizeLongToStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Modificar"
            Activated="EditToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf90b;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid
            BackgroundColor="Black">
            <sscxftoolkitpresentationviewrendereds:VideoPlayerView 
                x:Name="VideoPlayer"
                AutoPlay="False"
                Source="{Binding Converter={StaticResource VideoViewModelToVideoSourceConverter}}" />
            <StackLayout 
                VerticalOptions="Start" 
                Padding="8"
                BackgroundColor="#99000000">
                <StackLayout
                    Orientation="Horizontal">
                    <ContentView
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        Padding="4,2">
                        <Label 
                            Text="{Binding Path=Extension}" 
                            TextColor="Black"
                            FontAttributes="Bold" />
                    </ContentView>
                    <Label
                        VerticalOptions="Center"
                        Margin="10,0,0,0"
                        Text="&#xfa23;"
                        TextColor="White"
                        FontFamily="{StaticResource IconFontFamily}" />
                    <Label 
                        VerticalOptions="Center"
                        Text="{Binding Path=FrameSize}"
                        TextColor="White"/>
                    <Label
                        VerticalOptions="Center"
                        Margin="10,0,0,0"
                        Text="&#xf5a1;"
                        TextColor="White"
                        FontFamily="{StaticResource IconFontFamily}" />
                    <Label
                        VerticalOptions="Center"
                        Text="{Binding Path=Size, Converter={StaticResource FileSizeLongToStringConverter}}"
                        TextColor="White" />
                    <Label
                        VerticalOptions="Center"
                        Margin="10,0,0,0"
                        Text="&#xf0f0;"
                        TextColor="White"
                        FontFamily="{StaticResource IconFontFamily}" />
                    <Label
                        VerticalOptions="Center" HorizontalOptions="StartAndExpand"
                        Text="{Binding Path=CreateAt}"
                        TextColor="White" />
                </StackLayout>
                <Label 
                    Text="Descripción"
                    TextColor="White"
                    FontAttributes="Bold" />
                <Label 
                    Text="{Binding Path=About, Converter={StaticResource IfNullOrEmptyToStringConverter}}"
                    TextColor="White" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>