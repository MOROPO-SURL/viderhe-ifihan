<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Models.Page"
    xmlns:behaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Behaviors"
    xmlns:presentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation"
    xmlns:supportpresentationdashboardviewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Models.View;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Pages.HeroLocalNowDateTimePlacardConfigurationPage"
    x:TypeArguments="pagemodels:HeroLocalNowDateTimePlacardConfigurationPageModel"
    x:DataType="pagemodels:HeroLocalNowDateTimePlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <presentationconverters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="supportpresentationdashboardviewmodels:ValidationMessageViewModel">
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Etiqueta" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="2" Grid.Row="3" Grid.RowSpan="5"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                Margin="12,12,12,0"
                                Text="Fondo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ContentView
                                    BackgroundColor="Black"
                                    Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="3" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Estilo" Style="{StaticResource FormLabel}" />
                            <Picker
                                SelectedItem="{Binding Path=Style}"
                                ItemsSource="{Binding Path=AvailableStyles}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="4" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="TextColorLabel"
                                Text="Color del Texto" 
                                Style="{StaticResource FormLabel}" />
                            <simplecolorpicker:ColorPickerEntry 
                                EditAlfa="False"
                                Color="{Binding Path=TextColor}">
                                <simplecolorpicker:ColorPickerEntry.Behaviors>
                                    <behaviors:SimpleColorPickerEntryBehavior PreviewBorderColor="DimGray" />
                                </simplecolorpicker:ColorPickerEntry.Behaviors>
                            </simplecolorpicker:ColorPickerEntry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Idioma" Style="{StaticResource FormLabel}" />
                            <Picker
                                SelectedIndex="{Binding Path=CultureIndex}"
                                ItemsSource="{Binding Path=AvailableCultures}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="6" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Enmarcar?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsDateTimeFramed}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>