<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Dashboard.Presentation.Models.Page"
    xmlns:behaviors="clr-namespace:MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Dashboard.Presentation.Behaviors"
    xmlns:presentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Presentation"
    xmlns:supportpresentationdashboardviewmodels="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Models.View;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Validators;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Behaviors;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Presenters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    x:Class="MOROPO.VIDERHE.Extend.SocialWelfare.Templating.Dashboard.Presentation.Pages.HeroLocalNowDateTimePlacardConfigurationPage"
    x:TypeArguments="pagemodels:HeroLocalNowDateTimePlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            
            <presentationconverters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="supportpresentationdashboardviewmodels:ValidationMessageViewModel">
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,4,6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="6" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="&#xF415;"
                                Style="{StaticResource TextIconButton}"
                                FontSize="Medium"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="BeginAtDatePickerLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                x:Name="BeginAtDatePicker"
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="EndAtLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                x:Name="DefineEndAtSwitch"
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}">
                                <DatePicker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultDatePickerValidationPresenter.Instance}"
                                        TargetProperty="{Static DatePicker.DateProperty}"
                                        Label="{Reference EndAtLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:DateComparisonFormFieldValidator 
                                                ReferenceField="{Reference BeginAtDatePicker}" 
                                                ReferenceFieldLabel="{Reference BeginAtDatePickerLabel}"
                                                FieldValidationSwich="{Reference DefineEndAtSwitch}" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </DatePicker.Behaviors>
                            </DatePicker>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="2" Grid.Row="5" Grid.RowSpan="6"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                x:Name="BackgroundLabel"
                                Margin="12,12,12,0"
                                Text="Fondo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ContentView
                                    BackgroundColor="Black"
                                    Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}">
                                    <ContentView.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultContentViewValidationPresenter.Instance}"
                                            TargetProperty="{Static ContentView.ContentProperty}"
                                            Label="{Reference BackgroundLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <supportpresentationdashboardvalidators:NotNullFormFieldValidator />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </ContentView.Behaviors>
                                </ContentView>
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="5" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="StyleLabel"
                                Text="Estilo" 
                                Style="{StaticResource FormLabel}" />
                            <Picker
                                SelectedItem="{Binding Path=Style}"
                                ItemsSource="{Binding Path=AvailableStyles}">
                                <Picker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultPickerValidationPresenter.Instance}"
                                        TargetProperty="{Static Picker.SelectedItemProperty}"
                                        Label="{Reference StyleLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:NotNullFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Picker.Behaviors>
                            </Picker>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="6" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="TextColorLabel"
                                Text="Color del Texto" 
                                Style="{StaticResource FormLabel}" />
                            <simplecolorpicker:ColorPickerEntry 
                                EditAlfa="False"
                                Color="{Binding Path=TextColor}">
                                <simplecolorpicker:ColorPickerEntry.Behaviors>
                                    <behaviors:SimpleColorPickerEntryBehavior PreviewBorderColor="DimGray" />
                                </simplecolorpicker:ColorPickerEntry.Behaviors>
                            </simplecolorpicker:ColorPickerEntry>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="7" Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="3" Grid.Row="0"
                                Text="Fuente" 
                                Style="{StaticResource FormLabel}" />
                            <Entry
                                Grid.Column="0" Grid.Row="1"
                                Text="{Binding Path=TextFontFamily}"
                                Placeholder="Sistema"
                                PlaceholderColor="Black"
                                IsReadOnly="True" />
                            <Button
                                Grid.Column="1" Grid.Row="1"
                                Text="Seleccionar"
                                Clicked="TextFontFamilyPickButton_Clicked" />
                            <Button 
                                Grid.Column="2" Grid.Row="1"
                                IsEnabled="{Binding Path=TextFontFamily, Converter={StaticResource NotNullToBooleanConverter}}"
                                Style="{StaticResource TextIconButton}"
                                Text="&#xF413;"
                                Clicked="TextFontFamilyClearButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="8"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="CultureLabel"
                                Text="Idioma" 
                                Style="{StaticResource FormLabel}" />
                            <Picker
                                SelectedIndex="{Binding Path=CultureIndex}"
                                ItemsSource="{Binding Path=AvailableCultures}">
                                <Picker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultPickerValidationPresenter.Instance}"
                                        TargetProperty="{Static Picker.SelectedItemProperty}"
                                        Label="{Reference CultureLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:NotNullFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Picker.Behaviors>
                            </Picker>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="9" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Enmarcar?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsDateTimeFramed}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>