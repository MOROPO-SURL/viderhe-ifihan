<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Models.Page"
    xmlns:presentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    xmlns:nodatimes="clr-namespace:NodaTime;assembly=NodaTime"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Pages.OverlayHeroCityTimeWeatherPlacardConfigurationPage"
    x:TypeArguments="pagemodels:OverlayHeroCityTimeWeatherPlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />

            <presentationconverters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame Grid.ColumnSpan="3" Grid.Row="1">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,4,6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="6" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="&#xF415;"
                                Style="{StaticResource TextIconButton}"
                                FontSize="Medium"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="BeginAtDatePickerLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                x:Name="BeginAtDatePicker"
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="EndAtLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                x:Name="DefineEndAtSwitch"
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}">
                                <DatePicker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultDatePickerValidationPresenter.Instance}"
                                        TargetProperty="{Static DatePicker.DateProperty}"
                                        Label="{Reference EndAtLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:DateComparisonFormFieldValidator 
                                                ReferenceField="{Reference BeginAtDatePicker}" 
                                                ReferenceFieldLabel="{Reference BeginAtDatePickerLabel}"
                                                FieldValidationSwich="{Reference DefineEndAtSwitch}" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </DatePicker.Behaviors>
                            </DatePicker>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="4"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5">
                        <StackLayout>
                            <Label
                                Style="{StaticResource FormLabel}"
                                Text="Servidor Intermedio Weather" />
                            <StackLayout Orientation="Horizontal">
                                <Entry 
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="LightGray"
                                    Text="{Binding Path=WeatherCacheMicroServerHost}"
                                    Placeholder="Ej: weather.viderhe.net"
                                    IsReadOnly="True" />
                                <Button 
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xf90b;"
                                    Clicked="SetWeatherCacheMicroServerHostButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="5">
                        <StackLayout>
                            <Label Text="Servicio" Style="{StaticResource FormLabel}" />
                            <Picker
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                SelectedItem="{Binding Path=Service}"
                                ItemsSource="{Binding Path=AvailableServices}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Servidor Usa Conexión Segura" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Servidor Con Seguridad Estricta" Style="{StaticResource FormLabel}" />
                            <Switch 
                                IsEnabled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}"
                                IsToggled="{Binding Path=IsWeatherCacheMicroServerSecureConnectionStrict}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="6">
                        <StackLayout>
                            <Label Text="Ciudad" Style="{StaticResource FormLabel}" />
                            <Picker
                                x:Name="CityPicker"
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                ItemsSource="{Binding Path=AvailableCities}"
                                ItemDisplayBinding="{Binding Path=Name}"
                                SelectedIndexChanged="CityPicker_SelectedIndexChanged"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="7"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                Margin="12,12,12,0"
                                Text="Fondo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ContentView
                                    BackgroundColor="Black"
                                    Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <StackLayout 
                        Grid.Column="2" Grid.Row="7"
                        Spacing="10">
                        <Frame Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label Text="Zona Horaria" Style="{StaticResource FormLabel}" />
                                <Picker
                                    ItemsSource="{Binding Source={Static nodatimes:DateTimeZoneProviders.Tzdb}, Path=Ids}"
                                    SelectedItem="{Binding Path=DateTimeZoneId}" />
                            </StackLayout>
                        </Frame>
                        <Frame Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label 
                                    x:Name="TextColorLabel"
                                    Text="Color del Texto" 
                                    Style="{StaticResource FormLabel}" />
                                <simplecolorpicker:ColorPickerEntry 
                                    EditAlfa="False"
                                    Color="{Binding Path=TextColor}" />
                            </StackLayout>
                        </Frame>
                        <Frame 
                            VerticalOptions="Start"
                            Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label 
                                    Text="Capa de Contraste" 
                                    Style="{StaticResource FormLabel}" />
                                <Switch 
                                    IsToggled="{Binding Path=OverlayColor, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneWay}"
                                    Toggled="OverlayUseSwitch_Toggled" />
                                <simplecolorpicker:ColorPickerEntry 
                                    x:Name="OverlayColorPickerEntry"
                                    IsVisible="{Binding Path=OverlayColor, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneWay}"
                                    EditAlfa="True" />
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>