<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Models.Page"
    xmlns:presentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Presentation"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:simplecolorpicker="clr-namespace:Xam.Plugin.SimpleColorPicker;assembly=Xam.Plugin.SimpleColorPicker"
    xmlns:nodatimes="clr-namespace:NodaTime;assembly=NodaTime"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.SocialWelfare.Templating.Dashboard.Presentation.Pages.OverlayHeroCityTimeWeatherPlacardConfigurationPage"
    x:TypeArguments="pagemodels:OverlayHeroCityTimeWeatherPlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />

            <presentationconverters:BackgroundToViewConverter x:Key="BackgroundToViewConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.ColumnSpan="3" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="1"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="2"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3">
                        <StackLayout>
                            <Label
                                Style="{StaticResource FormLabel}"
                                Text="Servidor Intermedio Weather" />
                            <StackLayout Orientation="Horizontal">
                                <Entry 
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="LightGray"
                                    Text="{Binding Path=WeatherCacheMicroServerHost}"
                                    Placeholder="Ej: weather.viderhe.net"
                                    IsReadOnly="True" />
                                <Button 
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xf90b;"
                                    Clicked="SetWeatherCacheMicroServerHostButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="3">
                        <StackLayout>
                            <Label Text="Servicio" Style="{StaticResource FormLabel}" />
                            <Picker
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                SelectedItem="{Binding Path=Service}"
                                ItemsSource="{Binding Path=AvailableServices}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Servidor Usa Conexión Segura" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Servidor Con Seguridad Estricta" Style="{StaticResource FormLabel}" />
                            <Switch 
                                IsEnabled="{Binding Path=IsWeatherCacheMicroServerRequireSecureConnection}"
                                IsToggled="{Binding Path=IsWeatherCacheMicroServerSecureConnectionStrict}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Ciudad" Style="{StaticResource FormLabel}" />
                            <Picker
                                x:Name="CityPicker"
                                IsEnabled="{Binding Path=WeatherCacheMicroServerHost, Converter={StaticResource NotNullToBooleanConverter}}"
                                ItemsSource="{Binding Path=AvailableCities}"
                                ItemDisplayBinding="{Binding Path=Name}"
                                SelectedIndexChanged="CityPicker_SelectedIndexChanged"/>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label
                                Margin="12,12,12,0"
                                Text="Fondo" 
                                Style="{StaticResource FormLabel}" />
                            <Grid HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackgroundGestureRecognizer_Tapped" />
                                </Grid.GestureRecognizers>
                                <ContentView
                                    BackgroundColor="Black"
                                    Content="{Binding Path=Background, Converter={StaticResource BackgroundToViewConverter}}" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <StackLayout 
                        Grid.Column="2" Grid.Row="5"
                        Spacing="10">
                        <Frame Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label Text="Zona Horaria" Style="{StaticResource FormLabel}" />
                                <Picker
                                    ItemsSource="{Binding Source={Static nodatimes:DateTimeZoneProviders.Tzdb}, Path=Ids}"
                                    SelectedItem="{Binding Path=DateTimeZoneId}" />
                            </StackLayout>
                        </Frame>
                        <Frame Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label 
                                    x:Name="TextColorLabel"
                                    Text="Color del Texto" 
                                    Style="{StaticResource FormLabel}" />
                                <simplecolorpicker:ColorPickerEntry 
                                    EditAlfa="False"
                                    Color="{Binding Path=TextColor}" />
                            </StackLayout>
                        </Frame>
                        <Frame 
                            VerticalOptions="Start"
                            Style="{StaticResource FormFieldFrame}">
                            <StackLayout>
                                <Label 
                                    Text="Capa de Contraste" 
                                    Style="{StaticResource FormLabel}" />
                                <Switch 
                                    IsToggled="{Binding Path=OverlayColor, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneWay}"
                                    Toggled="OverlayUseSwitch_Toggled" />
                                <simplecolorpicker:ColorPickerEntry 
                                    x:Name="OverlayColorPickerEntry"
                                    IsVisible="{Binding Path=OverlayColor, Converter={StaticResource NotNullToBooleanConverter}, Mode=OneWay}"
                                    EditAlfa="True" />
                            </StackLayout>
                        </Frame>
                    </StackLayout>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>