<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Extend.CPCC.Overlaying.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    x:Class="MOROPO.VIDERHE.Extend.CPCC.Overlaying.Dashboard.Presentation.Pages.NMTourOverlayConfigurationPage"
    x:TypeArguments="pagemodels:NMTourOverlayConfigurationPageModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid 
                    Margin="10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Nombre del Servidor" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=ServerName}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Servidor Seguro" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsSecureServer}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="3" Grid.Row="0"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Servidor con Seguridad Estricta" Style="{StaticResource FormLabel}" />
                            <Switch 
                                IsEnabled="{Binding Path=IsSecureServer}"
                                IsToggled="{Binding Path=IsRequiredSecurityStrict}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Cabeza de Avisos" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Head}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Cola de Avisos" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Tail}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Separador de Avisos" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Separator}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Mensaje de Respaldo" Style="{StaticResource FormLabel}" />
                            <Editor HeightRequest="180" Text="{Binding Path=FailbackMessage}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>