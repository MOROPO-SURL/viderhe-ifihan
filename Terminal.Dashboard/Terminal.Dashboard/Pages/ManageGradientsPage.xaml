<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:supportpresentationdashboardconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:mg="clr-namespace:MagicGradients;assembly=MagicGradients"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.ManageGradientsPage"   
    x:TypeArguments="pagemodels:ManageGradientsPageModel"
    Title="Gradientes">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />

            <supportpresentationdashboardconverters:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />
            <supportpresentationdashboardconverters:CollectionViewWidthToSelfVerticalGridItemsLayoutConverter x:Key="CollectionViewWidthToSelfVerticalGridItemsLayoutConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Agregar"
            Activated="AddToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf415;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem
            Text="Actualizar"
            Clicked="ReloadToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource IconFontFamily}" Glyph="&#xf6ea;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <StackLayout Spacing="0" SizeChanged="GradientCollectionWrapperStackLayout_SizeChanged">
                <CollectionView
                    x:Name="GradientCollectionView"
                    SelectionMode="None"
                    VerticalOptions="FillAndExpand"
                    ItemsLayout="{Binding Source={x:Reference GradientCollectionView}, Path=Width, Converter={StaticResource CollectionViewWidthToSelfVerticalGridItemsLayoutConverter}}"
                    ItemsSource="{Binding Path=Items}"
                    Scrolled="GradientCollectionView_Scrolled">
                    <CollectionView.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Default="5,5,5,0">
                            <On Platform="Android" Value="10,10,10,0" />
                        </OnPlatform>
                    </CollectionView.Margin>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                Margin="5" Padding="0"
                                BackgroundColor="White"
                                CornerRadius="0"
                                HasShadow="False">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <mg:GradientView
                                        Grid.Row="0" Grid.Column="0"
                                        BackgroundColor="Black"
                                        HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                        GradientSource="{Binding Path=Presented.Source}" />
                                    <StackLayout 
                                        Grid.Row="0" Grid.Column="0"
                                        IsVisible="{Binding Path=Presented.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                        VerticalOptions="End" 
                                        Padding="8"
                                        BackgroundColor="#99000000">
                                        <Label 
                                            Text="{Binding Path=Presented.About}"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Padding="6" Spacing="3">
                                        <Button 
                                            HorizontalOptions="EndAndExpand"
                                            Text="Modificar"
                                            BackgroundColor="LightGray"
                                            Clicked="ItemDetailButton_Clicked" />
                                        <Button 
                                            BackgroundColor="IndianRed"
                                            Text="Eliminar"
                                            TextColor="White"
                                            Clicked="ItemDeleteButton_Clicked" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Margin="10"
                    HorizontalOptions="Center"
                    Text="Mostrar más"
                    Clicked="LoadNextPageButtton_Clicked">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                            <Binding Path="HasMoreItems" />
                            <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackLayout>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>