<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:masterpages="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Master"
    xmlns:settingsdetailpages="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Detail.Settings"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.SettingsPage"
    FlyoutLayoutBehavior="Split">
    <FlyoutPage.Flyout>
        <masterpages:SettingsMasterPage />
    </FlyoutPage.Flyout>
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <settingsdetailpages:AboutDetailPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>