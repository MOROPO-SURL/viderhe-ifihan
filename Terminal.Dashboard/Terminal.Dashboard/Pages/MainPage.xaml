<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:viewmodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.View"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:viewtemplateselectors="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Views.Template.Selector"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:icplugin="clr-namespace:ImageCircle.Forms.Plugin.Abstractions;assembly=ImageCircle.Forms.Plugin"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.MainPage"
    x:TypeArguments="pagemodels:MainPageModel"
    Title="Inicio">
    <ContentPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="SimpleActionDataTemplate">
                <x:Arguments>
                    <Type TypeName="viewmodels:ActionViewModel" />
                </x:Arguments>
                <Frame
                    Margin="5" Padding="0"
                    BackgroundColor="White"
                    IsEnabled="{Binding Path=Enabled}"
                    HasShadow="False"
                    CornerRadius="0"
                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                    HeightRequest="136">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ActionFrame_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid Padding="20">
                        <StackLayout VerticalOptions="Center">
                            <Label
                                Text="{Binding Path=IconGlyph}"
                                TextColor="{Binding Path=Enabled, Converter={StaticResource ActionEnabledToColorStringConverter}, Mode=OneTime}"
                                HorizontalTextAlignment="Center"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="48" />
                            <Label 
                                Text="{Binding Path=Caption}"
                                TextColor="{Binding Path=Enabled, Converter={StaticResource ActionEnabledToColorStringConverter}, Mode=OneTime}"                                        
                                HorizontalTextAlignment="Center"
                                FontSize="Medium" />
                        </StackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
            <DataTemplate x:Key="SessionActionDataTemplate">
                <x:Arguments>
                    <Type TypeName="viewmodels:SessionActionViewModel" />
                </x:Arguments>
                <Frame
                    Margin="5" Padding="0"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    HasShadow="False"
                    CornerRadius="0"
                    WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                    HeightRequest="136">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ActionFrame_Tapped" />
                    </Frame.GestureRecognizers>
                    <Grid Padding="20" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <icplugin:CircleImage
                            Grid.Column="0"
                            VerticalOptions="Center"
                            HeightRequest="96" WidthRequest="96"
                            Source="{Binding Path=Moderator.ImageSource}"
                            BorderThickness="2"
                            BorderColor="White" />
                        <StackLayout 
                            Grid.Column="1" 
                            VerticalOptions="Center">
                            <Label
                                Text="{Binding Path=Moderator.Model.User.Id}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label 
                                Text="{Binding Path=Moderator.FullName}" 
                                TextColor="WhiteSmoke"
                                FontSize="16" />
                        </StackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
            <viewtemplateselectors:ActionDataTemplateSelector x:Key="ActionDataTemplateSelector" SimpleActionDataTemplate="{StaticResource SimpleActionDataTemplate}" SessionActionDataTemplate="{StaticResource SessionActionDataTemplate}" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="272" ChildAbsoluteHorizontalMargin="10" />
            <sscxftoolkitpresentationconverters:BoolToStringConverter x:Key="ActionEnabledToColorStringConverter" TrueString="{StaticResource PrimaryColor}" FalseString="DimGray" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Salir"
            Activated="SignOutToolbarItem_Activated"
            Order="Primary">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource IconFontFamily}" Glyph="&#xf5fd;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <Grid BackgroundColor="LightGray">
        <supportpresentationdashboardviews:BackgroundView />
        <ScrollView Orientation="Vertical">
            <FlexLayout
                Margin="5"
                Wrap="Wrap"
                AlignItems="Start" AlignContent="Start"
                BindableLayout.ItemsSource="{Binding Path=Actions}"
                BindableLayout.ItemTemplateSelector="{StaticResource ActionDataTemplateSelector}">
            </FlexLayout>
        </ScrollView>
        <supportpresentationdashboardviews:BusyView />
    </Grid>
</sscxftoolkitmvvmpages:BindingContextedContentPage>