<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Detail.Settings.AboutDetailPage"
    Title="Ajustes">
    <ContentPage.Content>
        <Grid>
            <ScrollView
                HorizontalOptions="Center"
                Orientation="Vertical">
                <Grid>
                    <StackLayout 
                        HorizontalOptions="Center" VerticalOptions="Center"
                        WidthRequest="320"
                        Spacing="20">
                        <Label
                            HorizontalOptions="Center"
                            Text="&#xf66a;"
                            TextColor="{StaticResource PrimaryColor}"
                            FontSize="96"
                            FontFamily="{StaticResource IconFontFamily}" />
                        <Label 
                            HorizontalTextAlignment="Center"
                            FontSize="20">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text="En esta sección podrá realizar ajustes a " />
                                        <Span Text="Viderhe Control" FontAttributes="Bold" FontSize="18" />
                                        <Span Text=" para adaptar su funcionamiento a sus necesidades." />
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label
                            HorizontalTextAlignment="Center"
                            FontSize="20">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="También podrá encontrar información de la aplicación, la plataforma " />
                                    <Span Text="Viderhe" FontAttributes="Bold" FontSize="18" />
                                    <Span Text=" y sus creadores." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label 
                            Margin="0,20,0,0"
                            HorizontalTextAlignment="Center"
                            Text=" * Los cambios realizados en el comportamiento de la aplicación serán relativos al usuario autenticado para este dispositivo sin prejuicio de la configuración de otros usuarios."
                            TextColor="Orange"
                            FontSize="16" />
                    </StackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</ContentPage>