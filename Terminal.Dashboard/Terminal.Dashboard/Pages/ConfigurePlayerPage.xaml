<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Models.Page"
    xmlns:converters="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Converters"
    xmlns:validators="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Validators"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.ConfigurePlayerPage"
    x:TypeArguments="pagemodels:ConfigurePlayerPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <converters:OverlayDescriptorToStringConverter x:Key="OverlayDescriptorToStringConverter" />            
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Activated="ApplyToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Activated="CancelToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem
            x:Name="ProgramRelaunchToolbarItem"
            Text="Relanzamientos Programados"
            Order="Secondary"
            Clicked="ProgramRelaunchToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xF2DA;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label x:Name="IdLabel" Text="Identificador" Style="{StaticResource FormLabel}" />
                            <Entry x:Name="IdEntry" Text="{Binding Path=Id}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference IdLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                            <supportpresentationdashboardvalidators:FormatFormFieldValidator Format="^[0-9A-Z]{7}$" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label x:Name="NameLabel" Text="Nombre" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference NameLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Guion" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Picker
                                    x:Name="ScreenplayPicker"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Path=Screenplays}"
                                    ItemDisplayBinding="{Binding Path=Title}"
                                    SelectedIndexChanged="ScreenplayPicker_SelectedIndexChanged" />
                                <Button 
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xF413;"
                                    Clicked="SelectedScreenplayClearButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="OverlayLabel"
                                Text="Carátula" 
                                Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Picker
                                    x:Name="OverlayPicker"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Path=AvailableOverlays}"
                                    ItemDisplayBinding="{Binding Converter={x:StaticResource OverlayDescriptorToStringConverter}}"
                                    SelectedIndexChanged="OverlayPicker_SelectedIndexChanged">
                                    <Picker.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultPickerValidationPresenter.Instance}"
                                            TargetProperty="{Static Picker.SelectedItemProperty}"
                                            Label="{Reference OverlayLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <validators:OverlayFormFieldValidator ConfigurationPage="{Reference FormPage}" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </Picker.Behaviors>
                                </Picker>
                                <Button 
                                    IsEnabled="{Binding Overlay, Converter={StaticResource NotNullToBooleanConverter}}"
                                    FontFamily="{StaticResource IconFontFamily}"
                                    Text="&#xf493;"
                                    Clicked="OverlayConfigureButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="5" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="Descripción" Style="{StaticResource FormLabel}" />
                            <Editor HeightRequest="180" Text="{Binding Path=About}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>