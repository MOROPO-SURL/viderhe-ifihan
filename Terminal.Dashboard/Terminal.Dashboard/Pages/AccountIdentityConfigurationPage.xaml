<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Terminal.Dashboard.Models.Page"
    xmlns:validators="clr-namespace:MOROPO.VIDERHE.Terminal.Dashboard.Validators"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Validators;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Behaviors;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Presenters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.VIDERHE.Terminal.Dashboard.Pages.AccountIdentityConfigurationPage"
    x:TypeArguments="pagemodels:AccountIdentityConfigurationPageModel"
    x:Name="FormPage"
    Title="Configuración de Cuenta">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />

            <Style TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Activated">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="6" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame Grid.ColumnSpan="6" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="NameLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference NameLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="PrimaryColorLabel"
                                Text="Color Primario" 
                                Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Grid
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="DimGray"
                                    Padding="1"
                                    HeightRequest="32">
                                    <BoxView Color="{Binding Path=PrimaryColor}" />
                                </Grid>
                                <Button 
                                    HorizontalOptions="End"
                                    Style="{StaticResource TextIconButton}"
                                    Text="&#xF266;"
                                    Clicked="PickPrimaryColorButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="SecoundaryColorLabel"
                                Text="Color Secundario" 
                                Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Grid
                                    HorizontalOptions="FillAndExpand"
                                    BackgroundColor="DimGray"
                                    Padding="1"
                                    HeightRequest="32">
                                    <BoxView Color="{Binding Path=SecoundaryColor}" />
                                </Grid>
                                <Button 
                                    HorizontalOptions="End"
                                    Style="{StaticResource TextIconButton}"
                                    Text="&#xF266;"
                                    Clicked="PickSecoundaryColorButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="OverlayLabel"
                                Text="Carátula" 
                                Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Picker
                                    x:Name="OverlayPicker"
                                    HorizontalOptions="FillAndExpand"
                                    ItemsSource="{Binding Path=AvailableOverlays}"
                                    ItemDisplayBinding="{Binding Path=Name}"
                                    SelectedIndexChanged="OverlayPicker_SelectedIndexChanged">
                                    <Picker.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultPickerValidationPresenter.Instance}"
                                            TargetProperty="{Static Picker.SelectedItemProperty}"
                                            Label="{Reference OverlayLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <validators:OverlayFormFieldValidator ConfigurationPage="{Reference FormPage}" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </Picker.Behaviors>
                                </Picker>
                                <Button 
                                    IsEnabled="{Binding Source={x:Reference OverlayPicker}, Path=SelectedItem, Converter={StaticResource NotNullToBooleanConverter}}"
                                    Style="{StaticResource TextIconButton}"
                                    Text="&#xf493;"
                                    Clicked="OverlayConfigureButton_Clicked" />
                                <Button 
                                    IsEnabled="{Binding Source={x:Reference OverlayPicker}, Path=SelectedItem, Converter={StaticResource NotNullToBooleanConverter}}"
                                    Style="{StaticResource TextIconButton}"
                                    Text="&#xF413;"
                                    Clicked="SelectedOverlayClearButton_Clicked" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="0" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Logotipo" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView Color="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickLogoImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                                    Source="{Binding Path=LogoImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Portada Vertical" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView Color="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickVerticalSplashImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=0.5625}"
                                    Source="{Binding Path=VerticalSplashImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Style="{StaticResource FormFieldFrame}"
                        Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="3"
                        Padding="0"
                        VerticalOptions="Start">
                        <StackLayout 
                            VerticalOptions="FillAndExpand"
                            Spacing="0">
                            <Label 
                                Margin="10,10,10,6"
                                Text="Portada Horizontal" 
                                Style="{StaticResource FormLabel}" />
                            <BoxView Color="#666666" HeightRequest="1" />
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="PickHorizontalSplashImageButton_Clicked" />
                                </Grid.GestureRecognizers>
                                <ffimageloadingforms:CachedImage 
                                    BackgroundColor="White"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                    Source="{Binding Path=HorizontalSplashImageSource}"
                                    Aspect="AspectFill"
                                    CacheType="Disk"
                                    CacheDuration="8760:00:00" />
                                <StackLayout 
                                    HorizontalOptions="Center" VerticalOptions="End"
                                    Padding="4"
                                    BackgroundColor="#99000000"
                                    Orientation="Horizontal">
                                    <Label
                                        Text="&#xf740;"
                                        TextColor="White"
                                        FontFamily="{StaticResource IconFontFamily}"
                                        FontSize="Medium" />
                                    <Label
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Text="para modificar"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>