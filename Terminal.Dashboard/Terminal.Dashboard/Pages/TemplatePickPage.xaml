<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MOROPO.VIDERHE.Terminal.Dashboard.Converters"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Terminal.Dashboard.Pages.TemplatePickPage"
    Title="Seleccionar Plantilla">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TemplateViewModelToTemplateThumbnailWrapViewConverter x:Key="TemplateViewModelToTemplateThumbnailWrapViewConverter" />
            <converters:IsAnyPlayerOrientationSupportKindToBooleanConverter x:Key="IsAnyPlayerOrientationSupportKindToBooleanConverter" />

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="272" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView Orientation="Vertical">
                <FlexLayout
                    Margin="5"
                    Wrap="Wrap"
                    AlignItems="Start" AlignContent="Start"
                    BindableLayout.ItemsSource="{Binding .}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                Margin="5"
                                WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}"
                                RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width}">
                                    <BoxView Color="White" Opacity="0.2" />
                                    <Label
                                        IsVisible="{Binding Path=PlayerOrientationSupport, Converter={StaticResource IsAnyPlayerOrientationSupportKindToBooleanConverter}}"
                                        HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="8"
                                        Text="&#xf884;"
                                        TextColor="Black"
                                        FontFamily="Material Design Icons"
                                        FontSize="28" />
                                    <ContentView Content="{Binding Converter={StaticResource TemplateViewModelToTemplateThumbnailWrapViewConverter}}" />
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    BackgroundColor="White"
                                    HeightRequest="148"
                                    RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label 
                                        Grid.Row="0"
                                        Text="{Binding Path=Name}"
                                        FontAttributes="Bold"
                                        Padding="8,8,8,4"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2" />
                                    <Label 
                                        Grid.Row="1"
                                        Padding="8,0,8,8"
                                        Text="{Binding Path=About}"
                                        TextColor="DimGray"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="4" />
                                    <Button 
                                        Grid.Row="2"
                                        Style="{StaticResource WhiteTextColorButton}"
                                        BackgroundColor="{StaticResource AccentColor}"
                                        Text="Seleccionar"
                                        Clicked="TemplateOverviewSelectButton_Clicked" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>