<?xml version="1.0" encoding="utf-8" ?>
<popup:PopupPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:popup="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Popup.CreateScheduledRelaunchPopuoPage">
    <ContentPage.Content>
        <Grid>
            <Frame
                HorizontalOptions="Center" VerticalOptions="Center"
                Padding="10" Margin="20"
                BackgroundColor="White"
                WidthRequest="360">
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label 
                        Grid.ColumnSpan="2" Grid.Row="0"
                        Style="{StaticResource FormLabel}"
                        Text="Hora" />
                    <TimePicker 
                        x:Name="TimePicker"
                        Grid.ColumnSpan="2" Grid.Row="1"
                        Format="HH:mm" />
                    <Button
                        Grid.Column="0" Grid.Row="2"
                        Text="Aplicar"
                        Clicked="ApplyButton_Clicked" />
                    <Button
                        Grid.Column="1" Grid.Row="2"
                        Text="Cancelar"
                        Clicked="CancelButton_Clicked" />
                </Grid>
            </Frame>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</popup:PopupPage>