<?xml version="1.0" encoding="utf-8" ?>
<popup:PopupPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:popup="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Popup.FilterPlayerPopupPage">
    <ContentPage.Content>
        <Frame
            HorizontalOptions="Center" VerticalOptions="Center"
            Padding="10" Margin="20"
            BackgroundColor="White"
            WidthRequest="480">
            <StackLayout>
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        Text="Filtrar Reproductores"
                        FontSize="21" />
                    <Button 
                        Grid.Column="1"
                        HorizontalOptions="End" VerticalOptions="Start"
                        Padding="6"
                        BackgroundColor="White"
                        Text="&#xf5ad;"
                        Style="{StaticResource OptionsTextIconButton}"
                        FontSize="Medium"
                        Clicked="CloseButton_Clicked" />
                </Grid>
                <StackLayout Margin="6">
                    <Label
                        Style="{StaticResource FormLabel}"
                        Text="Nombre" />
                    <Entry Text="{Binding Path=Name}" />
                </StackLayout>
                <Grid>
                    <StackLayout Margin="6,0">
                        <Label
                            Text="Etiquetas" 
                            Style="{StaticResource FormLabel}" />
                        <BoxView
                            HeightRequest="2"
                            Color="DimGray" />
                        <FlexLayout
                            IsClippedToBounds="True"
                            Wrap="Wrap"
                            Direction="Column"
                            AlignItems="Center"
                            AlignContent="Start"
                            BindableLayout.ItemsSource="{Binding Path=Tags}">
                            <BindableLayout.EmptyView>
                                <Label Margin="6" Text="Sin elementos que mostrar" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        BackgroundColor="{StaticResource AccentColor}"
                                        Margin="6" Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            Margin="4,0,0,0"
                                            VerticalOptions="Center"
                                            Text="{Binding Path=Name}"
                                            TextColor="White" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource TextIconButton}"
                                            VerticalOptions="Center"
                                            Text="&#xFA78;"
                                            TextColor="White"
                                            Clicked="RemoveTagButton_Clicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </StackLayout>
                    <Button
                        HorizontalOptions="End" VerticalOptions="Start"
                        Text="Agregar"
                        Clicked="AddTagButton_Clicked" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Text="Filtrar"
                        Clicked="ApplyButton_Clicked" />
                    <Button
                        Grid.Column="1"
                        Text="Cancelar"
                        Clicked="CloseButton_Clicked" />
                </Grid>
            </StackLayout>
        </Frame>
    </ContentPage.Content>
</popup:PopupPage>