<?xml version="1.0" encoding="utf-8" ?>
<popup:PopupPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:popup="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Dashboard.Pages.Popup.TagPickPopupPage">
    <ContentPage.Content>
        <Frame
            HorizontalOptions="Center" VerticalOptions="Center"
            Padding="10" Margin="20"
            BackgroundColor="White"
            WidthRequest="400">
            <Grid>
                <StackLayout Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            Text="Seleccionar o Agregar Etiqueta"
                            FontSize="21" />
                        <Button 
                            Grid.Column="1"
                            HorizontalOptions="End" VerticalOptions="Start"
                            Padding="6"
                            BackgroundColor="White"
                            Text="&#xf5ad;"
                            Style="{StaticResource OptionsTextIconButton}"
                            FontSize="Medium"
                            Clicked="CloseButton_Clicked" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.ColumnSpan="2" Grid.Row="0"
                            Style="{StaticResource FormLabel}"
                            Text="Disponibles" />
                        <Picker
                            x:Name="TagPicker"
                            Grid.Column="0" Grid.Row="1"
                            ItemsSource="{Binding Path=Items}"
                            ItemDisplayBinding="{Binding Path=Name}" />
                        <Button
                            Grid.Column="1" Grid.Row="1"
                            Text="Nueva"
                            Clicked="AddNewButton_Clicked" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Text="Agregar"
                            Clicked="ApplyButton_Clicked" />
                        <Button
                            Grid.Column="1"
                            Text="Cancelar"
                            Clicked="CloseButton_Clicked" />
                    </Grid>
                </StackLayout>
                <supportpresentationdashboardviews:BusyView />
            </Grid>
        </Frame>
    </ContentPage.Content>
</popup:PopupPage>