<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Terminal.Dashboard.Models.Page"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="MOROPO.VIDERHE.Terminal.Dashboard.Pages.UserAuthenticationPage"
    x:TypeArguments="pagemodels:UserAuthenticationPageModel"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <StackLayout 
                HorizontalOptions="Center" VerticalOptions="End"
                Margin="16"
                WidthRequest="180"
                Spacing="8">
                <Label Text="por" FontAttributes="Italic" />
                <ffimageloadingsvg:SvgCachedImage
                    Aspect="AspectFit"
                    Source="resource://MOROPO.VIDERHE.Terminal.Dashboard.Assets.Images.moropo-logo-dark.svg" />
                <Label 
                    HorizontalTextAlignment="Center"
                    x:Name="CopyRightLabel" />
            </StackLayout>
            <ScrollView
                HorizontalOptions="Center"
                Orientation="Vertical">
                <Grid>
                    <Grid 
                        HorizontalOptions="Center" VerticalOptions="Center"
                        WidthRequest="280"
                        BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ffimageloadingsvg:SvgCachedImage
                            Grid.ColumnSpan="2" Grid.Row="0"
                            Margin="24,0,24,16"
                            Source="resource://MOROPO.VIDERHE.Terminal.Dashboard.Assets.Images.viderhe-identity-main.svg"
                            Aspect="AspectFit" />
                        <Picker
                            Grid.Column="0" Grid.Row="1"
                            ItemsSource="{Binding Path=AvailableProtocols}"
                            SelectedIndex="{Binding Path=TargetCloudProtocolIndex, FallbackValue=0, TargetNullValue=0}" />
                        <Entry
                            Grid.Column="1" Grid.Row="1"
                            Text="{Binding Path=TargetCloudHostName}"
                            Placeholder="servidor cloud" />
                        <Entry
                            Grid.ColumnSpan="2" Grid.Row="2"
                            Text="{Binding Path=UserName}"
                            Placeholder="usuario" />
                        <Entry
                            Grid.ColumnSpan="2" Grid.Row="3"
                            Text="{Binding Path=Password}"
                            Placeholder="contraseña"
                            IsPassword="true" />
                        <Button
                            Grid.ColumnSpan="2" Grid.Row="4"
                            IsEnabled="{Binding Path=IsBusy, Converter={StaticResource BoolToBoolNegationConverter}}"
                            HorizontalOptions="FillAndExpand"
                            Margin="24,16"
                            BackgroundColor="Accent"
                            Text="Iniciar"
                            TextColor="White"
                            Clicked="SignButton_Clicked" />
                    </Grid>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>       
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>