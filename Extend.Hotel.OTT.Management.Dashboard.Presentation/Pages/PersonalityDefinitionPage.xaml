<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.HotelOTT.Management.Dashboard.Presentation.Models.Page"
    xmlns:providers="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.HotelOTT.Management.Dashboard.Presentation.Providers"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.HotelOTT.Management.Dashboard.Presentation.Pages.PersonalityDefinitionPage"
    x:TypeArguments="pagemodels:PersonalityDefinitionPageModel"
    x:Name="FormPage"
    Title="Agregar Personalidad">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView Orientation="Vertical">
                <Grid
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame 
                        Grid.Column="0" Grid.Row="1" Grid.RowSpan="4"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0"
                        VerticalOptions="Start">
                        <Grid 
                            VerticalOptions="FillAndExpand"
                            ColumnSpacing="0" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Margin="10,10,10,6"
                                Text="Imagen" 
                                Style="{StaticResource FormLabel}" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                VerticalOptions="Start"
                                Style="{StaticResource TextIconButton}"
                                Text="&#xF90E;"
                                FontSize="Medium"
                                Clicked="PickImageButton_Clicked" />
                            <BoxView
                                Grid.ColumnSpan="2" Grid.Row="1"
                                BackgroundColor="#666666" 
                                HeightRequest="1" />
                            <ffimageloadingforms:CachedImage 
                                Grid.ColumnSpan="2" Grid.Row="2"
                                BackgroundColor="Black"
                                HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                                Source="{Binding Path=ImageSource}"
                                Aspect="AspectFill"
                                CacheType="Disk"
                                CacheDuration="8760:00:00" />
                        </Grid>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="NameLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Name}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference NameLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                            <supportpresentationdashboardvalidators:MinLengthFormFieldValidator MinLength="3" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Grid.Row="1" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                Text="Apellidos" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=LastName}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Grid.Row="2" Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                Text="Alias" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Alias}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="2" 
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Sexo" Style="{StaticResource FormLabel}" />
                            <Picker 
                                ItemsSource="{Static providers:ConstantProvider.SEXS}"
                                SelectedItem="{Binding Path=Sex}" />
                        </StackLayout>
                    </Frame>
                    <Frame
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                        HorizontalOptions="Start"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="3" Grid.Row="0"
                                Text="Fecha de Nacimiento" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=HasBornDate}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding Path=HasBornDate}"
                                Date="{Binding Path=BornDate}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="Descripción" Style="{StaticResource FormLabel}" />
                            <Editor HeightRequest="180" Text="{Binding Path=Description}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>