<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:supportpresentationdashboardpageconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Models.Page;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Pages.PrePickVideoPage"
    x:TypeArguments="supportpresentationdashboardpagemodels:VideoPickPageModel"
    Title="Seleccionar Video">
    <ContentPage.Resources>
        <ResourceDictionary>
            <supportpresentationdashboardpageconverters:AllTrueMultiConverter x:Key="AllTrueMultiConverter" />
            <supportpresentationdashboardpageconverters:CollectionViewWidthToSelfVerticalGridItemsLayoutConverter x:Key="CollectionViewWidthToSelfVerticalGridItemsLayoutConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="10" />

            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:NotNullOrEmptyStringToBooleanConverter x:Key="NotNullOrEmptyStringToBooleanConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <StackLayout Spacing="0" SizeChanged="VideoCollectionWrapperStackLayout_SizeChanged">
                <CollectionView
                    x:Name="VideoCollectionView"
                    SelectionMode="None"
                    ItemsLayout="{Binding Source={x:Reference VideoCollectionView}, Path=Width, Converter={StaticResource CollectionViewWidthToSelfVerticalGridItemsLayoutConverter}}"
                    ItemsSource="{Binding Path=Items}"
                    Scrolled="VideoCollectionView_Scrolled">
                    <CollectionView.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Default="5,5,5,0">
                            <On Platform="Android" Value="10,10,10,0" />
                        </OnPlatform>
                    </CollectionView.Margin>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                Margin="5" Padding="0"
                                BackgroundColor="White"
                                HasShadow="False"
                                CornerRadius="0">
                                <Grid RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ffimageloadingforms:CachedImage 
                                        Grid.Row="0" Grid.Column="0"
                                        BackgroundColor="White"
                                        Source="{Binding Path=Presented, Converter={StaticResource VideoViewModelToThumbnailImageSourceConverter}}"
                                        CacheType="Disk"
                                        CacheDuration="8760:00:00"
                                        Aspect="AspectFill"
                                        HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}" />
                                    <StackLayout 
                                        Grid.Row="0" Grid.Column="0"
                                        IsVisible="{Binding Path=Presented.About, Converter={StaticResource NotNullOrEmptyStringToBooleanConverter}}"
                                        VerticalOptions="End" 
                                        Padding="8"
                                        BackgroundColor="#99000000">
                                        <Label 
                                            Text="{Binding Path=Presented.About}"
                                            TextColor="White"
                                            LineBreakMode="TailTruncation" />
                                    </StackLayout>
                                    <StackLayout
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Padding="6" Spacing="3">
                                        <Label 
                                            VerticalOptions="Center"
                                            BackgroundColor="Black"
                                            Padding="4,2" Margin="4,0"
                                            Text="{Binding Path=Presented.Extension}" 
                                            TextColor="White"
                                            FontAttributes="Bold" />
                                        <Label 
                                            HorizontalOptions="StartAndExpand" VerticalOptions="Center"
                                            Text="{Binding Path=Presented.FrameSize}" />
                                        <Button 
                                            Text="Detalles"
                                            BackgroundColor="LightGray"
                                            Clicked="VideoOverviewDetailButton_Clicked" />
                                        <Button 
                                            BackgroundColor="Accent"
                                            Text="Seleccionar"
                                            TextColor="White"
                                            Clicked="VideoOverviewPickButton_Clicked" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button
                    Margin="10"
                    HorizontalOptions="Center"
                    Text="Mostrar más"
                    Clicked="LoadNextPageButtton_Clicked">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource AllTrueMultiConverter}">
                            <Binding Path="HasMoreItems" />
                            <Binding Path="IsBusy" Converter="{StaticResource BoolToBoolNegationConverter}" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackLayout>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>