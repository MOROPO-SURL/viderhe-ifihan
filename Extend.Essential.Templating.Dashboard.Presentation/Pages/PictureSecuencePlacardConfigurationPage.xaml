<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Models.Page"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Pages.PictureSecuencePlacardConfigurationPage"
    x:TypeArguments="pagemodels:PictureSecuencePlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="FormGroup" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#FAFAFA" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="320" ChildAbsoluteHorizontalMargin="20" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid 
                Margin="15"
                ColumnSpacing="15" RowSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Frame
                    Grid.ColumnSpan="2" Grid.Row="0"
                    Style="{StaticResource FormGroup}">
                    <StackLayout>
                        <Label Text="Etiqueta" Style="{StaticResource FormLabel}" />
                        <Entry Text="{Binding Path=Label}" />
                    </StackLayout>
                </Frame>
                <Frame
                    Grid.Column="0" Grid.Row="1"
                    Style="{StaticResource FormGroup}"
                    Padding="0">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label 
                            Grid.Column="0" Grid.Row="0"
                            Style="{StaticResource FormLabel}"
                            Margin="20,20,20,10"
                            Text="Imágenes" />
                        <Button
                            Grid.Column="1" Grid.Row="0"
                            Margin="20,20,20,10"
                            Text="Agregar"
                            Clicked="IncludeImagesButton_Clicked" />
                        <FlexLayout
                            Grid.ColumnSpan="2" Grid.Row="1"
                            Margin="10"
                            BindableLayout.ItemsSource="{Binding Path=Images}">
                            <BindableLayout.EmptyView>
                                <Label
                                    Margin="10"
                                    Text="Sin elementos que mostrar"
                                    TextColor="DimGray" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Margin="10"
                                        Padding="0"
                                        BackgroundColor="Black"
                                        WidthRequest="{Binding Source={x:RelativeSource AncestorType={x:Type FlexLayout}}, Path=Width, Converter={StaticResource BindingLayoutWidthToResponsiveChildWidthConverter}}">
                                        <Grid>
                                            <Image 
                                                Aspect="AspectFill" 
                                                Source="{Binding Converter={StaticResource ImageViewModelToThumbnailImageSourceConverter}}"
                                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}" />
                                            <ImageButton
                                                VerticalOptions="Start" HorizontalOptions="End"
                                                Margin="4"
                                                WidthRequest="24"
                                                HeightRequest="24"
                                                BackgroundColor="#99000000"
                                                BorderWidth="0"
                                                CornerRadius="12"
                                                Clicked="ImageDeleteButton_Clicked">
                                                <ImageButton.Padding>
                                                    <OnPlatform x:TypeArguments="Thickness">
                                                        <On Platform="UWP" Value="1,0,0,0" />
                                                    </OnPlatform>
                                                </ImageButton.Padding>
                                                <ImageButton.Source>
                                                    <FontImageSource 
                                                        Color="White"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        Glyph="&#xF156;" />
                                                </ImageButton.Source>
                                            </ImageButton>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Grid>
                </Frame>
                <Frame
                    Grid.Column="1" Grid.Row="1"
                    VerticalOptions="Start"
                    Style="{StaticResource FormGroup}">
                    <StackLayout>
                        <Label Text="Tiempo en Pantalla (c/u)" Style="{StaticResource FormLabel}" />
                        <StackLayout Orientation="Horizontal">
                            <Label 
                            Text="{Binding Path=PicturePresentationSecounds}"
                            VerticalTextAlignment="Center" />
                            <Label 
                            Text="Segundos" 
                            HorizontalOptions="StartAndExpand" 
                            VerticalTextAlignment="Center" />
                            <Stepper Value="{Binding Path=PicturePresentationSecounds}" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </Grid>
            <sscxftoolkitpresentationviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>