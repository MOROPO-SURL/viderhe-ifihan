<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Models.Page"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Views;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Pages.PhotoEventPlacardConfigurationPage"
    x:TypeArguments="pagemodels:PhotoEventPlacardConfigurationPageModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#FAFAFA" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <ScrollView>
                <Grid 
                    Margin="15"
                    ColumnSpacing="15" RowSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Frame Grid.ColumnSpan="6" Grid.Row="0">
                        <StackLayout>
                            <Label Text="Título" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Title}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Cuándo?" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=When}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="1">
                        <StackLayout>
                            <Label Text="Dóndo?" Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Where}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.ColumnSpan="6" Grid.Row="2">
                        <StackLayout>
                            <Label Text="Resumen" Style="{StaticResource FormLabel}" />
                            <Editor VerticalOptions="FillAndExpand" Text="{Binding Path=About}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="3" Grid.RowSpan="5"
                        VerticalOptions="Start">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.Column="0" Grid.Row="0"
                                Text="Imagen" 
                                Style="{StaticResource FormLabel}" />
                            <Button
                                Grid.Column="1" Grid.Row="0"
                                Text="Seleccionar"
                                Clicked="PickImageButton_Clicked" />
                            <Image 
                                Grid.ColumnSpan="2" Grid.Row="1"
                                HeightRequest="{Binding Source={x:RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FractionConverter}, ConverterParameter=1.777777777777778}"
                                BackgroundColor="Black"
                                Source="{Binding Path=Image, Converter={StaticResource ImageViewModelToImageSourceConverter}}"
                                Aspect="{Binding Path=Aspect}" />
                        </Grid>
                    </Frame>
                    <Frame Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="3">
                        <StackLayout>
                            <Label Text="Relación de Aspecto" Style="{StaticResource FormLabel}" />
                            <Picker ItemsSource="{Binding Path=Aspects}" SelectedItem="{Binding Path=Aspect}" />
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="4">
                        <StackLayout>
                            <Label Text="Tiempo en Pantalla" Style="{StaticResource FormLabel}" />
                            <StackLayout Orientation="Horizontal">
                                <Label Text="{Binding Path=ScreenPresentationTimeSecounds}" VerticalTextAlignment="Center" />
                                <Label Text="Segundos" HorizontalOptions="StartAndExpand" VerticalTextAlignment="Center" />
                                <Stepper Value="{Binding Path=ScreenPresentationTimeSecounds}" />
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                    <Frame Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="5">
                        <StackLayout>
                            <Label Text="Usar Efecto Zooming?" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=IsImageZoomingEnabled}" />
                        </StackLayout>
                    </Frame>
                </Grid>
            </ScrollView>
            <sscxftoolkitpresentationviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>