<?xml version="1.0" encoding="UTF-8"?>
<xftoolkitmvvmviews:ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xftoolkitmvvmviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Views;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Views.PictureSecuencePlacardThumbnailView">
    <ContentView.Content>
        <Grid 
            x:Name="Wrapper"
            ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Image 
                Grid.ColumnSpan="2" Grid.RowSpan="2"
                Source="{Binding Path=Template.ThumbnailImageSource}" />
        </Grid>
    </ContentView.Content>
</xftoolkitmvvmviews:ContentView>