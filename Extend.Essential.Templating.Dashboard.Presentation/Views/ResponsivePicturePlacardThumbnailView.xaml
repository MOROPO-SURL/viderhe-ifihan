<?xml version="1.0" encoding="UTF-8"?>
<xftoolkitmvvmviews:ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xftoolkitmvvmviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Views;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.Essential.Templating.Dashboard.Presentation.Views.ResponsivePicturePlacardThumbnailView">
    <ContentView.Content>
        <Grid x:Name="Wrapper">
            <ffimageloadingforms:CachedImage
                x:Name="Image"
                CacheType="Disk"
                CacheDuration="8760:00:00" />            
            <Image Source="{Binding Path=Template.ThumbnailImageSource}" />
        </Grid>
    </ContentView.Content>
</xftoolkitmvvmviews:ContentView>