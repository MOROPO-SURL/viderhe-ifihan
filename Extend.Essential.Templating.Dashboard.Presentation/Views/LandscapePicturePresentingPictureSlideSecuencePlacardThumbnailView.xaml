<?xml version="1.0" encoding="UTF-8"?>
<xftoolkitmvvmviews:ContentView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:xftoolkitmvvmviews="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Views;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.Essential.Templating.Dashboard.Presentation.Views.LandscapePicturePresentingPictureSlideSecuencePlacardThumbnailView">
    <ContentView.Content>
        <Grid>
            <Grid 
                x:Name="Wrapper"
                ColumnSpacing="0" RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
            </Grid>
            <BoxView Color="#99000000" />
            <ffimageloadingforms:CachedImage
                x:Name="PresenterImage"
                CacheType="Disk"
                CacheDuration="8760:00:00" />
        </Grid>
    </ContentView.Content>
</xftoolkitmvvmviews:ContentView>