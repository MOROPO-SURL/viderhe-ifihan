<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Extend.Hotel.OTT.Overlaying.Presentation.Views.AuroraOTTHotelTVOverlayView">
    <ContentView.Resources>
        <ResourceDictionary>
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <extendcommontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" />

            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />

            <Thickness x:Key="ActionMargin">10</Thickness>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="ActionLayoutStyle" TargetType="StackLayout">
                <Setter Property="BackgroundColor" Value="#DF4B0082" />
            </Style>
            <Style x:Key="ActionIconLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="{Binding Source=80, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="2"
                Margin="10"
                ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackLayout
                    Grid.Column="0" Grid.Row="0"
                    Spacing="0">
                    <ImageButton 
                        BackgroundColor="#DF4B0082"
                        Padding="10"
                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FactorConverter}, ConverterParameter=0.75}">
                        <ImageButton.Source>
                            <FontImageSource
                                Color="White"
                                Glyph="&#xF1C8;"
                                FontFamily="{StaticResource IconFontFamily}" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label
                        BackgroundColor="#DF4B0082"
                        Padding="10,0,10,10"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Text="Diamond Channel"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="21" />
                </StackLayout>
                <StackLayout
                    Grid.Column="1" Grid.Row="0"
                    Spacing="0">
                    <ImageButton 
                        BackgroundColor="#DF4B0082"
                        Padding="10"
                        HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width, Converter={StaticResource FactorConverter}, ConverterParameter=0.75}">
                        <ImageButton.Source>
                            <FontImageSource
                                Color="White"
                                Glyph="&#xF7F3;"
                                FontFamily="{StaticResource IconFontFamily}" />
                        </ImageButton.Source>
                    </ImageButton>
                    <Label
                        BackgroundColor="#DF4B0082"
                        Padding="10,0,10,10"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Text="TV Channels"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="21" />
                </StackLayout>
            </Grid>
            <Grid
                Grid.Row="0"
                BackgroundColor="#7F4B0082"
                HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Height, Converter={StaticResource FactorConverter}, ConverterParameter=0.10}">
            </Grid>
            <StackLayout
                Grid.Row="1"
                VerticalOptions="Center"
                Padding="20">
                <Label Text="Wellcome, Mr. Javier Moncada" FontSize="32" FontAttributes="Bold" />
                <Label FontSize="18" Text="No lorem justo enim dolores elitr dolore ipsum et in tincidunt sea dignissim minim nisl dolore ipsum odio at duo" />
            </StackLayout>
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>