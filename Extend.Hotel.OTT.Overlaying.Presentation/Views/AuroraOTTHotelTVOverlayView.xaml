<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="MOROPO.VIDERHE.Extend.Hotel.OTT.Overlaying.Presentation.Views.AuroraOTTHotelTVOverlayView">
    <ContentView.Resources>
        <ResourceDictionary>
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <extendcommontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" />

            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />

            <Thickness x:Key="DayOfWeekBlockAlignMargin">0,8,0,0</Thickness>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="ActionWrapperLayoutStyle" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="#DF000000" />                
            </Style>
            <Style x:Key="ActionContentLayoutStyle" TargetType="StackLayout">
                <Setter Property="Padding" Value="{Binding Source=28, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <Setter Property="Spacing" Value="0" />
            </Style>
            <Style x:Key="ActionIconLabelStyle" TargetType="Label">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="CenterAndExpand" />
                <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
                <Setter Property="FontSize" Value="{Binding Source=128, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="ActionSmallIconLabelStyle" TargetType="Label" BasedOn="{StaticResource ActionIconLabelStyle}">
                <Setter Property="FontSize" Value="{Binding Source=96, Converter={StaticResource SizeToRelativeValueConverter}}" />
            </Style>
            <Style x:Key="ActionCaptionLabelStyle" TargetType="Label">
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="OverviewButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Text" Value=" " />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#F0000000" Offset="0.1" />
                    <GradientStop Color="Transparent" Offset="0.45" />
                    <GradientStop Color="Transparent" Offset="0.70" />
                    <GradientStop Color="Black" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid
                Grid.Column="1" Grid.Row="1"
                VerticalOptions="Center"
                ColumnSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}" RowSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Column="0" Grid.Row="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    Style="{StaticResource ActionWrapperLayoutStyle}">
                    <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                        <Label 
                            Style="{StaticResource ActionIconLabelStyle}"
                            Text="&#xF1C8;" />
                        <Label
                            Style="{StaticResource ActionCaptionLabelStyle}"
                            Text="Diamond Signal" />
                    </StackLayout>
                    <Button 
                        Style="{StaticResource OverviewButton}"
                        Focused="Button_Focused"
                        Unfocused="Button_Unfocused"
                        Clicked="BrandChannelButton_Clicked" />
                </Grid>
                <Grid
                    Grid.Column="1" Grid.Row="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    RowSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid 
                        Grid.Row="0"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <BoxView Color="Transparent" VerticalOptions="FillAndExpand" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Resort Info" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />                        
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <BoxView Color="Transparent" VerticalOptions="FillAndExpand" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Hotel Services" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />                        
                    </Grid>
                </Grid>
                <Grid
                    Grid.Column="2" Grid.Row="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    Style="{StaticResource ActionWrapperLayoutStyle}">
                    <StackLayout  Style="{StaticResource ActionContentLayoutStyle}">
                        <Label 
                            Style="{StaticResource ActionIconLabelStyle}"
                            Text="&#xF502;" />
                        <Label
                            Style="{StaticResource ActionCaptionLabelStyle}"
                            Text="TV Channels" />
                    </StackLayout>
                    <Button 
                        Style="{StaticResource OverviewButton}"
                        Focused="Button_Focused"
                        Unfocused="Button_Unfocused" />
                </Grid>
                <Grid
                    Grid.Column="3" Grid.Row="0"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    Style="{StaticResource ActionWrapperLayoutStyle}">
                    <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                        <Label 
                            Style="{StaticResource ActionIconLabelStyle}"
                            Text="&#xFEEC;" />
                        <Label
                            Style="{StaticResource ActionCaptionLabelStyle}"
                            Text="Play Videos" />
                    </StackLayout>
                    <Button 
                        Style="{StaticResource OverviewButton}"
                        Focused="Button_Focused"
                        Unfocused="Button_Unfocused" />
                </Grid>
                <Grid
                    Grid.Column="0" Grid.Row="1"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    RowSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Row="0"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <BoxView Color="Transparent" VerticalOptions="FillAndExpand" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Things to Do" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <BoxView Color="Transparent" VerticalOptions="FillAndExpand" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Local Info" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                </Grid>
                <Grid
                    Grid.Column="1" Grid.Row="1"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    Style="{StaticResource ActionWrapperLayoutStyle}">
                    <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                        <Label 
                            Style="{StaticResource ActionIconLabelStyle}"
                            Text="&#xF88C;" />
                        <Label
                            Style="{StaticResource ActionCaptionLabelStyle}"
                            Text="Room Services" />
                    </StackLayout>
                    <Button 
                        Style="{StaticResource OverviewButton}"
                        Focused="Button_Focused"
                        Unfocused="Button_Unfocused" />
                </Grid>
                <Grid
                    Grid.Column="2" Grid.Row="1"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    ColumnSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}" RowSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid
                        Grid.Column="0" Grid.Row="0"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <Label 
                                Style="{StaticResource ActionSmallIconLabelStyle}"
                                Text="&#xF7AD;" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Sight Seeing" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                    <Grid
                        Grid.Column="0" Grid.Row="1"
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <Label 
                                Style="{StaticResource ActionSmallIconLabelStyle}"
                                Text="&#xF49A;" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Shopping" />
                        </StackLayout>
                        <Button
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                    <Grid
                        Grid.Column="1" Grid.Row="0" 
                        Style="{StaticResource ActionWrapperLayoutStyle}">                        
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <Label 
                                Style="{StaticResource ActionSmallIconLabelStyle}"
                                Text="&#xF596;" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="Weather" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                    <Grid
                        Grid.Column="1" Grid.Row="1" 
                        Style="{StaticResource ActionWrapperLayoutStyle}">
                        <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                            <Label 
                                Style="{StaticResource ActionSmallIconLabelStyle}"
                                Text="&#xF09E;" />
                            <Label
                                Style="{StaticResource ActionCaptionLabelStyle}"
                                Text="WakeUp Call" />
                        </StackLayout>
                        <Button 
                            Style="{StaticResource OverviewButton}"
                            Focused="Button_Focused"
                            Unfocused="Button_Unfocused" />
                    </Grid>
                </Grid>
                <Grid
                    Grid.Column="3" Grid.Row="1"
                    HeightRequest="{Binding Source={RelativeSource Mode=Self}, Path=Width}"
                    Style="{StaticResource ActionWrapperLayoutStyle}">
                    <StackLayout Style="{StaticResource ActionContentLayoutStyle}">
                        <Label 
                            Style="{StaticResource ActionIconLabelStyle}"
                            Text="&#xF4D2;" />
                        <Label
                            Style="{StaticResource ActionCaptionLabelStyle}"
                            Text="Recommendations" />
                    </StackLayout>
                    <Button 
                        Style="{StaticResource OverviewButton}"
                        Focused="Button_Focused"
                        Unfocused="Button_Unfocused" />
                </Grid>
            </Grid>
            <Grid
                Grid.ColumnSpan="3" Grid.Row="0"
                Padding="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}"
                ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ffimageloadingsvg:SvgCachedImage
                    x:Name="BrandLogoImageView"
                    Grid.Column="0"
                    Aspect="AspectFit" />
                <StackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label 
                        HorizontalTextAlignment="End"
                        Text="Welcome, Mr. Javier Moncada" 
                        FontSize="{Binding Source=28, Converter={StaticResource SizeToRelativeValueConverter}}" 
                        FontAttributes="Bold" />
                    <Label 
                        FontSize="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}" 
                        HorizontalTextAlignment="End"
                        Text="We hope you have a great day at our hotel" />
                </StackLayout>
                <BoxView Grid.Column="2" Color="White" WidthRequest="2" />
                <StackLayout 
                    Grid.Column="3" 
                    VerticalOptions="Center" 
                    Spacing="0">
                    <Label 
                        Text="Room" 
                        FontSize="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}}" 
                        FontAttributes="Bold" />
                    <Label 
                        FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}}" 
                        Text="{Binding Path=Context.RoomId}" />
                </StackLayout>
                <BoxView Grid.Column="4" Color="White" WidthRequest="2" />
                <Grid 
                    Grid.Column="5" 
                    VerticalOptions="Center" 
                    RowSpacing="0" ColumnSpacing="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label 
                        x:Name="DayOfWeekLabel"
                        Grid.Column="0" Grid.Row="0"
                        Margin="{Binding Source={StaticResource DayOfWeekBlockAlignMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}}"
                        HorizontalOptions="End"
                        Text="Monday" 
                        FontSize="{Binding Source=24, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    <Label 
                        x:Name="SimpleDateLabel"
                        Grid.Column="0" Grid.Row="1"
                        HorizontalOptions="End"
                        FontSize="{Binding Source=24, Converter={StaticResource SizeToRelativeValueConverter}}" 
                        Text="20 February 2024" />                        
                    <Label
                        x:Name="TimeLabel"
                        Grid.Column="1" Grid.RowSpan="2" VerticalOptions="Center"
                        Text="07:28"
                        FontSize="{Binding Source=60, Converter={StaticResource SizeToRelativeValueConverter}}" />
                </Grid>
            </Grid>
            <StackLayout
                Grid.ColumnSpan="3" Grid.Row="2"
                Orientation="Horizontal"
                VerticalOptions="Center"
                Spacing="0">
                <Label
                    Padding="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}"
                    BackgroundColor="Black"
                    Text="Quick Advises"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <Label
                    HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                    Padding="{Binding Source=16, Converter={StaticResource SizeToRelativeValueConverter}}"
                    BackgroundColor="#E0696969"
                    Text="Marquesina de avisos ..."
                    TextColor="LightGray"
                    FontAttributes="Italic"
                    FontSize="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}}" />
            </StackLayout>
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>