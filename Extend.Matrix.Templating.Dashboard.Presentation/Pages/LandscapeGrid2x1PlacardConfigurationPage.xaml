<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:MOROPO.VIDERHE.Extend.Matrix.Templating.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Validators;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Behaviors;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardconverters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Converters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Presenters;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Dashboard.Views;assembly=MOROPO.VIDERHE.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="MOROPO.VIDERHE.Extend.Matrix.Templating.Dashboard.Presentation.Pages.LandscapeGrid2x1PlacardConfigurationPage"
    x:TypeArguments="pagemodels:LandscapeGrid2x1PlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <supportpresentationdashboardconverters:PlacardViewModelToPlacardThumbnailWrapViewConverter x:Key="PlacardViewModelToPlacardThumbnailWrapViewConverter" />
            <supportpresentationdashboardconverters:PlacardToIsAnyPlayerOrientationSupportedConverter x:Key="PlacardToIsAnyPlayerOrientationSupportedConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="200" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}"
                        Padding="0">
                        <Grid>
                            <StackLayout Margin="6">
                                <Label
                                    Margin="6,6,6,0"
                                    Text="Etiquetas" 
                                    Style="{StaticResource FormLabel}" />
                                <BoxView
                                    Margin="6,4,6,0"
                                    HeightRequest="2"
                                    Color="DimGray" />
                                <FlexLayout
                                    IsClippedToBounds="True"
                                    Wrap="Wrap"
                                    Direction="Column"
                                    AlignItems="Center"
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Path=Tags}">
                                    <BindableLayout.EmptyView>
                                        <Label Margin="6" Text="Sin elementos que mostrar" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                BackgroundColor="{StaticResource AccentColor}"
                                                Margin="6" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label
                                                    Grid.Column="0"
                                                    Margin="4,0,0,0"
                                                    VerticalOptions="Center"
                                                    Text="{Binding Path=Name}"
                                                    TextColor="White" />
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource TextIconButton}"
                                                    VerticalOptions="Center"
                                                    Text="&#xFA78;"
                                                    TextColor="White"
                                                    Clicked="RemoveTagButton_Clicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </StackLayout>
                            <Button
                                HorizontalOptions="End" VerticalOptions="Start"
                                Text="&#xF415;"
                                Style="{StaticResource TextIconButton}"
                                FontSize="Medium"
                                Clicked="AddTagButton_Clicked" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="BeginAtDatePickerLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                x:Name="BeginAtDatePicker"
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                x:Name="EndAtLabel"
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                x:Name="DefineEndAtSwitch"
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}">
                                <DatePicker.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultDatePickerValidationPresenter.Instance}"
                                        TargetProperty="{Static DatePicker.DateProperty}"
                                        Label="{Reference EndAtLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:DateComparisonFormFieldValidator 
                                                ReferenceField="{Reference BeginAtDatePicker}" 
                                                ReferenceFieldLabel="{Reference BeginAtDatePickerLabel}"
                                                FieldValidationSwich="{Reference DefineEndAtSwitch}" />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </DatePicker.Behaviors>
                            </DatePicker>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="3"
                        Style="{StaticResource FormFieldFrame}"
                        VerticalOptions="Start">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="4"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="3" Grid.Row="0"
                                Text="Sección Superior" 
                                Style="{StaticResource FormLabel}" />
                            <Grid
                                Grid.ColumnSpan="3" Grid.Row="1"
                                HeightRequest="340"
                                BackgroundColor="#66FFFFFF"
                                RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <StackLayout
                                    Grid.Row="0"
                                    Orientation="Horizontal"
                                    BackgroundColor="White">
                                    <Label 
                                        x:Name="OneOfFourPlacardsLabel"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource FormLabel}"
                                        Margin="10,10,10,6"
                                        Text="Carteles en la Sección Superior" />
                                    <Button
                                        VerticalOptions="Start"
                                        Text="&#xF415;"
                                        Style="{StaticResource TextIconButton}"
                                        FontSize="Medium"
                                        Clicked="IncludeOneOfTwoPlacardsButton_Clicked" />
                                </StackLayout>
                                <ScrollView
                                    Grid.Row="1"
                                    Margin="0"
                                    Orientation="Horizontal">
                                    <ContentView BackgroundColor="#66FFFFFF">
                                        <FlexLayout
                                            Margin="5"
                                            BindableLayout.ItemsSource="{Binding Path=OneOfTwoTargetPlacards}">
                                            <FlexLayout.Behaviors>
                                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                                    ValidableFormPage="{Reference FormPage}"
                                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                                    TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                                    Label="{Reference OneOfFourPlacardsLabel}">
                                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                        <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                            </FlexLayout.Behaviors>
                                            <BindableLayout.EmptyView>
                                                <Label
                                                    Margin="5"
                                                    Text="No se han agregado elementos"
                                                    TextColor="DimGray" />
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="5"
                                                        BackgroundColor="Black"
                                                        WidthRequest="200"
                                                        RowSpacing="0">
                                                        <Grid RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid 
                                                                Grid.Row="0"
                                                                HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                                                <BoxView Color="White" Opacity="0.2" />
                                                                <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                                                <Label
                                                                    IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                                                    HorizontalOptions="Start" VerticalOptions="End"
                                                                    BackgroundColor="{StaticResource PrimaryColor}"
                                                                    Padding="4"
                                                                    Text="&#xf884;"
                                                                    TextColor="White"
                                                                    FontFamily="Material Design Icons"
                                                                    FontSize="24" />
                                                            </Grid>
                                                            <ImageButton
                                                                Grid.Row="0"
                                                                VerticalOptions="Start" HorizontalOptions="End"
                                                                Margin="4"
                                                                WidthRequest="24"
                                                                HeightRequest="24"
                                                                BackgroundColor="#99000000"
                                                                BorderWidth="0"
                                                                CornerRadius="12"
                                                                Clicked="PlacardOneOfTwoDeleteButton_Clicked">
                                                                <ImageButton.Padding>
                                                                    <OnPlatform x:TypeArguments="Thickness">
                                                                        <On Platform="UWP" Value="1,0,0,0" />
                                                                    </OnPlatform>
                                                                </ImageButton.Padding>
                                                                <ImageButton.Source>
                                                                    <FontImageSource 
                                                                        Color="White"
                                                                        FontFamily="{StaticResource IconFontFamily}"
                                                                        Glyph="&#xF156;" />
                                                                </ImageButton.Source>
                                                            </ImageButton>
                                                            <StackLayout 
                                                                Grid.Row="1"
                                                                BackgroundColor="White"
                                                                Spacing="0">
                                                                <Label
                                                                    Margin="8,8,8,4"
                                                                    Text="{Binding Path=Placard.Label}"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Label 
                                                                    VerticalOptions="Center"
                                                                    Margin="8,0,0,8"
                                                                    Text="{Binding Path=Placard.Template.Name}"
                                                                    LineBreakMode="TailTruncation"
                                                                    TextColor="DimGray"
                                                                    FontSize="Caption" />
                                                            </StackLayout>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </ContentView>
                                </ScrollView>
                            </Grid>
                            <Frame 
                                Grid.Column="0" Grid.Row="2"
                                Style="{StaticResource FormFieldFrame}"
                                VerticalOptions="Start">
                                <StackLayout>
                                    <Label Text="Escalar carteles" Style="{StaticResource FormLabel}" />
                                    <Switch IsToggled="{Binding Path=IsOneOfTwoTargetPlacardsScalable}" />
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.ColumnSpan="3" Grid.Row="5"
                        Style="{StaticResource FormFieldFrame}"
                        BackgroundColor="#66FFFFFF"
                        VerticalOptions="Start">
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label 
                                Grid.ColumnSpan="3" Grid.Row="0"
                                Text="Sección Inferior" 
                                Style="{StaticResource FormLabel}" />
                            <Grid
                                Grid.ColumnSpan="3" Grid.Row="1"
                                HeightRequest="340"
                                BackgroundColor="#66FFFFFF"
                                RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <StackLayout
                                    Grid.Row="0"
                                    Orientation="Horizontal"
                                    BackgroundColor="White">
                                    <Label 
                                        x:Name="TwoOfTwoPlacardsLabel"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource FormLabel}"
                                        Margin="10,10,10,6"
                                        Text="Carteles" />
                                    <Button
                                        VerticalOptions="Start"
                                        Text="&#xF415;"
                                        Style="{StaticResource TextIconButton}"
                                        FontSize="Medium"
                                        Clicked="IncludeTwoOfTwoPlacardsButton_Clicked" />
                                </StackLayout>
                                <ScrollView
                                    Grid.Row="1"
                                    Margin="0"
                                    Orientation="Horizontal">
                                    <ContentView BackgroundColor="#66FFFFFF">
                                        <FlexLayout
                                            Margin="5"
                                            BindableLayout.ItemsSource="{Binding Path=TwoOfTwoTargetPlacards}">
                                            <FlexLayout.Behaviors>
                                                <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                                    ValidableFormPage="{Reference FormPage}"
                                                    FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                                    TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                                    Label="{Reference TwoOfTwoPlacardsLabel}">
                                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                        <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                            </FlexLayout.Behaviors>
                                            <BindableLayout.EmptyView>
                                                <Label
                                                    Margin="5"
                                                    Text="No se han agregado elementos"
                                                    TextColor="DimGray" />
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Margin="5"
                                                        BackgroundColor="Black"
                                                        WidthRequest="200"
                                                        RowSpacing="0">
                                                        <Grid RowSpacing="0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid 
                                                                Grid.Row="0"
                                                                HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                                                <BoxView Color="White" Opacity="0.2" />
                                                                <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                                                <Label
                                                                    IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                                                    HorizontalOptions="Start" VerticalOptions="End"
                                                                    BackgroundColor="{StaticResource PrimaryColor}"
                                                                    Padding="4"
                                                                    Text="&#xf884;"
                                                                    TextColor="White"
                                                                    FontFamily="Material Design Icons"
                                                                    FontSize="24" />
                                                            </Grid>
                                                            <ImageButton
                                                                Grid.Row="0"
                                                                VerticalOptions="Start" HorizontalOptions="End"
                                                                Margin="4"
                                                                WidthRequest="24"
                                                                HeightRequest="24"
                                                                BackgroundColor="#99000000"
                                                                BorderWidth="0"
                                                                CornerRadius="12"
                                                                Clicked="PlacardTowOfTwoDeleteButton_Clicked">
                                                                <ImageButton.Padding>
                                                                    <OnPlatform x:TypeArguments="Thickness">
                                                                        <On Platform="UWP" Value="1,0,0,0" />
                                                                    </OnPlatform>
                                                                </ImageButton.Padding>
                                                                <ImageButton.Source>
                                                                    <FontImageSource 
                                                                        Color="White"
                                                                        FontFamily="{StaticResource IconFontFamily}"
                                                                        Glyph="&#xF156;" />
                                                                </ImageButton.Source>
                                                            </ImageButton>
                                                            <StackLayout 
                                                                Grid.Row="1"
                                                                BackgroundColor="White"
                                                                Spacing="0">
                                                                <Label
                                                                    Margin="8,8,8,4"
                                                                    Text="{Binding Path=Placard.Label}"
                                                                    LineBreakMode="TailTruncation" />
                                                                <Label 
                                                                    VerticalOptions="Center"
                                                                    Margin="8,0,0,8"
                                                                    Text="{Binding Path=Placard.Template.Name}"
                                                                    LineBreakMode="TailTruncation"
                                                                    TextColor="DimGray"
                                                                    FontSize="Caption" />
                                                            </StackLayout>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>
                                    </ContentView>
                                </ScrollView>
                            </Grid>
                            <Frame 
                                Grid.Column="0" Grid.Row="2"
                                Style="{StaticResource FormFieldFrame}"
                                VerticalOptions="Start">
                                <StackLayout>
                                    <Label Text="Escalar carteles" Style="{StaticResource FormLabel}" />
                                    <Switch IsToggled="{Binding Path=IsTwoOfTwoTargetPlacardsScalable}" />
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </Frame>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>