<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:BindingContextedContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Matrix.Templating.Dashboard.Presentation.Models.Page"
    xmlns:supportpresentationdashboardvalidators="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Validators;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Converters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardpresenters="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Presenters;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:supportpresentationdashboardviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation.Dashboard"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.Matrix.Templating.Dashboard.Presentation.Pages.LandscapeGrid1x3PlacardConfigurationPage"
    x:TypeArguments="pagemodels:LandscapeGrid1x3PlacardConfigurationPageModel"
    x:Name="FormPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <supportpresentationdashboardconverters:PlacardViewModelToPlacardThumbnailWrapViewConverter x:Key="PlacardViewModelToPlacardThumbnailWrapViewConverter" />
            <supportpresentationdashboardconverters:PlacardToIsAnyPlayerOrientationSupportedConverter x:Key="PlacardToIsAnyPlayerOrientationSupportedConverter" />
            <sscxftoolkitpresentationconverters:BoolToBoolNegationConverter x:Key="BoolToBoolNegationConverter" />
            <sscxftoolkitpresentationconverters:BindingLayoutWidthToResponsiveChildWidthConverter x:Key="BindingLayoutWidthToResponsiveChildWidthConverter" ChildMinWidth="200" ChildAbsoluteHorizontalMargin="10" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="Aplicar"
            Clicked="ApplyToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf12c;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
        <ToolbarItem 
            Text="Cancelar"
            Clicked="CancelToolbarItem_Clicked">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="{StaticResource ToolbarIconFontFamily}" Glyph="&#xf156;">
                    <FontImageSource.Color>
                        <OnPlatform x:TypeArguments="Color">
                            <On Platform="UWP" Value="Black" />
                        </OnPlatform>
                    </FontImageSource.Color>
                </FontImageSource>
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <supportpresentationdashboardviews:BackgroundView />
            <ScrollView>
                <Grid 
                    Margin="10,0,10,10"
                    ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackLayout 
                        Grid.ColumnSpan="3" Grid.Row="0"
                        Padding="0,10,0,0"
                        IsVisible="{Binding Path=IsValid, Converter={StaticResource BoolToBoolNegationConverter}}"
                        BindableLayout.ItemsSource="{Binding Path=ValidationMessages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid 
                                    BackgroundColor="Tomato"
                                    RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <BoxView 
                                        Grid.Column="0" Grid.RowSpan="2"
                                        Color="Red" />
                                    <Label
                                        Grid.Column="1" Grid.Row="0"
                                        Padding="5,5,5,2"
                                        Text="{Binding Path=Caption}"
                                        TextColor="White"
                                        FontAttributes="Bold" />
                                    <Label 
                                        Grid.Column="1" Grid.Row="1"
                                        Padding="5,0,5,5"
                                        Text="{Binding Path=Message}"
                                        TextColor="White" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <Frame
                        Grid.ColumnSpan="3" Grid.Row="1"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label 
                                x:Name="LabelLabel"
                                Text="Nombre" 
                                Style="{StaticResource FormLabel}" />
                            <Entry Text="{Binding Path=Label}">
                                <Entry.Behaviors>
                                    <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                        ValidableFormPage="{Reference FormPage}"
                                        FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultEntryValidationPresenter.Instance}"
                                        TargetProperty="{Static Entry.TextProperty}"
                                        Label="{Reference LabelLabel}">
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                            <supportpresentationdashboardvalidators:RequiredFormFieldValidator />
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                    </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                </Entry.Behaviors>
                            </Entry>
                        </StackLayout>
                    </Frame>
                    <Frame 
                        Grid.Column="0" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de incio" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineBeginAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineBeginAt, Mode=OneWay}"
                                Date="{Binding Path=BeginAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="1" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label
                                Grid.ColumnSpan="2" Grid.Row="0"
                                Text="Fecha de fin" 
                                Style="{StaticResource FormLabel}" />
                            <Switch 
                                Grid.Column="0" Grid.Row="1"
                                IsToggled="{Binding Path=DefineEndAt}" />
                            <DatePicker 
                                Grid.Column="1" Grid.Row="1"
                                IsEnabled="{Binding DefineEndAt, Mode=OneWay}"
                                Date="{Binding Path=EndAt}" />
                        </Grid>
                    </Frame>
                    <Frame 
                        Grid.Column="2" Grid.Row="2"
                        Style="{StaticResource FormFieldFrame}">
                        <StackLayout>
                            <Label Text="A Pantalla Completa" Style="{StaticResource FormLabel}" />
                            <Switch IsToggled="{Binding Path=RequireUnobstructedPresetation}" />
                        </StackLayout>
                    </Frame>
                    <Grid
                        Grid.ColumnSpan="3" Grid.Row="3"
                        HeightRequest="340"
                        BackgroundColor="#66FFFFFF"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Orientation="Horizontal"
                            BackgroundColor="White">
                            <Label 
                                x:Name="OneOfThreePlacardsLabel"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Carteles en el Cuadrante 1x1" />
                            <Button
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="IncludeOneOfThreePlacardsButton_Clicked" />
                        </StackLayout>
                        <ScrollView
                            Grid.Row="1"
                            Margin="0"
                            Orientation="Horizontal">
                            <ContentView BackgroundColor="#66FFFFFF">
                                <FlexLayout
                                    Margin="5"
                                    BindableLayout.ItemsSource="{Binding Path=OneOfThreeTargetPlacards}">
                                    <FlexLayout.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                            TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                            Label="{Reference OneOfThreePlacardsLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </FlexLayout.Behaviors>
                                    <BindableLayout.EmptyView>
                                        <Label
                                            Margin="5"
                                            Text="No se han agregado elementos"
                                            TextColor="DimGray" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="5"
                                                BackgroundColor="Black"
                                                WidthRequest="200"
                                                RowSpacing="0">
                                                <Grid RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid 
                                                        Grid.Row="0"
                                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                                        <BoxView Color="White" Opacity="0.2" />
                                                        <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                                        <Label
                                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                                            HorizontalOptions="Start" VerticalOptions="End"
                                                            BackgroundColor="{StaticResource PrimaryColor}"
                                                            Padding="4"
                                                            Text="&#xf884;"
                                                            TextColor="White"
                                                            FontFamily="Material Design Icons"
                                                            FontSize="24" />
                                                    </Grid>
                                                    <ImageButton
                                                        Grid.Row="0"
                                                        VerticalOptions="Start" HorizontalOptions="End"
                                                        Margin="4"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        BackgroundColor="#99000000"
                                                        BorderWidth="0"
                                                        CornerRadius="12"
                                                        Clicked="PlacardOneOfThreeDeleteButton_Clicked">
                                                        <ImageButton.Padding>
                                                            <OnPlatform x:TypeArguments="Thickness">
                                                                <On Platform="UWP" Value="1,0,0,0" />
                                                            </OnPlatform>
                                                        </ImageButton.Padding>
                                                        <ImageButton.Source>
                                                            <FontImageSource 
                                                                Color="White"
                                                                FontFamily="{StaticResource IconFontFamily}"
                                                                Glyph="&#xF156;" />
                                                        </ImageButton.Source>
                                                    </ImageButton>
                                                    <StackLayout 
                                                        Grid.Row="1"
                                                        BackgroundColor="White"
                                                        Spacing="0">
                                                        <Label
                                                            Margin="8,8,8,4"
                                                            Text="{Binding Path=Placard.Label}"
                                                            LineBreakMode="TailTruncation" />
                                                        <Label 
                                                            VerticalOptions="Center"
                                                            Margin="8,0,0,8"
                                                            Text="{Binding Path=Placard.Template.Name}"
                                                            LineBreakMode="TailTruncation"
                                                            TextColor="DimGray"
                                                            FontSize="Caption" />
                                                    </StackLayout>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </ContentView>
                        </ScrollView>
                    </Grid>
                    <Grid
                        Grid.ColumnSpan="3" Grid.Row="4"
                        HeightRequest="340"
                        BackgroundColor="#66FFFFFF"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Orientation="Horizontal"
                            BackgroundColor="White">
                            <Label 
                                x:Name="TwoOfThreePlacardsLabel"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Carteles en el Cuadrante 1x2" />
                            <Button
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="IncludeTwoOfThreePlacardsButton_Clicked" />
                        </StackLayout>
                        <ScrollView
                            Grid.Row="1"
                            Margin="0"
                            Orientation="Horizontal">
                            <ContentView BackgroundColor="#66FFFFFF">
                                <FlexLayout
                                    Margin="5"
                                    BindableLayout.ItemsSource="{Binding Path=TwoOfThreeTargetPlacards}">
                                    <FlexLayout.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                            TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                            Label="{Reference TwoOfThreePlacardsLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </FlexLayout.Behaviors>
                                    <BindableLayout.EmptyView>
                                        <Label
                                            Margin="5"
                                            Text="No se han agregado elementos"
                                            TextColor="DimGray" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="5"
                                                BackgroundColor="Black"
                                                WidthRequest="200"
                                                RowSpacing="0">
                                                <Grid RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid 
                                                        Grid.Row="0"
                                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                                        <BoxView Color="White" Opacity="0.2" />
                                                        <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                                        <Label
                                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                                            HorizontalOptions="Start" VerticalOptions="End"
                                                            BackgroundColor="{StaticResource PrimaryColor}"
                                                            Padding="4"
                                                            Text="&#xf884;"
                                                            TextColor="White"
                                                            FontFamily="Material Design Icons"
                                                            FontSize="24" />
                                                    </Grid>
                                                    <ImageButton
                                                        Grid.Row="0"
                                                        VerticalOptions="Start" HorizontalOptions="End"
                                                        Margin="4"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        BackgroundColor="#99000000"
                                                        BorderWidth="0"
                                                        CornerRadius="12"
                                                        Clicked="PlacardTowOfThreeDeleteButton_Clicked">
                                                        <ImageButton.Padding>
                                                            <OnPlatform x:TypeArguments="Thickness">
                                                                <On Platform="UWP" Value="1,0,0,0" />
                                                            </OnPlatform>
                                                        </ImageButton.Padding>
                                                        <ImageButton.Source>
                                                            <FontImageSource 
                                                                Color="White"
                                                                FontFamily="{StaticResource IconFontFamily}"
                                                                Glyph="&#xF156;" />
                                                        </ImageButton.Source>
                                                    </ImageButton>
                                                    <StackLayout 
                                                        Grid.Row="1"
                                                        BackgroundColor="White"
                                                        Spacing="0">
                                                        <Label
                                                            Margin="8,8,8,4"
                                                            Text="{Binding Path=Placard.Label}"
                                                            LineBreakMode="TailTruncation" />
                                                        <Label 
                                                            VerticalOptions="Center"
                                                            Margin="8,0,0,8"
                                                            Text="{Binding Path=Placard.Template.Name}"
                                                            LineBreakMode="TailTruncation"
                                                            TextColor="DimGray"
                                                            FontSize="Caption" />
                                                    </StackLayout>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </ContentView>
                        </ScrollView>
                    </Grid>
                    <Grid
                        Grid.ColumnSpan="3" Grid.Row="5"
                        HeightRequest="340"
                        BackgroundColor="#66FFFFFF"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackLayout
                            Grid.Row="0"
                            Orientation="Horizontal"
                            BackgroundColor="White">
                            <Label 
                                x:Name="ThreeOfThreePlacardsLabel"
                                HorizontalOptions="FillAndExpand"
                                Style="{StaticResource FormLabel}"
                                Margin="10,10,10,6"
                                Text="Carteles en el Cuadrante 1x3" />
                            <Button
                                VerticalOptions="Start"
                                Text="Agregar"
                                Clicked="IncludeThreeOfThreePlacardsButton_Clicked" />
                        </StackLayout>
                        <ScrollView
                            Grid.Row="1"
                            Margin="0"
                            Orientation="Horizontal">
                            <ContentView BackgroundColor="#66FFFFFF">
                                <FlexLayout
                                    Margin="5"
                                    BindableLayout.ItemsSource="{Binding Path=ThreeOfThreeTargetPlacards}">
                                    <FlexLayout.Behaviors>
                                        <supportpresentationdashboardbehaviors:ViewValidationBehavior
                                            ValidableFormPage="{Reference FormPage}"
                                            FormFieldValidationPresenter="{Static supportpresentationdashboardpresenters:DefaultCollectionFlexLayoutValidationPresenter.Instance}"
                                            TargetProperty="{Static BindableLayout.ItemsSourceProperty}"
                                            Label="{Reference ThreeOfThreePlacardsLabel}">
                                            <supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                                <supportpresentationdashboardvalidators:MinCountFormFieldValidator MinCount="1" />
                                            </supportpresentationdashboardbehaviors:ViewValidationBehavior.Validators>
                                        </supportpresentationdashboardbehaviors:ViewValidationBehavior>
                                    </FlexLayout.Behaviors>
                                    <BindableLayout.EmptyView>
                                        <Label
                                            Margin="5"
                                            Text="No se han agregado elementos"
                                            TextColor="DimGray" />
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="5"
                                                BackgroundColor="Black"
                                                WidthRequest="200"
                                                RowSpacing="0">
                                                <Grid RowSpacing="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid 
                                                        Grid.Row="0"
                                                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Width}">
                                                        <BoxView Color="White" Opacity="0.2" />
                                                        <ContentView Content="{Binding Path=Placard, Converter={StaticResource PlacardViewModelToPlacardThumbnailWrapViewConverter}}" />
                                                        <Label
                                                            IsVisible="{Binding Path=Placard, Converter={StaticResource PlacardToIsAnyPlayerOrientationSupportedConverter}}"
                                                            HorizontalOptions="Start" VerticalOptions="End"
                                                            BackgroundColor="{StaticResource PrimaryColor}"
                                                            Padding="4"
                                                            Text="&#xf884;"
                                                            TextColor="White"
                                                            FontFamily="Material Design Icons"
                                                            FontSize="24" />
                                                    </Grid>
                                                    <ImageButton
                                                        Grid.Row="0"
                                                        VerticalOptions="Start" HorizontalOptions="End"
                                                        Margin="4"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        BackgroundColor="#99000000"
                                                        BorderWidth="0"
                                                        CornerRadius="12"
                                                        Clicked="PlacardThreeOfThreeDeleteButton_Clicked">
                                                        <ImageButton.Padding>
                                                            <OnPlatform x:TypeArguments="Thickness">
                                                                <On Platform="UWP" Value="1,0,0,0" />
                                                            </OnPlatform>
                                                        </ImageButton.Padding>
                                                        <ImageButton.Source>
                                                            <FontImageSource 
                                                                Color="White"
                                                                FontFamily="{StaticResource IconFontFamily}"
                                                                Glyph="&#xF156;" />
                                                        </ImageButton.Source>
                                                    </ImageButton>
                                                    <StackLayout 
                                                        Grid.Row="1"
                                                        BackgroundColor="White"
                                                        Spacing="0">
                                                        <Label
                                                            Margin="8,8,8,4"
                                                            Text="{Binding Path=Placard.Label}"
                                                            LineBreakMode="TailTruncation" />
                                                        <Label 
                                                            VerticalOptions="Center"
                                                            Margin="8,0,0,8"
                                                            Text="{Binding Path=Placard.Template.Name}"
                                                            LineBreakMode="TailTruncation"
                                                            TextColor="DimGray"
                                                            FontSize="Caption" />
                                                    </StackLayout>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </ContentView>
                        </ScrollView>
                    </Grid>
                </Grid>
            </ScrollView>
            <supportpresentationdashboardviews:BusyView />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:BindingContextedContentPage>