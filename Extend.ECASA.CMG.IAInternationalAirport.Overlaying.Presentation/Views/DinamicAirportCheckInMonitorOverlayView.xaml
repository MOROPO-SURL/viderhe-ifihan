<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation"
    xmlns:ffimageloadingforms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    x:Class="MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Overlaying.Presentation.Views.DinamicAirportCheckInMonitorOverlayView">
    <ContentView.Resources>
        <ResourceDictionary>
            <extendcommontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <extendcommontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" />

            <Thickness x:Key="FullPresentationGridMargin">80,40,80,80</Thickness>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="Montserrat (Regular)" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid 
                x:Name="PrePresentationGrid"
                Grid.Column="1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <BoxView
                    Grid.Row="0"
                    BackgroundColor="{Binding Source={Reference PrimaryChechInNumberBackgroundBoxView}, Path=Color}" />
                <Label
                    x:Name="PreCheckInHeadLabel"
                    Grid.Row="0"
                    Margin="100,0,20,0"
                    VerticalTextAlignment="Center"
                    TextColor="White"
                    FontFamily="Montserrat (Bold)"
                    FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}}" />
                <Grid 
                    Grid.Row="1"
                    Margin="100,20,20,20"
                    ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ffimageloadingforms:CachedImage 
                        x:Name="PreOperationCarrierImageView"
                        Grid.Column="0" Grid.RowSpan="2"
                        WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                        Aspect="AspectFill"
                        CacheType="Disk"
                        CacheDuration="8760:00:00" />
                    <Label
                        Grid.Column="1" Grid.Row="0"
                        VerticalTextAlignment="Center"
                        Text="{Binding Path=Operation.Carrier.Name}"
                        TextColor="Black"
                        FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}}"
                        FontFamily="Montserrat (Regular)" />
                    <Label
                        Grid.Column="1" Grid.Row="1"
                        VerticalTextAlignment="Center"
                        TextColor="Black"
                        FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}}"
                        FontFamily="Montserrat (Regular)">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Path=Operation.Carrier.Id}" />
                                <Span Text=" " />
                                <Span Text="{Binding Path=Operation.Flight}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <StackLayout 
                        Grid.Column="2" Grid.RowSpan="2"
                        HorizontalOptions="Center" VerticalOptions="End"
                        Margin="20,0,0,0"
                        Spacing="0">
                        <Label
                            Text="Destino:"
                            TextColor="DimGray"
                            FontSize="{Binding Source=21, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            Grid.Column="1" Grid.Row="0"
                            VerticalTextAlignment="Center"
                            Text="{Binding Path=Operation.Context}"
                            TextColor="Black"
                            FontSize="{Binding Source=72, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                    </StackLayout>
                    <Label
                        Grid.Column="1" Grid.Row="0"
                        VerticalTextAlignment="Center"
                        Text="{Binding Path=Operation.Carrier.Name}"
                        TextColor="Black"
                        FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}}"
                        FontFamily="Montserrat (Regular)" />
                    <Label
                        Grid.Column="1" Grid.Row="1"
                        VerticalTextAlignment="Center"
                        TextColor="Black"
                        FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}}"
                        FontFamily="Montserrat (Regular)">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Path=Operation.Carrier.Id}" />
                                <Span Text=" " />
                                <Span Text="{Binding Path=Operation.Flight}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <StackLayout Grid.Column="3" Grid.RowSpan="2" Spacing="0">
                        <Label
                            Text="Hora de inicio:"
                            TextColor="DimGray"
                            FontSize="{Binding Source=21, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            VerticalOptions="FillAndExpand"
                            VerticalTextAlignment="Center"
                            Text="{Binding Path=StartAt, StringFormat='{0:HH\\:mm}'}"
                            TextColor="Black"
                            FontSize="{Binding Source=72, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                    </StackLayout>
                    
                </Grid>
            </Grid>
            <Grid 
                x:Name="ChechInNumberWrapGrid"
                Grid.Column="0" Grid.Row="1"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="9*" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <BoxView 
                    x:Name="SecoundaryChechInNumberBackgroundBoxView"
                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Scale="1.65"
                    Rotation="21"
                    TranslationX="{Binding Source=-25, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                    TranslationY="{Binding Source=10, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <BoxView 
                    x:Name="PrimaryChechInNumberBackgroundBoxView"
                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Scale="1.45"
                    Rotation="7" />
                <Label 
                    x:Name="ChechInNumberLabel"
                    Grid.Column="1" Grid.Row="0"
                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                    FontFamily="Montserrat (Bold)"
                    FontSize="{Binding Path=., Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
            </Grid>
            <StackLayout 
                x:Name="FullPresentationGrid"
                Grid.ColumnSpan="2" Grid.RowSpan="2"
                Padding="{Binding Source={StaticResource FullPresentationGridMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        VerticalTextAlignment="Center"
                        Text="&#xF6BF;"
                        TextColor="White"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="{Binding Source=180, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    <Label
                        Grid.Column="1"
                        VerticalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        Text="CHECK-IN"
                        TextColor="White"
                        FontFamily="Montserrat (Bold)"
                        FontSize="{Binding Source=120, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    <Label
                        Grid.Column="2"
                        VerticalTextAlignment="Center"
                        Text="{Binding Source={Reference ChechInNumberLabel}, Path=Text}"
                        FontFamily="Montserrat (Bold)"
                        FontSize="{Binding Source=192, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                </Grid>
                <Label 
                    x:Name="CheckInStatusLabel"
                    BackgroundColor="White"
                    Padding="20" Margin="0,0,0,30"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    TextColor="{Binding Source={Reference PrimaryChechInNumberBackgroundBoxView}, Path=Color}"
                    FontFamily="Montserrat (Bold)"
                    FontSize="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <Grid VerticalOptions="FillAndExpand" RowSpacing="20" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid 
                        Grid.Column="0" Grid.RowSpan="2"
                        ColumnSpacing="20" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid
                            IsVisible="{Binding Path=IsVIP}"
                            Grid.Column="2" Grid.Row="1" Grid.RowSpan="4">
                            <Label
                                HorizontalOptions="Center" VerticalOptions="Center"
                                Text="&#xF76B;"
                                TextColor="#f3f1bc"
                                FontFamily="{StaticResource IconFontFamily}"
                                FontSize="{Binding Source=360, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                            <Label
                                HorizontalOptions="Center" VerticalOptions="Center"
                                Rotation="15"
                                Text="VIP"
                                TextColor="{Binding Source={Reference PrimaryChechInNumberBackgroundBoxView}, Path=Color}"
                                FontSize="{Binding Source=96, Converter={StaticResource SizeToRelativeValueConverter}}" />
                        </Grid>
                        <ffimageloadingforms:CachedImage 
                            x:Name="FullOperationCarrierImageView"
                            Grid.Column="0" Grid.RowSpan="3"
                            BackgroundColor="White"
                            WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                            Aspect="AspectFill"
                            CacheType="Disk"
                            CacheDuration="8760:00:00" />
                        <Label
                            Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                            VerticalTextAlignment="Center"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Path=Operation.Carrier.Name}"
                            FontSize="{Binding Source=80, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                        <Label
                            Grid.Column="1" Grid.Row="1"
                            Margin="0,10,0,0"
                            Opacity="0.8"
                            Text="Vuelo:"
                            TextColor="White"
                            FontSize="{Binding Source=32, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            Grid.Column="1" Grid.Row="2"
                            VerticalTextAlignment="Center"
                            FontSize="{Binding Source=64, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Path=Operation.Carrier.Id}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Path=Operation.Flight}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label
                            Grid.ColumnSpan="2" Grid.Row="3"
                            Margin="0,30,0,0"
                            Opacity="0.8"
                            Text="Destino:"
                            TextColor="White"
                            FontSize="{Binding Source=32, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            Grid.ColumnSpan="2" Grid.Row="4"
                            VerticalOptions="FillAndExpand"
                            LineBreakMode="TailTruncation"
                            Text="{Binding Path=Operation.Context}"
                            FontSize="{Binding Source=64, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                    </Grid>
                    <StackLayout 
                        Grid.Column="1" Grid.Row="0"
                        VerticalOptions="Center">
                        <Label
                            Opacity="0.8"
                            Text="Iniciado:"
                            TextColor="White"
                            FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            VerticalOptions="FillAndExpand"
                            VerticalTextAlignment="Center"
                            Text="{Binding Path=StartAt, StringFormat='{0:HH\\:mm}'}"
                            FontSize="{Binding Source=96, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                    </StackLayout>
                    <StackLayout 
                        Grid.Column="1" Grid.Row="1"
                        VerticalOptions="Center">
                        <Label
                            Opacity="0.8"
                            Text="Finaliza:"
                            TextColor="White"
                            FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Bold)" />
                        <Label
                            VerticalOptions="FillAndExpand"
                            VerticalTextAlignment="Center"
                            Text="{Binding Path=EndAt, StringFormat='{0:HH\\:mm}'}"
                            FontSize="{Binding Source=96, Converter={StaticResource SizeToRelativeValueConverter}}"
                            FontFamily="Montserrat (Regular)" />
                    </StackLayout>
                </Grid>
                <BoxView
                    x:Name="FullPresentationFooterSeparationBoxView"
                    Margin="0,20"
                    Color="White"
                    HeightRequest="2" />
                <StackLayout Orientation="Horizontal" Margin="20,0">
                    <Label
                        Text="&#xF0ED;"
                        Margin="0,3,0,0"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="{Binding Source=44, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    <Label
                        x:Name="NowDateLabel"
                        VerticalTextAlignment="Center"
                        FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    <Label
                        Text="&#xF150;"
                        Margin="20,0,0,0"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="{Binding Source=40, Converter={StaticResource SizeToRelativeValueConverter}}" />
                    <Label
                        x:Name="NowTimeLabel"
                        HorizontalOptions="FillAndExpand"
                        VerticalTextAlignment="Center"
                        FontSize="{Binding Source=36, Converter={StaticResource SizeToRelativeValueConverter}}" />
                </StackLayout>
            </StackLayout>
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>