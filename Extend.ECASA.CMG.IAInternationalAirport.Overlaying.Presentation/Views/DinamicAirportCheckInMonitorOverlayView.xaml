<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation.Views;assembly=MOROPO.VIDERHE.Extend.Common.Overlaying.Presentation"
    x:Class="MOROPO.VIDERHE.Extend.ECASA.CMG.IAInternationalAirport.Overlaying.Presentation.Views.DinamicAirportCheckInMonitorOverlayView">
    <ContentView.Content>
        <Grid>
            <Grid x:Name="PrePresentationGrid">
                <Label Text="En Breve ..." />
            </Grid>
            <Grid 
                x:Name="CallToActionMessageWrapGrid"
                HorizontalOptions="Start" VerticalOptions="End">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <BoxView 
                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                    x:Name="CallToActionMessageBackgroundBoxView" />
                <Label
                    x:Name="CallToActionMessageLabel"
                    Grid.Column="0" Grid.Row="1"
                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Grid>
            <Grid x:Name="FullPresentationGrid">                
            </Grid>
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>