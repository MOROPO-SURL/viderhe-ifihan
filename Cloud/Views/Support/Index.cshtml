@{
    ViewData["Title"] = "Ayuda Viderhe Control";
}

<main role="main">
    <section class="jumbotron text-center" style="margin-bottom: 0;">
        <div class="container">
            <img src="~/img/viderhe-identity-main.png?tag=1" style="margin-bottom: 30px;" />
            <h1 class="display-4">Centro de Ayuda</h1>
            <p class="lead text-muted" style="margin-top: 8px;">Espacio dedicado a la asistencia primaria de usuarios de la plataforma <b>Viderhe</b></p>
        </div>
    </section>
    <div class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-img-top" style="display:table; background-color: #55595c; width: 100%; height: 240px;">
                            <span class="mdi mdi-book-open-variant" style="display: table-cell; text-align: center; vertical-align: middle; color: white; font-size: 144px;" />
                        </div>
                        <div class="card-body">
                            <p class="card-title"><h3>Manual de Usuario</h3></p>
                            <p class="card-text">Documento de información técnica orientado a usuarios responsables del administrar Cuentas de Servicio de la plataforma.</p>
                        </div>
                        <div class="card-footer">
                            <button type="button" class="btn btn-sm btn-primary">Mostrar</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-img-top" style="display:table; background-color: #55595c; width: 100%; height: 240px;">
                            <span class="mdi mdi-comment-question" style="display: table-cell; text-align: center; vertical-align: middle; color: white; font-size: 144px;" />
                        </div>
                        <div class="card-body">
                            <p class="card-title"><h3>Preguntas Frecuentes</h3></p>
                            <p class="card-text">Compendio de preguntas y respuestas útiles a usuarios responsables del administrar Cuentas de Servicio de la plataforma.</p>
                        </div>
                        <div class="card-footer">
                            <button type="button" class="btn btn-sm btn-primary">Mostrar</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <div class="card-img-top" style="display:table; background-color: #55595c; width: 100%; height: 240px;">
                            <span class="mdi mdi-theater" style="display: table-cell; text-align: center; vertical-align: middle; color: white; font-size: 144px;" />
                        </div>
                        <div class="card-body">
                            <p class="card-title"><h3>Video Tutoriales</h3></p>
                            <p class="card-text">Compendio de videos instructiuvos orientados a usuarios responsables del administrar Cuentas de Servicio de la plataforma.</p>
                        </div>
                        <div class="card-footer">
                            <button type="button" class="btn btn-sm btn-primary">Mostrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
