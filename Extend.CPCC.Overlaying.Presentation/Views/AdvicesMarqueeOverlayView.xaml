<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation.Views;assembly=SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommonoverlayingpresentationbehaviors="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation.Behaviors;assembly=SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommonoverlayingpresentationconverters="clr-namespace:SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation.Converters;assembly=SmartSolucionesCuba.Videre.Extend.Common.Overlaying.Presentation"
    xmlns:sscxftoolkitpresentationtransformbehaviors="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Transform.Behaviors;assembly=SmartSolucionesCuba.XFToolKit.Presentation.Transform"
    xmlns:sscxftoolkitpresentationtransformanimations="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Transform.Animations;assembly=SmartSolucionesCuba.XFToolKit.Presentation.Transform"
    xmlns:local="clr-namespace:SmartSolucionesCuba.Videre.Extend.CPCC.Overlaying.Presentation.Views"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Extend.CPCC.Overlaying.Presentation.Views.AdvicesMarqueeOverlayView"
    x:Name="View"
    TranslationY="{x:Static local:AdvicesMarqueeOverlayView.MOTION_TRANSLATION}">
    <ContentView.Resources>
        <ResourceDictionary>
            <extendcommonoverlayingpresentationconverters:TextToAbsoluteLayoutBoundsConverter x:Key="TextToAbsoluteLayoutBoundsConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Behaviors>
        <sscxftoolkitpresentationtransformbehaviors:BeginAnimationBehavior>
            <sscxftoolkitpresentationtransformbehaviors:BeginAnimationBehavior.Animation>
                <sscxftoolkitpresentationtransformanimations:TranslateToAnimation 
                    Target="{x:Reference View}" 
                    Delay="5000"
                    EasingType="CubicOut" 
                    TranslateY="0" />
            </sscxftoolkitpresentationtransformbehaviors:BeginAnimationBehavior.Animation>
        </sscxftoolkitpresentationtransformbehaviors:BeginAnimationBehavior>
    </ContentView.Behaviors>
    <ContentView.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"                
                BackgroundColor="#FFA0A0A0">
                <AbsoluteLayout VerticalOptions="Center">
                    <Label
                    AbsoluteLayout.LayoutFlags="None"
                    AbsoluteLayout.LayoutBounds="{Binding Path=InLineAdvices, Converter={StaticResource TextToAbsoluteLayoutBoundsConverter}}"
                    Padding="0,10"
                    Text="{Binding Path=InLineAdvices}"
                    TextColor="Black"
                    LineBreakMode="NoWrap">
                        <Label.Behaviors>
                            <extendcommonoverlayingpresentationbehaviors:MarqueeLabelBehavior />
                        </Label.Behaviors>
                    </Label>
                </AbsoluteLayout>
            </Grid>
            <Polygon
                Grid.Column="1" Grid.Row="1"
                Fill="Black"
                Points="0 0, 15 0, 0 40"/>
            <Polygon
                Grid.Column="1" Grid.Row="1"
                Fill="#A0A0A0"
                Points="15 0, 25 0, 15 40, 0 40"/>
            <Polygon
                Grid.Column="1" Grid.Row="1"
                Fill="#2A2A2A"
                Points="25 0, 60 0, 45 40, 10 40"/>
            <Label 
                Grid.Column="0" Grid.Row="1"
                BackgroundColor="Black"
                Padding="12,10"
                Text="Avisos en Cartelera"
                TextColor="White"
                FontAttributes="Bold" />
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>