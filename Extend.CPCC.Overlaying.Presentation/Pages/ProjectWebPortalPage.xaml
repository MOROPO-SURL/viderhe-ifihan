<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:supportpresentationhelpers="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Helpers;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.CPCC.Overlaying.Presentation.Pages.ProjectWebPortalPage"
    BackgroundColor="White">
    <ContentPage.Content>
        <Grid ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label
                Grid.ColumnSpan="3" Grid.Row="0"
                BackgroundColor="LightGray"
                Text="Portal del proyecto Callejón de los Milagros"
                TextColor="Black"
                FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.NormalHeaderTextFontSize}"
                HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <ActivityIndicator
                x:Name="NavigationActivityIndicator"
                Grid.Column="0" Grid.Row="0"
                WidthRequest="{Binding Source={RelativeSource Mode=Self}, Path=Height}"
                Color="CadetBlue"
                IsRunning="True"/>
            <Button
                Grid.Column="2" Grid.Row="0"
                WidthRequest="48" HeightRequest="48"
                BackgroundColor="DarkRed"
                Text="&#xf5ad;"
                TextColor="White"
                FontFamily="{StaticResource IconFontFamily}"
                FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.NormalHeaderTextFontSize}"
                Clicked="CloseButton_Clicked"/>
            <BoxView
                Grid.ColumnSpan="3" Grid.Row="1"
                Color="Gray"
                HeightRequest="1" />
            <WebView 
                Grid.ColumnSpan="3" Grid.Row="2"
                Source="http://www.elcallejon.net/"
                Navigating="WebView_Navigating"
                Navigated="WebView_Navigated" />
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>