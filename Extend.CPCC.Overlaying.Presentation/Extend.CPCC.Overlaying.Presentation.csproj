<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SmartSolucionesCuba.Viderhe.Extend.CPCC.Overlaying.Presentation</AssemblyName>
    <RootNamespace>SmartSolucionesCuba.Viderhe.Extend.CPCC.Overlaying.Presentation</RootNamespace>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Image\NM-landscape.jpg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Image\NM-landscape.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicGradients" Version="1.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.2" />
    <PackageReference Include="SAPRESSC.Business.Billboard.CPCC.Web.Api.Client" Version="0.6.0-alpha" />
    <PackageReference Include="SkiaSharp.Views.Forms" Version="2.80.3" />
    <PackageReference Include="SSCXFToolKit.Presentation" Version="0.6.2" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2083" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Extend.Common.Overlaying.Presentation\Extend.Common.Overlaying.Presentation.csproj" />
    <ProjectReference Include="..\Extend.CPCC.Overlaying\Extend.CPCC.Overlaying.csproj" />
    <ProjectReference Include="..\Support.Presentation\Support.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\NMTourPage.xaml.cs">
      <DependentUpon>NMTourPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\WebPortalPage.xaml.cs">
      <DependentUpon>WebPortalPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\NMTourOverlayView.xaml.cs">
      <DependentUpon>NMTourOverlayView.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Pages\NMTourPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Pages\WebPortalPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\AdvicesMarqueeOverlayView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\NMTourOverlayView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
