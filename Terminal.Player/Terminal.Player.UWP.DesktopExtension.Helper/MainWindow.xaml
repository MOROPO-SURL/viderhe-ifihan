<Window 
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Player.UWP.DesktopExtension.Helper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Viderhe Player Helper" Height="450" Width="800"
    Activated="Window_Activated" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" WindowState="Maximized">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                    <RotateTransform CenterY="0.5" CenterX="0.5" Angle="315"/>
                    <TranslateTransform/>
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF4314C6" Offset="0"/>
            <GradientStop Color="#FF1B7BE8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>

    </Grid>
</Window>
