    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Providers\HttpClientHelpeProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Image\moropo-logo-light.svg" />
    <None Remove="Assets\Image\viderhe-identity-high-contrast-light.svg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Image\moropo-logo-light.svg" />
    <EmbeddedResource Include="Assets\Image\viderhe-identity-high-contrast-light.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MagicGradients" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageReference Include="NodaTime" Version="3.1.9" />
    <PackageReference Include="SkiaSharp.Views.Forms" Version="2.88.6" />
    <PackageReference Include="SSCXFToolKit.IoC" Version="0.2.0-alpha" />
    <PackageReference Include="SSCXFToolKit.Mvvm" Version="0.4.10-alpha" />
    <PackageReference Include="SSCXFToolKit.Presentation" Version="0.6.4" />
    <PackageReference Include="SSCXFToolKit.Presentation.Transform" Version="0.3.0-alpha" />
    <PackageReference Include="Xamarin.CommunityToolkit" Version="2.0.6" />
    <PackageReference Include="Xamarin.FFImageLoading.Forms" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.Essentials" Version="1.7.7" />
    <PackageReference Include="Xamarin.FFImageLoading.Svg.Forms" Version="2.4.11.982" />
    <PackageReference Include="Xamarin.Forms" Version="5.0.0.2578" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Cloud.Api.Connect\Cloud.Api.Connect.csproj" />
    <ProjectReference Include="..\..\Cloud.SignalR.Connect.Player\Cloud.SignalR.Connect.Player.csproj" />
    <ProjectReference Include="..\..\Extend.Common.Overlaying.Presentation\Extend.Common.Overlaying.Presentation.csproj" />
    <ProjectReference Include="..\..\Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation\Extend.ECASA.CMG.IAInternationalAirport.Templating.Presentation.csproj" />
    <ProjectReference Include="..\..\Extend.ECASA.CMG.IAInternationalAirport\Extend.ECASA.CMG.IAInternationalAirport.csproj" />
    <ProjectReference Include="..\..\Extend.Essential.Overlaying.Presentation\Extend.Essential.Overlaying.Presentation.csproj" />
    <ProjectReference Include="..\..\Extend.Essential\Extend.Essential.csproj" />
    <ProjectReference Include="..\..\Support.Presentation.Player\Support.Presentation.Player.csproj" />
    <ProjectReference Include="..\..\Support.Presentation\Support.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Pages\StartingPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ConfigurationStepPlayerRegistrationDetailView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ConfigurationStepScreenplayFetchingDetailView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Views\ConfigurationStepStartingDetailView.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>
