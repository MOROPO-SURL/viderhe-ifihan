<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
    xmlns:renderedviews="clr-namespace:MOROPO.VIDERHE.Terminal.Player.Views.Rendered"
    xmlns:commontemplatingpresentationconverters="clr-namespace:MOROPO.VIDERHE.Extend.Common.Templating.Presentation.Converters;assembly=MOROPO.VIDERHE.Extend.Common.Templating.Presentation"
    xmlns:supportpresentationviews="clr-namespace:MOROPO.VIDERHE.Support.Presentation.Views;assembly=MOROPO.VIDERHE.Support.Presentation"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="MOROPO.VIDERHE.Terminal.Player.Pages.MainPage"
    BackgroundColor="#00162c"
    ios:Page.PrefersStatusBarHidden="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <commontemplatingpresentationconverters:SizeToRelativeValueConverter x:Key="SizeToRelativeValueConverter" />
            <commontemplatingpresentationconverters:ThicknessToRelativeValueConverter x:Key="ThicknessToRelativeValueConverter" />

            <Thickness x:Key="CurrentTaskProgressBarMargin">0,30</Thickness>
            <Thickness x:Key="PageLayoutMargin">80</Thickness>

            <OnPlatform x:Key="IdentityMainMargin" x:TypeArguments="Thickness" Default="0">
                <On Platform="Android" Value="0,8,0,0" />
            </OnPlatform>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid>
            <supportpresentationviews:IdentityBackgroundView />           
            <Grid 
                Margin="{Binding Source={StaticResource PageLayoutMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                ColumnSpacing="{Binding Source=48, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ffimageloadingsvg:SvgCachedImage
                    x:Name="IdentityMainSvgCachedImage"
                    Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                    Margin="{StaticResource IdentityMainMargin}"
                    VerticalOptions="Start"
                    WidthRequest="{Binding Source=240, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                    Aspect="AspectFit"
                    LoadingDelay="600"
                    Source="resource://MOROPO.VIDERHE.Terminal.Player.Assets.Image.viderhe-identity-high-contrast-light.svg" />
                <Label
                    x:Name="StepTitleLabel"
                    Grid.Column="1" Grid.Row="0"
                    Opacity="0"
                    Text="{Binding Path=Title}"
                    TextColor="White"
                    FontFamily="Montserrat (Bold)"
                    FontSize="{Binding Source=60, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <renderedviews:IndeterminableProgressBarView
                    x:Name="CurrentTaskProgressBar"
                    Grid.Column="1" Grid.Row="1"
                    Opacity="0"
                    Margin="{Binding Source={StaticResource CurrentTaskProgressBarMargin}, Converter={StaticResource ThicknessToRelativeValueConverter}, Mode=OneTime}"
                    ProgressColor="White"
                    HeightRequest="{Binding Source=20, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                <ContentView 
                    x:Name="StepDetailContentView"
                    Content="{Binding Path=DetailContentView}"
                    Grid.Column="1" Grid.Row="2" />
                <StackLayout 
                    Grid.Column="1" Grid.Row="3"
                    HorizontalOptions="End" VerticalOptions="End"
                    WidthRequest="{Binding Source=240, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"
                    Spacing="12">
                    <Label 
                        x:Name="ForBrandingLabel"
                        Opacity="0"
                        Text="por"
                        TextColor="White"
                        FontFamily="Montserrat (Italic)"
                        FontSize="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}" />
                    <ffimageloadingsvg:SvgCachedImage
                        Aspect="AspectFit"
                        LoadingDelay="1200"
                        Source="resource://MOROPO.VIDERHE.Terminal.Player.Assets.Image.moropo-logo-light.svg"
                        Finish="BrandingSvgCachedImage_Finish" />
                    <Label 
                        x:Name="CopyRightLabel"
                        Opacity="0"
                        HorizontalTextAlignment="Center"
                        TextColor="White"
                        FontFamily="Montserrat (Regular)"
                        FontSize="{Binding Source=18, Converter={StaticResource SizeToRelativeValueConverter}, Mode=OneTime}"/>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
