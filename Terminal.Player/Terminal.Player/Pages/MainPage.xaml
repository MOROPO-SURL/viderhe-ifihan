<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.Videre.Terminal.Player.Views.Rendered"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Videre.Terminal.Player.Pages.MainPage"
    BackgroundColor="Accent">
    <ContentPage.Content>
        <Grid Margin="45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label
                x:Name="StepTitleLabel"
                Grid.Column="0" Grid.Row="0"
                Opacity="0"
                Text="{Binding Path=Title}"
                TextColor="White"
                FontSize="56" />
            <renderedviews:IndeterminableProgressBarView
                x:Name="CurrentTaskProgressBar"
                Grid.ColumnSpan="2" Grid.Row="1"
                Opacity="0"
                Margin="0,30"
                ProgressColor="White"
                HeightRequest="20" />
            <ContentView 
                x:Name="StepDetailContentView"
                Content="{Binding Path=DetailContentView}"
                Grid.ColumnSpan="2" Grid.Row="2" />
            <StackLayout 
                x:Name="ProductIdentityContainer"
                Grid.ColumnSpan="2" Grid.Row="3"
                Orientation="Horizontal"
                Spacing="0"
                Opacity="0">
                <Image 
                    VerticalOptions="Center"
                    Margin="0,0,16,0">
                    <Image.Source>
                        <OnPlatform x:TypeArguments="ImageSource">
                            <On Platform="Android" Value="icon" />
                            <On Platform="UWP" Value="Assets/StoreLogo.png" />
                        </OnPlatform>
                    </Image.Source>
                </Image>
                <Label 
                    Text="Smart"
                    TextColor="White"
                    VerticalTextAlignment="Center"
                    FontFamily="{StaticResource EuphoriaScriptRegularFontFamily}"
                    FontAttributes="Bold"
                    FontSize="48" />
                <Label 
                    HorizontalOptions="FillAndExpand"
                    Margin="0,6,0,0"
                    Text="PANTALLAS"
                    TextColor="WhiteSmoke"
                    VerticalTextAlignment="Center"
                    FontFamily="{StaticResource ExpletusSansMediumFontFamily}"
                    FontSize="36" />
                <Image 
                    VerticalOptions="Center">
                    <Image.Source>
                        <OnPlatform x:TypeArguments="ImageSource">
                            <On Platform="Android" Value="powerby_signature" />
                            <On Platform="UWP" Value="Assets/PowerbySignature.png" />
                        </OnPlatform>
                    </Image.Source>
                </Image>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
