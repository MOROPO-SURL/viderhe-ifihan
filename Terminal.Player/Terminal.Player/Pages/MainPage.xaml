<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:renderedviews="clr-namespace:SmartSolucionesCuba.Viderhe.Terminal.Player.Views.Rendered"
    xmlns:supportpresentationhelpers="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Helpers;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation"
    xmlns:supportpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Support.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Support.Presentation"
    mc:Ignorable="d"
    x:Class="SmartSolucionesCuba.Viderhe.Terminal.Player.Pages.MainPage">
    <ContentPage.Content>
        <Grid>
            <supportpresentationviews:IdentityBackgroundView />
            <Grid Margin="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="StepTitleLabel"
                    Grid.Column="0" Grid.Row="0"
                    Opacity="0"
                    Text="{Binding Path=Title}"
                    TextColor="White"
                    FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.LargeTitleTextFontSize}" />
                <renderedviews:IndeterminableProgressBarView
                    x:Name="CurrentTaskProgressBar"
                    Grid.ColumnSpan="2" Grid.Row="1"
                    Opacity="0"
                    Margin="0,30"
                    ProgressColor="White"
                    HeightRequest="20" />
                <ContentView 
                    x:Name="StepDetailContentView"
                    Content="{Binding Path=DetailContentView}"
                    Grid.ColumnSpan="2" Grid.Row="2" />
                <StackLayout 
                    x:Name="ProductIdentityContainer"
                    Grid.ColumnSpan="2" Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="0"
                    Opacity="0">
                    <Label 
                        VerticalOptions="Center"
                        Margin="0,0,16,0"
                        Text="&#xe9ff;"
                        TextColor="White"
                        FontFamily="Viderhe Identity Icons"
                        FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.NormalHeroTextFontSize}" />
                    <Label 
                        Margin="0,6,0,0"
                        Text="Viderhe"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand" VerticalTextAlignment="Center"
                        FontFamily="Julius Sans One Regular"
                        FontSize="{Static supportpresentationhelpers:StaticResourceProvisioningHelper.NormalTitleTextFontSize}" />
                    <Image 
                        VerticalOptions="End">
                        <Image.Source>
                            <OnPlatform x:TypeArguments="ImageSource">
                                <On Platform="Android" Value="powerby_signature" />
                                <On Platform="UWP" Value="Assets/PowerbySignature.png" />
                            </OnPlatform>
                        </Image.Source>
                    </Image>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
