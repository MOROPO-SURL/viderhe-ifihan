<?xml version="1.0" encoding="UTF-8"?>
<extendcommonoverlayingpresentationviews:BaseOverlayView 
    xmlns="http://xamarin.com/schemas/2014/forms" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    xmlns:extendcommonoverlayingpresentationviews="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation.Views;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommonoverlayingpresentationbehaviors="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation.Behaviors;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation"
    xmlns:extendcommonoverlayingpresentationconverters="clr-namespace:SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation.Converters;assembly=SmartSolucionesCuba.Viderhe.Extend.Common.Overlaying.Presentation"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitpresentationtransformbehaviors="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Transform.Behaviors;assembly=SmartSolucionesCuba.XFToolKit.Presentation.Transform"
    xmlns:sscxftoolkitpresentationtransformanimations="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Transform.Animations;assembly=SmartSolucionesCuba.XFToolKit.Presentation.Transform"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Overlaying.Presentation.Views.WindowsAppLauncherOverlayView">
    <ContentView.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    <ContentView.Content>
        <Grid>
            <Grid 
                x:Name="CallToActionMessageWrapGrid"
                HorizontalOptions="End" VerticalOptions="End">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <BoxView 
                    Grid.ColumnSpan="2" Grid.RowSpan="2"
                    x:Name="CallToActionMessageBackgroundBoxView" />
                <StackLayout
                    x:Name="CallToActionMessageWrapStackLayout"
                    Grid.Column="1" Grid.Row="1">
                    <Label
                        HorizontalOptions="Center"
                        Text="&#xf740;"
                        TextColor="White"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="{Binding Path=CallToActionMessageFontSize, Converter={StaticResource FactorConverter}, ConverterParameter=2, Mode=OneTime}" />
                    <Label
                        x:Name="CallToActionMessageLabel"
                        Text="{Binding Path=CallToActionMessage, Mode=OneTime}"
                        TextColor="White"
                        FontSize="{Binding Path=CallToActionMessageFontSize, Mode=OneTime}"
                        HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </StackLayout>
            </Grid>
            <BoxView
                Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>
    </ContentView.Content>
</extendcommonoverlayingpresentationviews:BaseOverlayView>