<?xml version="1.0" encoding="utf-8" ?>
<sscxftoolkitmvvmpages:ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sscxftoolkitpresentationconverters="clr-namespace:SmartSolucionesCuba.XFToolKit.Presentation.Converters;assembly=SmartSolucionesCuba.XFToolKit.Presentation"
    xmlns:sscxftoolkitmvvmpages="clr-namespace:SmartSolucionesCuba.XFToolKit.Mvvm.Pages;assembly=SmartSolucionesCuba.XFToolKit.Mvvm"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:ffimageloadingsvg="clr-namespace:FFImageLoading.Svg.Forms;assembly=FFImageLoading.Svg.Forms"
    x:Class="SmartSolucionesCuba.Viderhe.Extend.OHCC.RailwayMuseum.Overlaying.Presentation.Pages.InformationMenuPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="Black">
    <ContentPage.Resources>
        <ResourceDictionary>
            <sscxftoolkitpresentationconverters:FractionConverter x:Key="FractionConverter" />
            <sscxftoolkitpresentationconverters:FactorConverter x:Key="FactorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="338" />
                <ColumnDefinition />
                <ColumnDefinition Width="926" />
            </Grid.ColumnDefinitions>
            <Grid 
                Grid.Column="0"
                ColumnSpacing="0" RowSpacing="0"
                BackgroundColor="#cccccc">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <ffimageloadingsvg:SvgCachedImage 
                        x:Name="LogoImage"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        HeightRequest="{Binding Source={RelativeSource AncestorType={Type Grid}}, Path=Height, Converter={StaticResource FactorConverter}, ConverterParameter=0.45}" />
                    <BoxView
                        x:Name="SectionSeparatorBoxView"
                        VerticalOptions="End"
                        Margin="20"
                        HeightRequest="2" />
                </Grid>
                <Grid
                    x:Name="RailwayMuseumSectionGrid"
                    Grid.Row="1"
                    Padding="{Binding Source={RelativeSource Mode=Self}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=20}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="RailwayMuseumSectionTapGestureRecognizer_Tapped" />
                    </Grid.GestureRecognizers>
                    <StackLayout 
                        VerticalOptions="Center"
                        Spacing="16">
                        <Label
                            x:Name="RailwayMuseumSectionNameLabel"                            
                            Text="Museo Ferroviario"
                            HorizontalTextAlignment="Center"
                            FontFamily="Louda SC Regular"
                            FontSize="Title" />
                        <ffimageloadingsvg:SvgCachedImage 
                            x:Name="RailwayMuseumSectionVintageImage"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type StackLayout}}, Path=Width, Converter={StaticResource FactorConverter}, ConverterParameter=0.65}" />
                    </StackLayout>
                </Grid>
                <Grid
                    x:Name="OHCCSectionGrid"
                    Grid.Row="2"
                    Padding="{Binding Source={RelativeSource Mode=Self}, Path=Height, Converter={StaticResource FractionConverter}, ConverterParameter=20}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OHCCSectionTapGestureRecognizer_Tapped" />
                    </Grid.GestureRecognizers>
                    <StackLayout 
                        VerticalOptions="Center"
                        Spacing="16">
                        <Label
                            x:Name="OHCCSectionNameLabel"
                            Text="Oficina del Historiador"
                            HorizontalTextAlignment="Center"
                            FontFamily="Louda SC Regular"
                            FontSize="Title" />
                        <ffimageloadingsvg:SvgCachedImage 
                            x:Name="OHCCSectionVintageImage"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            WidthRequest="{Binding Source={RelativeSource AncestorType={Type StackLayout}}, Path=Width, Converter={StaticResource FactorConverter}, ConverterParameter=0.65}" />
                    </StackLayout>
                </Grid>
            </Grid>
            <ffimageloading:CachedImage
                x:Name="SectionBackgroundImage"
                Grid.Column="1"
                Aspect="AspectFill"
                CacheType="None" />
            <Grid 
                Grid.Column="2"
                ColumnSpacing="0" RowSpacing="0"
                BackgroundColor="#cccccc">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ffimageloading:CachedImage
                    x:Name="Section1Image"
                    Grid.Column="1" Grid.Row="0"
                    Aspect="AspectFill"
                    CacheType="None" />
                <Label
                    x:Name="Section1IconLabel"
                    Grid.Column="1" Grid.Row="0"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Text="&#xf740;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="80" />
                <ffimageloadingsvg:SvgCachedImage 
                    x:Name="FirstSectionIndicatorImage"
                    Grid.ColumnSpan="2" Grid.Row="0"
                    HorizontalOptions="Start">
                    <ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SectionItem1TapGestureRecognizer_Tapped" />
                    </ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                </ffimageloadingsvg:SvgCachedImage>
                <Label 
                    Grid.Column="0" Grid.Row="0"
                    Padding="20"
                    Text="Acerca de"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                    FontFamily="Montserrat SemiBold"
                    FontSize="Header" />
                <ffimageloading:CachedImage
                    x:Name="Section2Image"
                    Grid.Column="0" Grid.Row="1"
                    Aspect="AspectFill"
                    CacheType="None" />
                <Label
                    x:Name="Section2IconLabel"
                    Grid.Column="0" Grid.Row="1"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Text="&#xf740;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="80" />
                <ffimageloadingsvg:SvgCachedImage 
                    x:Name="SecoundSectionIndicatorImage"
                    Grid.ColumnSpan="2" Grid.Row="1"
                    HorizontalOptions="End">
                    <ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SectionItem2TapGestureRecognizer_Tapped" />
                    </ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                </ffimageloadingsvg:SvgCachedImage>
                <Label 
                    x:Name="SecoundSectionIndicatorLabel"
                    Grid.Column="1" Grid.Row="1"
                    Padding="20"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                    FontFamily="Montserrat SemiBold"
                    FontSize="Header" />
                <ffimageloading:CachedImage
                    x:Name="Section3Image"
                    Grid.Column="1" Grid.Row="2"
                    Aspect="AspectFill"
                    CacheType="None" />
                <Label
                    x:Name="Section3IconLabel"
                    Grid.Column="1" Grid.Row="2"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Text="&#xf740;"
                    FontFamily="{StaticResource IconFontFamily}"
                    FontSize="80" />
                <ffimageloadingsvg:SvgCachedImage 
                    x:Name="ThirthSectionIndicatorImage"
                    Grid.ColumnSpan="2" Grid.Row="2"
                    HorizontalOptions="Start">
                    <ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="SectionItem3TapGestureRecognizer_Tapped" />
                    </ffimageloadingsvg:SvgCachedImage.GestureRecognizers>
                </ffimageloadingsvg:SvgCachedImage>
                <Label 
                    x:Name="ThirthSectionIndicatorLabel"
                    Grid.Column="0" Grid.Row="2"
                    Padding="20"
                    TextColor="White"
                    HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                    FontFamily="Montserrat SemiBold"
                    FontSize="Header" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</sscxftoolkitmvvmpages:ContentPage>