<Window 
    x:Class="MOROPO.VIDERHE.Terminal.Player.UWPInstaller.Wind0ws.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Asistente de Instalación para VIDERHE Player" MinHeight="480" MinWidth="480" Width="480" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel
            Margin="20"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                Margin="10,10,10,0"
                Text="VIDERHE Player"
                TextWrapping="Wrap"
                FontSize="24"
                FontWeight="Bold"
                TextAlignment="Center" />
            <TextBlock
                Margin="10,0,10,10"
                Text="versión 1.6.0"
                TextWrapping="Wrap"
                FontSize="21"
                TextAlignment="Center" />
            <TextBlock
                Margin="10"
                Text="una aplicación para la proyección de guiones de reproducción en dispositivos vinculados a cuentas de servicio de la plataforma de señalización digital VIDERHE"
                TextWrapping="Wrap"
                FontSize="16"
                TextAlignment="Center" />
            <ProgressBar 
                x:Name="MainProgressBar"
                Margin="10"
                Maximum="100"
                Foreground="#9c4237"
                IsIndeterminate="False" 
                Height="5" />
            <Button
                x:Name="MainActionButton"
                Margin="10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="20,10,20,14"
                FontSize="21"
                Click="MainActionButton_Click">Instalar</Button>
        </StackPanel>
    </Grid>
</Window>
